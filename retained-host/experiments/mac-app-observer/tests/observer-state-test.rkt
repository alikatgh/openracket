#lang racket/base
;; Evaluate the actual parsed state functions with fake GUI observations/clock.
;; No GUI/Cocoa module is loaded and no application is started by this suite.
(require rackunit racket/list racket/match racket/runtime-path)
(define-runtime-path source "../tool.rkt")
(define tree (parameterize ([read-accept-reader #t]) (call-with-input-file source read)))
(define (find-form x predicate)
  (cond [(predicate x) x] [(pair? x) (or (find-form (car x) predicate) (find-form (cdr x) predicate))] [else #f]))
(define (definition name)
  (or (find-form tree (lambda (x) (match x [`(define (,n ,_ ...) ,_ ...) (eq? n name)] [_ #f])))
      (error 'test "Missing actual source definition ~a" name)))
(define (in ns form) (parameterize ([current-namespace ns]) (eval form)))
(define (test-namespace)
  (define ns (make-base-namespace))
  (for ([form
         '((define now 0) (define deadline 60000) (define capture-deadline #f)
           (define phase 'waiting) (define result-code 1)
           (define config (hash 'run_id "case-001" 'output_dir "/ci/output"))
           (define steps '("coldfile" "warmfile" "duplicate")) (define step-index 0)
           (define first-pid 100) (define reports '()) (define completed '())
           (define stable-snapshot #f) (define prior-snapshot #f) (define stable-count 0)
           (define dispatched-at #f) (define dispatch-evidence #f)
           (define last-state #f) (define last-problem "waiting")
           (define sent #f) (define ack #f) (define corrupt-control? #f)
           (define snapshot '((1 2 3 4 "/ci/file"))) (define inspect-fails? #f)
           (define publications '()) (define writes '()) (define diagnostics '())
           (define (current-inexact-monotonic-milliseconds) now)
           (define (step) (list-ref steps step-index))
           (define (step-names c) steps)
           (define (envelope) (hash 'schema 1 'run_id "case-001" 'step (step) 'token "unique-token"))
           (define (control-path config step suffix) (list step suffix))
           (define (write-new-json! path report) (set! writes (cons (list path report) writes)))
           (define (emit marker report) (set! publications (cons (list marker report) publications)))
           (define (bounded s) s)
           (define (finish! code) (set! completed (cons code completed)))
           (define (read-control kind)
             (when corrupt-control? (error 'control "mismatched token"))
             (if (eq? kind 'sent) sent ack))
           (define (inspect-all)
             (when inspect-fails? (error 'mock "bad actual state"))
             (values (hash 'status "passed" 'pid 100) snapshot))
           (define (fail! error) (set! diagnostics (cons error diagnostics))
             (publish! (hash 'status "failed" 'error error) 1)))])
    (in ns form))
  (for ([name '(publish! next-stage! observe-turn! tick)]) (in ns (definition name)))
  ns)
(test-case "absent config keeps phase2 inert"
  (define ns (make-base-namespace))
  (in ns '(define config-path "unused")) (in ns '(define present? #f))
  (in ns '(define starts 0)) (in ns '(define (file-exists? p) present?))
  (in ns '(define (start-observer!) (set! starts (add1 starts))))
  (in ns (definition 'phase2))
  (in ns '(phase2)) (check-equal? (in ns 'starts) 0)
  (in ns '(set! present? #t)) (in ns '(phase2)) (check-equal? (in ns 'starts) 1))
(test-case "three successive complete live snapshots required, output written before ready marker"
  (define ns (test-namespace))
  (in ns '(tick)) (in ns '(tick)) (check-equal? (in ns 'writes) '())
  (in ns '(tick)) (check-equal? (length (in ns 'writes)) 1)
  (check-equal? (in ns 'phase) 'capture)
  (check-equal? (in ns 'capture-deadline) 20000)
  (check-equal? (in ns '(caar publications)) "OPENRACKET_MAC_APP_READY")
  (in ns '(tick)) (check-equal? (length (in ns 'writes)) 1))
(test-case "failure and changing identities reset the three-observation fence"
  (define ns (test-namespace))
  (in ns '(tick)) (in ns '(tick))
  (in ns '(set! inspect-fails? #t)) (in ns '(tick))
  (check-equal? (in ns 'stable-count) 0)
  (in ns '(set! inspect-fails? #f)) (in ns '(tick))
  (in ns '(set! snapshot '((9 8 7 6 "/ci/file")))) (in ns '(tick))
  (check-equal? (in ns 'stable-count) 1)
  (check-equal? (in ns 'writes) '()))
(test-case "ACK advances without exiting and warm stage waits for external sent receipt"
  (define ns (test-namespace))
  (in ns '(tick)) (in ns '(tick)) (in ns '(tick))
  (in ns '(set! ack (hash 'capture_ok #t))) (in ns '(tick))
  (check-equal? (in ns 'completed) '())
  (check-equal? (in ns 'step-index) 1)
  (check-equal? (in ns 'phase) 'waiting)
  (in ns '(tick)) (check-equal? (in ns 'stable-count) 0)
  (in ns '(set! sent (hash 'open_exit 0))) (in ns '(tick))
  (check-equal? (in ns 'stable-count) 1))
(test-case "duplicate cannot become ready before two seconds after real-dispatch receipt"
  (define ns (test-namespace))
  (in ns '(set! step-index 2)) (in ns '(set! sent (hash 'open_exit 0)))
  (for ([n '(0 100 200 1999)]) (in ns `(set! now ,n)) (in ns '(tick)))
  (check-equal? (in ns 'writes) '())
  (in ns '(set! now 2000)) (in ns '(tick))
  (check-equal? (length (in ns 'writes)) 1))
(test-case "wrong sent token fails closed with failure ready"
  (define ns (test-namespace))
  (in ns '(set! step-index 1)) (in ns '(set! corrupt-control? #t)) (in ns '(tick))
  (check-equal? (in ns 'phase) 'capture)
  (check-equal? (in ns 'result-code) 1)
  (check-equal? (in ns '(caar publications)) "OPENRACKET_MAC_APP_FAILURE_READY"))
(test-case "observation timeout emits diagnostic and waits for failure screenshot ACK"
  (define ns (test-namespace))
  (in ns '(set! now 60000)) (in ns '(tick))
  (check-equal? (in ns 'completed) '())
  (check-equal? (in ns 'phase) 'capture)
  (in ns '(set! ack (hash 'capture_ok #t))) (in ns '(tick))
  (check-equal? (in ns 'completed) '(1)))
(test-case "missing capture ACK never passes"
  (for ([code '(0 1)] [expected '(2 1)])
    (define ns (test-namespace))
    (in ns '(set! phase 'capture)) (in ns `(set! result-code ,code))
    (in ns '(set! capture-deadline 20000)) (in ns '(set! now 20000)) (in ns '(tick))
    (check-equal? (in ns 'completed) (list expected))))
(test-case "only final success ACK writes completion and performs test cleanup exit"
  (define ns (test-namespace))
  (in ns '(set! step-index 2)) (in ns '(set! phase 'capture))
  (in ns '(set! result-code 0)) (in ns '(set! ack (hash 'capture_ok #t)))
  (in ns '(tick))
  (check-equal? (in ns 'completed) '(0))
  (check-true (in ns '(hash-ref (cadar writes) 'all_screenshots_acknowledged)))
  (check-false (in ns '(hash-ref (cadar writes) 'complete_app_acceptance))))
(test-case "actual observer cannot mutate/open/start/replace retained host"
  (define forbidden '(change-to-file open-file load-file insert erase delete set-filename set-modified
                       preferences:set preferences:set-default preferences:set-un/marshall
                       preferences:add-callback custodian-limit-memory set-custodian-limit
                       application-file-handler application-open-file-handler set-handler
                       native-appearance-set! native-appearance-restore!
                       set-modern-host-theme! set-modern-chrome-blended!))
  (define (walk x)
    (when (pair? x)
      (when (and (eq? (car x) 'send) (pair? (cdr x)) (pair? (cddr x)))
        (check-false (memq (caddr x) forbidden)))
      (check-false (and (symbol? (car x)) (memq (car x) forbidden)))
      (check-false (equal? x '(quote drracket/drracket)))
      (walk (car x)) (walk (cdr x))))
  (walk tree))

(test-case "both complete three-stage sequences require three separate screenshot acknowledgments"
  (for ([mode '("coldempty" "coldfile")])
    (define ns (test-namespace))
    (in ns `(set! steps (list ,mode "warmfile" "duplicate")))
    (for ([index '(0 1 2)])
      (check-equal? (in ns 'step-index) index)
      (in ns '(set! ack #f))
      (when (> index 0) (in ns '(set! sent (hash 'open_exit 0))))
      (in ns '(tick))
      (when (= index 2) (in ns '(set! now (+ now 2000))))
      (in ns '(tick)) (in ns '(tick))
      (check-equal? (in ns 'phase) 'capture)
      (check-equal? (in ns 'completed) '())
      (in ns '(tick))
      (check-equal? (in ns 'completed) '())
      (in ns '(set! ack (hash 'capture_ok #t))) (in ns '(tick))
      (in ns '(set! sent #f)))
    (check-equal? (in ns 'completed) '(0))
    (check-equal? (length (in ns 'writes)) 4)
    (check-equal? (map (lambda (x) (hash-ref x 'step)) (in ns 'reports))
                  (list mode "warmfile" "duplicate"))))
