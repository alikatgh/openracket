#lang racket/base
;; Read-only AppKit/Foundation calls, loaded only by the already-running tool.
;; No application construction, bundle loading, activation, delegation or setters.
;; API provenance and native compile gate are documented in API-EVIDENCE.md.
(require ffi/unsafe ffi/unsafe/objc ffi/unsafe/nsalloc)
(provide make-cocoa-identity-reader)
(define (make-cocoa-identity-reader gui-thread?)
  (unless (eq? (system-type 'os) 'macosx)
    (error 'cocoa-identity "Requires native macOS"))
  (define appkit (ffi-lib "/System/Library/Frameworks/AppKit.framework/AppKit"))
  (define libc (ffi-lib #f))
  (define getpid (get-ffi-obj "getpid" libc (_fun -> _int)))
  (define executable-path (get-ffi-obj "_NSGetExecutablePath" libc (_fun _bytes _pointer -> _int)))
  (define (image-path)
    (define size (malloc _uint32))
    (ptr-set! size _uint32 4096)
    (define buffer (make-bytes 4096 0))
    (define result (executable-path buffer size))
    (when (= result -1)
      (define needed (ptr-ref size _uint32))
      (unless (<= 1 needed 1048576) (error 'cocoa-identity "Invalid dyld path buffer length"))
      (set! buffer (make-bytes needed 0))
      (set! result (executable-path buffer size)))
    (unless (zero? result) (error 'cocoa-identity "dyld executable path query failed"))
    (define end (for/first ([b (in-bytes buffer)] [i (in-naturals)] #:when (zero? b)) i))
    (unless end (error 'cocoa-identity "dyld executable path is not NUL terminated"))
    (bytes->string/utf-8 (subbytes buffer 0 end) #f))
  (import-class NSRunningApplication NSBundle NSThread)
  (define (ready!)
    (unless (and (gui-thread?) (tell #:type _BOOL NSThread isMainThread))
      (error 'cocoa-identity "Requires the existing main GUI handler thread")))
  (define (need obj selectors)
    (unless obj (error 'cocoa-identity "Native identity object is nil"))
    (for ([selector (in-list selectors)])
      (unless (tell #:type _BOOL obj respondsToSelector: #:type _SEL (sel_registerName selector))
        (error 'cocoa-identity "Missing read-only selector ~a" selector))))
  (define (string-of obj) (and obj (tell #:type _string/utf-8 obj UTF8String)))
  (define (path-of url) (and url (string-of (tell url path))))
  (ready!)
  (need NSRunningApplication '("currentApplication"))
  (need NSBundle '("mainBundle"))
  ;; Captured in this one still-running process, not reconstructed from config.
  (define original (tell NSRunningApplication currentApplication))
  ;; One native reference retained for the bounded process lifetime so the
  ;; comparison object survives autorelease pools. Process exit reclaims it.
  (tellv original retain)
  (need original '("processIdentifier" "bundleIdentifier" "bundleURL" "executableURL" "isEqual:"))
  (lambda ()
    (ready!)
    (with-autorelease
      (define running (tell NSRunningApplication currentApplication))
      (define bundle (tell NSBundle mainBundle))
      (need bundle '("bundleIdentifier" "bundlePath" "executablePath"))
      (hash 'process_image_path (image-path)
            'pid (getpid)
            'running_pid (tell #:type _int running processIdentifier)
            'same_running_application (tell #:type _BOOL running isEqual: original)
            'running_bundle_identifier (string-of (tell running bundleIdentifier))
            'running_bundle_path (path-of (tell running bundleURL))
            'running_executable_path (path-of (tell running executableURL))
            'main_bundle_identifier (string-of (tell bundle bundleIdentifier))
            'main_bundle_path (string-of (tell bundle bundlePath))
            ;; May name CFBundleExecutable/bootstrap: report separately from
            ;; actual NSRunningApplication executableURL, never substitute it.
            'main_bundle_executable_path (string-of (tell bundle executablePath))
            'observation "libc getpid + NSRunningApplication + NSBundle, current GUI process"))))
