#lang racket/base
;; Test-only final capture seam. No renderer override or fabricated pixels.
(require racket/class racket/gui/base racket/runtime-path file/sha1 json rackunit
         "native-light-caret-contract.rkt")
(provide prepare-caret-capture! observe-caret-state!)
(define (handler!)
  (unless (eq? (current-thread) (eventspace-handler-thread (current-eventspace)))
    (error 'native-light-caret "Actual GUI handler required")))
(define (arm!)
  (define arm (getenv "OPENRACKET_CARET_ARM"))
  (unless (member arm '("original" "patched"))
    (error 'native-light-caret "Explicit original/patched arm required"))
  arm)
(define (expected)
  (hash-ref expected-caret-states (string->symbol (arm!))))
(define (rgb c) (list (send c red) (send c green) (send c blue)))
(define (source-hash path)
  (call-with-input-file path (lambda (in) (bytes->hex-string (sha256-bytes in)))))
(define (prepare-caret-capture! frame original-definitions)
  (handler!)
  (parameterize ([current-check-handler raise])
    (define defs (send frame get-definitions-text))
    (check-eq? defs original-definitions "Keep the genuine retained editor")
    (check-equal? (send defs get-text) (hash-ref (expected) 'source_text)
                  "Unchanged accepted Macro Stepper source after ordinary Run recovery")
    ;; Only this test's existing editor selection changes. No preference, style,
    ;; line-number toggle, rendering method or product behavior is changed.
    (define position (send defs paragraph-start-position 2))
    (check-equal? position (hash-ref (expected) 'selection_start))
    (send defs set-position position position)))
(define (observe-caret-state! frame original-definitions)
  (handler!)
  (define arm (arm!))
  (define defs (send frame get-definitions-text))
  (define canvas (send frame get-definitions-canvas))
  (define pref-get (dynamic-require 'framework 'preferences:get))
  (define scheme-name (dynamic-require 'framework 'color-prefs:get-current-color-scheme-name))
  (define lookup (dynamic-require 'framework 'color-prefs:lookup-in-color-scheme))
  (define get-defs% (dynamic-require 'drracket/tool-lib 'drracket:get/extend:get-definitions-text))
  (define get-canvas% (dynamic-require 'drracket/tool-lib 'drracket:get/extend:get-definitions-canvas))
  (define line-numbers<%> (dynamic-require 'framework 'text:line-numbers<%>))
  (define first (box 0))
  (define last (box 0))
  (send defs get-visible-line-range first last #f)
  (define left (box 0))
  (define top (box 0))
  (define width (box 0))
  (define height (box 0))
  (send (send defs get-admin) get-view left top width height)
  (define start (send defs get-start-position))
  (define end (send defs get-end-position))
  (define line (send defs position-line start))
  (define fg (rgb (lookup 'framework:line-numbers-current-line-number-foreground)))
  (define bg (rgb (lookup 'framework:line-numbers-current-line-number-background)))
  (define highlight (get-highlight-text-color))
  (define observed
    (hash 'arm arm
          'appearance_state (symbol->string (pref-get 'openracket:appearance-state))
          'mode_preference (pref-get 'framework:white-on-black-mode?)
          'light_scheme (symbol->string (scheme-name #:wob? #f))
          'palette_foreground (rgb (lookup 'framework:default-text-color))
          'palette_background (rgb (lookup 'framework:basic-canvas-background))
          'gutter_foreground fg 'gutter_background bg
          'highlight_text_color (and highlight (rgb highlight))
          'registered_definitions (is-a? defs (get-defs%))
          'registered_canvas (is-a? canvas (get-canvas%))
          'same_original_definitions (eq? defs original-definitions)
          'same_canvas_editor (eq? defs (send canvas get-editor))
          'frame_shown (send frame is-shown?) 'canvas_shown (send canvas is-shown?)
          'canvas_focus (send canvas has-focus?)
          'line_numbers_interface (is-a? defs line-numbers<%>)
          'showing_line_numbers (send defs showing-line-numbers?)
          'selection_start start 'selection_end end 'selection_collapsed (= start end)
          'current_paragraph (send defs position-paragraph start)
          'rendered_line_paragraph (send defs line-paragraph line)
          'source_text (send defs get-text)
          'visible_first_line (unbox first) 'visible_last_line (unbox last)
          'rendered_line line 'line_top (send defs line-location line)
          'line_bottom (send defs line-location line #f)
          'view_left (unbox left) 'view_top (unbox top)
          'view_width (unbox width) 'view_height (unbox height)
          'contrast_ratio (contrast-ratio fg bg)
          'info_sha256 (source-hash (collection-file-path "info.rkt" "openracket-appearance"))
          'renderer_sha256 (source-hash (collection-file-path "text-line-numbers.rkt" "framework" "private"))
          'cocoa_sha256 (source-hash (collection-file-path "procs.rkt" "mred" "private" "wx" "cocoa"))))
  ;; Record actual state before any typed failure. Existing host reports the
  ;; original exception and captures failure diagnostics without hiding it.
  (emit-caret-state!
   (lambda ()
     (printf "OPENRACKET_NATIVE_CARET_STATE ~a\n" (jsexpr->string observed))
     (flush-output)))
  (validate-caret-state! observed arm))
