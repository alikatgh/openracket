#lang racket/base
;; Pure shared evidence validator. Headless validation is not native evidence.
(require rackunit racket/list racket/runtime-path json)
(provide expected-caret-states validate-caret-state! contrast-ratio emit-caret-state!)
(define (emit-caret-state! writer)
  ;; A success-state emission has no existing failure to protect. Propagate
  ;; asynchronous breaks unchanged; ordinary output failures are best effort.
  (with-handlers ([exn:break? raise]
                  [(lambda (_) #t) (lambda (_) (void))])
    (writer)
    (void)))
(define-runtime-path expected-path "native-light-caret-expected.json")
(define expected-caret-states (call-with-input-file expected-path read-json))
(define viewport-keys
  '(visible_first_line visible_last_line rendered_line line_top line_bottom
    view_left view_top view_width view_height contrast_ratio))
(define (canonical value)
  (cond [(hash? value) (for/hasheq ([(key item) (in-hash value)])
                        (values key (canonical item)))]
        [(list? value) (map canonical value)]
        [else value]))
(define (linear n)
  (define s (/ n 255.0))
  (if (<= s 0.04045) (/ s 12.92) (expt (/ (+ s 0.055) 1.055) 2.4)))
(define (luminance rgb)
  (for/sum ([n (in-list rgb)] [weight '(0.2126 0.7152 0.0722)])
    (* weight (linear n))))
(define (contrast-ratio fg bg)
  (define a (luminance fg))
  (define b (luminance bg))
  (/ (+ (max a b) 0.05) (+ (min a b) 0.05)))
(define (validate-caret-state! observed arm)
  (parameterize ([current-check-handler raise])
    (check-not-false (member arm '("original" "patched")) "Explicit palette arm")
    (define expected (hash-ref expected-caret-states (string->symbol arm)))
    (check-true (hash? observed))
    (check-equal? (sort (hash-keys observed) symbol<?)
                  (sort (append (hash-keys expected) viewport-keys) symbol<?)
                  "Exact complete state keys")
    (for ([key (in-list (sort (hash-keys expected) symbol<?))])
      (check-equal? (canonical (hash-ref observed key))
                    (canonical (hash-ref expected key)) (format "Actual caret state: ~a" key)))
    (for ([key '(visible_first_line visible_last_line rendered_line)])
      (check-true (exact-nonnegative-integer? (hash-ref observed key))))
    (for ([key '(line_top line_bottom view_left view_top view_width view_height contrast_ratio)])
      (define v (hash-ref observed key))
      (check-true (and (real? v) (< -inf.0 v +inf.0))))
    (define first (hash-ref observed 'visible_first_line))
    (define last (hash-ref observed 'visible_last_line))
    (define line (hash-ref observed 'rendered_line))
    (define top (hash-ref observed 'line_top))
    (define bottom (hash-ref observed 'line_bottom))
    (define view-top (hash-ref observed 'view_top))
    (define height (hash-ref observed 'view_height))
    (check-true (<= first line last) "Current numbered line is in this canvas viewport")
    (check-true (< top bottom) "Nonempty line geometry")
    (check-true (and (> height 0) (> (hash-ref observed 'view_width) 0)))
    (check-true (<= view-top top bottom (+ view-top height)) "Entire line is vertically visible")
    (define ratio (contrast-ratio (hash-ref observed 'gutter_foreground)
                                  (hash-ref observed 'gutter_background)))
    (check-= (hash-ref observed 'contrast_ratio) ratio 1e-12)
    ;; Original is an exact observed baseline, not a pass against 4.5.
    (when (equal? arm "patched")
      (check-true (>= ratio 4.5) "Unrounded intended-color contrast meets 4.5")))
  observed)
