#lang racket/base
(require rackunit racket/class racket/draw "../src/paint.rkt")
(define (canvas [w 240] [h 50])
  (define bm (make-bitmap w h))
  (values bm (new bitmap-dc% [bitmap bm])))
(define (pixels bm)
  (define out (make-bytes (* 4 (send bm get-width) (send bm get-height))))
  (send bm get-argb-pixels 0 0 (send bm get-width) (send bm get-height) out)
  out)
(define (paint label #:theme [theme 'dark] #:disabled? [disabled? #f]
               #:hover? [hover? #f] #:down? [down? #f] #:label? [show? #t]
               #:cw [cw 240])
  (define-values (bm dc) (canvas))
  (parameterize ([current-modern-theme theme])
    (paint-modern-button dc cw 50 label (make-preview-icon 36) (make-preview-icon 22)
                         show? disabled? hover? down? 54))
  (send dc set-bitmap #f)
  (pixels bm))
(for* ([theme '(light dark)] [label '("Check Syntax" "Debug" "Macro Stepper" "Run" "Stop")])
  (test-case (format "draw ~a ~a" theme label)
    (check-not-exn (lambda () (paint label #:theme theme)))))
(test-case "light and dark are distinct" (check-not-equal? (paint "Run") (paint "Run" #:theme 'light)))
(test-case "hover is distinct" (check-not-equal? (paint "Run") (paint "Run" #:hover? #t)))
(test-case "pressed is distinct from hover" (check-not-equal? (paint "Run" #:hover? #t) (paint "Run" #:hover? #t #:down? #t)))
(test-case "disabled ignores hover" (check-equal? (paint "Run" #:disabled? #t) (paint "Run" #:disabled? #t #:hover? #t)))
(test-case "disabled differs from enabled" (check-not-equal? (paint "Run") (paint "Run" #:disabled? #t)))
(test-case "compact mode" (check-not-exn (lambda () (paint "Macro Stepper" #:label? #f #:cw 54))))
(test-case "narrow visible-label mode collapses to icon" (check-not-exn (lambda () (paint "Run" #:cw 54))))
(test-case "unknown label keeps supplied bitmap" (check-not-exn (lambda () (paint "External tool"))))
(test-case "no label" (check-not-exn (lambda () (paint #f #:label? #f))))
(test-case "bitmap label" (check-not-exn (lambda () (paint (make-preview-icon 20) #:label? #f))))
(test-case "zero-sized target does not throw" (check-not-exn (lambda () (paint "Run" #:cw 0))))
(test-case "DC state restored"
  (define-values (bm dc) (canvas))
  (send dc set-alpha .7) (send dc set-smoothing 'unsmoothed)
  (send dc set-pen "red" 3 'solid) (send dc set-brush "blue" 'solid)
  (send dc set-text-foreground "green")
  (define before (list (send dc get-alpha) (send dc get-smoothing) (send dc get-pen)
                       (send dc get-brush) (send dc get-font) (send dc get-text-foreground)))
  (paint-modern-button dc 240 50 "Run" (make-preview-icon 20) (make-preview-icon 20) #t #f #t #f 38)
  (check-equal? (list (send dc get-alpha) (send dc get-smoothing) (send dc get-pen)
                       (send dc get-brush) (send dc get-font) (send dc get-text-foreground)) before))
(test-case "DC state restored on exception"
  (define-values (bm dc) (canvas))
  (define alpha (send dc get-alpha))
  (check-exn exn:fail? (lambda () (call-with-dc-state dc (lambda () (send dc set-alpha .2) (error "fixture")))))
  (check-equal? (send dc get-alpha) alpha))
(test-case "localized role mapping"
  (parameterize ([modern-role-labels (hash "Exécuter" 'run)])
    (check-not-exn (lambda () (paint "Exécuter")))))
