#lang racket/base
;; Executes parsed observer control logic with fake windows, clock and capture.
;; This does not compile, load, or execute any GUI library.
(require racket/class racket/file racket/list racket/match racket/runtime-path rackunit)
(define-runtime-path source "portable-observer/tool.rkt")
(define tree (parameterize ([read-accept-reader #t]) (call-with-input-file source read)))
(define (find-form x pred)
  (cond [(pred x) x] [(pair? x) (or (find-form (car x) pred) (find-form (cdr x) pred))] [else #f]))
(define (definition name)
  (find-form tree (lambda (x) (match x [`(define (,n ,_ ...) ,_ ...) (eq? n name)] [_ #f]))))
(define-namespace-anchor here)
(define (namespace)
  (define ns (make-base-namespace))
  (namespace-attach-module (namespace-anchor->namespace here) 'racket/class ns)
  (parameterize ([current-namespace ns]) (namespace-require 'racket/class))
  ns)
(define (in ns x) (parameterize ([current-namespace ns]) (eval x)))
(test-case "registered observer is inert without fixture opt-in"
  (define ns (namespace))
  (in ns '(define value #f)) (in ns '(define starts 0))
  (in ns '(define (getenv name) value))
  (in ns '(define (start-observer!) (set! starts (add1 starts))))
  (in ns (definition 'phase2))
  (in ns '(phase2)) (check-equal? (in ns 'starts) 0)
  (in ns '(set! value "/ci/fixture.rkt"))
  (in ns '(phase2)) (check-equal? (in ns 'starts) 1))
(test-case "native observations serialize without losing false or null"
  (define ns (namespace)) (in ns (definition 'json-safe))
  (check-equal? (in ns '(json-safe (hash 'native (hash 'backend 'cocoa 'explicit #f)
                                      'mode 'platform 'missing 'null 'path (string->path "/ci/example"))))
                (hash 'native (hash 'backend "cocoa" 'explicit #f)
                      'mode "platform" 'missing 'null 'path "/ci/example")))
(define (ticker)
  (define ns (namespace))
  (for ([x (in-list
            '((define phase 'waiting) (define now 0) (define deadline 60000)
              (define capture-deadline 20000) (define done-path "/ci/done")
              (define captured? #f) (define result-code 0) (define finished '())
              (define stable-count 0) (define stable-frame #f) (define last-problem "waiting")
              (define last-state #f) (define reports '()) (define inspect-error? #f)
              (define frame% (class object% (super-new)
                               (define/public (get-definitions-text) #f)
                               (define/public (is-shown?) #t)))
              (define frame (new frame%)) (define windows (list frame))
              (define (get-top-level-windows) windows)
              (define (current-inexact-monotonic-milliseconds) now)
              (define (file-exists? p) captured?)
              (define (inspect-frame f) (if inspect-error? (error 'mock "bad actual state") (hash 'status "passed")))
              (define (emit . args) (void))
              (define (finish! code) (set! finished (cons code finished)))
              (define (publish! report code)
                (set! reports (cons (cons code report) reports))
                (set! result-code code) (set! phase 'capture))
              (define (fail! message) (publish! (hash 'error message) 1))))]) (in ns x))
  (in ns (definition 'tick))
  ns)
(test-case "readiness requires three complete successful observer turns"
  (define ns (ticker))
  (in ns '(tick)) (in ns '(tick)) (check-equal? (in ns 'reports) '())
  (in ns '(tick)) (check-equal? (length (in ns 'reports)) 1)
  (check-eq? (in ns 'phase) 'capture)
  (in ns '(tick)) (check-equal? (length (in ns 'reports)) 1))
(test-case "missing windows and bad live state break the consecutive readiness fence"
  (define ns (ticker))
  (in ns '(tick)) (in ns '(tick))
  (in ns '(set! windows '())) (in ns '(tick)) (check-equal? (in ns 'stable-count) 0)
  (in ns '(set! windows (list frame))) (in ns '(tick))
  (in ns '(set! inspect-error? #t)) (in ns '(tick))
  (check-equal? (in ns 'stable-count) 0)
  (check-regexp-match #rx"bad actual state" (in ns 'last-problem))
  (in ns '(set! now 60000)) (in ns '(tick))
  (check-equal? (caar (in ns 'reports)) 1)
  (check-eq? (in ns 'phase) 'capture))
(test-case "capture acknowledgment and timeout preserve strict process outcome"
  (for ([ready? '(#t #f)] [expected '(0 2)])
    (define ns (ticker))
    (in ns '(set! phase 'capture)) (in ns `(set! captured? ,ready?))
    (in ns '(set! now 20000)) (in ns '(tick))
    (check-equal? (in ns 'finished) (list expected)))
  (define ns (ticker))
  (in ns '(set! phase 'capture)) (in ns '(set! result-code 1))
  (in ns '(set! now 20000)) (in ns '(tick))
  (check-equal? (in ns 'finished) '(1)))
(test-case "observer never replaces entrypoint or mutates content/settings/appearance"
  (define forbidden '(change-to-file insert erase delete set-filename set-modified
                       preferences:set preferences:set-default preferences:set-un/marshall
                       preferences:add-callback custodian-limit-memory set-custodian-limit
                       native-appearance-set! native-appearance-restore!
                       set-modern-host-theme! set-modern-chrome-blended!))
  (define (walk x)
    (when (pair? x)
      (when (and (eq? (car x) 'send) (pair? (cdr x)) (pair? (cddr x)))
        (check-false (memq (caddr x) forbidden)))
      (check-false (and (symbol? (car x)) (memq (car x) forbidden)))
      (check-false (equal? x '(quote drracket/drracket)))
      (walk (car x)) (walk (cdr x))))
  (walk tree))
(test-case "memory observation belongs to genuine launcher frame inspection"
  (define inspection (definition 'inspect-frame))
  (check-not-false inspection)
  (define (contains? form)
    (find-form inspection (lambda (x) (equal? x form))))
  (check-not-false
   (contains? '(assert! (is-a? frame (drracket:get/extend:get-unit-frame))
                        "Registered stock frame class")))
  (check-not-false
   (contains? '(define memory-limit (memory-limit-evidence expected-memory-limit))))
  (check-not-false (contains? '(assert-memory-limit! memory-limit assert!)))
  (check-not-false (contains? '(set! last-state (hash 'memory_limit memory-limit))))
  (define success-report
    (find-form inspection
               (lambda (x) (match x [`(hash 'status "passed" ,_ ...) #t] [_ #f]))))
  (check-not-false success-report)
  (check-not-false (member '('memory_limit memory-limit)
                           (for/list ([i (in-range 1 (length success-report) 2)])
                             (take (drop success-report i) 2)))))
