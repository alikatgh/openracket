#lang racket/base
;; Portable raw-byte-verified installer. Every mutation stays in this proof profile.
(require racket/file racket/path racket/runtime-path racket/cmdline
         file/sha1 json pkg/lib)
(define-runtime-path root "..")
(define profile (simplify-path (build-path root "profile") #f))
(define revert? #f)
(command-line #:once-each [("--revert") "Restore the pristine stock source" (set! revert? #t)])
(define manifest (call-with-input-file (build-path root "reports/patch-manifest.json") read-json))
(define (digest data) (bytes->hex-string (sha256-bytes data)))
(define (verified-source relative key)
  (define data (file->bytes (build-path root relative)))
  (unless (equal? (digest data) (hash-ref manifest key))
    (error 'openracket "Source integrity check failed: ~a; no changes made" relative))
  data)
;; Verify all inputs before touching any target, including the rollback input.
(define stock (verified-source "vendor/switchable-button-v9.3.rkt" 'upstream_sha256))
(define patched (verified-source "overlay/mrlib/switchable-button.rkt" 'patched_sha256))
(define painter (verified-source "src/paint.rkt" 'painter_sha256))
(define gui-dir (or (pkg-directory "openracket-gui-lib") (pkg-directory "gui-lib")))
(unless gui-dir
  (error 'openracket "Complete official gui-lib is required; no runtime is reconstructed from cache"))
(define target (build-path gui-dir "mrlib/switchable-button.rkt"))
(define helper (build-path gui-dir "mrlib/private/openracket-paint.rkt"))
(define (check-isolated! path)
  (when (link-exists? profile) (error 'openracket "The isolated profile may not be a symbolic link"))
  (define rel (find-relative-path profile (simplify-path path #f)))
  (define elems (explode-path rel))
  (when (or (complete-path? rel) (memq 'up elems))
    (error 'openracket "Refusing to modify a package outside the isolated profile: ~a" path))
  (for/fold ([at profile]) ([part (in-list elems)])
    (define next (build-path at part))
    (when (link-exists? next)
      (error 'openracket "Refusing symbolic-link target in profile: ~a" next))
    next)
  (void))
(check-isolated! target) (check-isolated! helper)
(unless (file-exists? target) (error 'openracket "Missing installed stock source: ~a" target))
(unless (member (digest (file->bytes target))
                (list (hash-ref manifest 'upstream_sha256) (hash-ref manifest 'patched_sha256)))
  (error 'openracket "Installed toolbar source has unrelated changes; refusing to overwrite"))
(define (write-atomic path data)
  (call-with-atomic-output-file path (lambda (out temporary) (write-bytes data out))))
(if revert?
    (begin (write-atomic target stock) (displayln "Restored exact stock toolbar source."))
    (begin
      ;; A failed second write leaves only an unused helper beside stock source.
      (write-atomic helper painter)
      (write-atomic target patched)
      (displayln "Applied verified paint-only patch inside the isolated profile.")))
