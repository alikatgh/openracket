#lang racket/base
(require racket/class racket/draw racket/list "../src/paint.rkt")
(define out (if (zero? (vector-length (current-command-line-arguments)))
                "artifacts/toolbar-paint-proof.png"
                (vector-ref (current-command-line-arguments) 0)))
(define W 1400) (define H 620)
(define bm (make-bitmap W H))
(define dc (new bitmap-dc% [bitmap bm]))
(send dc set-background (theme-color 'background)) (send dc clear)
(send dc set-smoothing 'smoothed)
(define title-font (make-font #:size 24 #:family 'swiss #:weight 'bold #:size-in-pixels? #t))
(define note-font (make-font #:size 13 #:family 'swiss #:size-in-pixels? #t))
(send dc set-font title-font) (send dc set-text-foreground (theme-color 'text))
(send dc draw-text "OpenRacket / retained-host paint proof" 40 25)
(send dc set-font note-font) (send dc set-text-foreground (parameterize ([current-modern-theme 'dark]) (theme-color 'muted)))
(send dc draw-text "Actual shared Racket drawing code. Component samples only, not an application screenshot." 40 65)
(define labels '("Check Syntax" "Debug" "Macro Stepper" "Run" "Stop"))
(define widths '(34 34 36 20 20))
(define (row y theme state compact?)
  (parameterize ([current-modern-theme theme])
    (send dc set-font note-font) (send dc set-text-foreground (parameterize ([current-modern-theme 'dark]) (theme-color 'muted)))
    (send dc draw-text (format "~a / ~a~a" theme state (if compact? " / compact" "")) 40 (- y 24))
    (send dc set-pen (theme-color 'background) 0 'transparent)
    (send dc set-brush (theme-color 'background) 'solid)
    (send dc draw-rounded-rectangle 40 y 1320 48 9)
    (define gap 6)
    (define button-widths
      (for/list ([label labels] [bw widths])
        (define-values (tw th d a) (send dc get-text-extent label (modern-control-font note-font)))
        (if compact? (+ bw 18) (inexact->exact (ceiling (+ tw bw 28))))))
    ;; Keep order and right alignment from the reference. No replacement actions.
    (define start (- 1348 (+ (apply + button-widths) (* gap 4))))
    (for/fold ([x start]) ([label labels] [bw widths] [cw button-widths] [i (in-naturals)])
      (define old-origin (call-with-values (lambda () (send dc get-origin)) list))
      (send dc set-origin x (+ y 4))
      (paint-modern-button dc cw 40 label (make-preview-icon bw) (make-preview-icon bw)
                           (not compact?)
                           (and (eq? state 'disabled) (< i 4))
                           (and (eq? state 'hover) (= i 3))
                           (and (eq? state 'pressed) (= i 3))
                           (+ bw 18) (modern-control-font note-font))
      (send dc set-origin (car old-origin) (cadr old-origin))
      (+ x cw gap))))
(void (row 128 'light 'idle #f))
(void (row 222 'dark 'idle #f))
(void (row 316 'dark 'hover #f))
(void (row 410 'dark 'disabled #f))
(void (row 504 'light 'idle #t))
(send dc set-font note-font) (send dc set-text-foreground (parameterize ([current-modern-theme 'dark]) (theme-color 'muted)))
(send dc draw-text "Same painter is called from stock switchable-button%. Labels, actions, ordering and compact-mode decisions remain with DrRacket." 40 579)
(send dc set-bitmap #f)
(unless (send bm save-file out 'png) (error 'render-proof "could not save ~a" out))
(displayln out)
