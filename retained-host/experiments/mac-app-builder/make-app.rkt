#lang racket/base
;; Build-time only. Use build-app.sh so startup environment is cleaned before
;; this module or any dependency is loaded. No GUI, installer or preference reset.
(require racket/cmdline racket/file racket/list racket/path racket/port
         racket/runtime-path racket/string racket/system json file/sha1 xml/plist)
(provide manifest-sha256 isolation-overrides runtime-path-query
         checked-absolute canonical-path inside? verify-source
         verify-runtime-boundary verify-runtime-report isolated-environment
         config-shell decorate-bundle build)
(define-runtime-path here ".")
(define manifest-sha256 "2569c1bacdfb70ddc3042908b19d9e898fcebd274418668085bfe51f3a739552")
(define themes '("saved" "light" "dark"))
(define isolation-overrides
  '("PLTCOLLECTS" "PLTCONFIGDIR" "PLTLINKS" "PLT_COMPILED_FILE_CHECK"
    "PLT_ZO_PATH" "PLTDRDEBUG" "PLTDRCM" "PLTDRPAR"))
(define runtime-path-query
  #<<QUERY
(begin
  (require json setup/dirs compiler/find-exe)
  (define (s p) (and p (path->string p)))
  (write-json (hash 'version (version) 'os (symbol->string (system-type))
    'collects (s (find-collects-dir)) 'config (s (find-config-dir))
    'lib (s (find-lib-dir)) 'pkgs (s (find-pkgs-dir))
    'console-bin (s (find-console-bin-dir)) 'gui-bin (s (find-gui-bin-dir))
    'gui-exe (s (find-exe #t #:untethered? #t)))))
QUERY
  )
(define (stop fmt . args) (apply error 'openracket-app fmt args))
(define (exists? p) (or (file-exists? p) (directory-exists? p) (link-exists? p)))
(define (digest-bytes b) (bytes->hex-string (sha256-bytes b)))
(define (digest-file p) (call-with-input-file p (lambda (in) (bytes->hex-string (sha256-bytes in)))))
(define (pstr p) (path->string p))

;; normalize-path fully resolves symlinks; simplify-path alone does not. Peel
;; missing suffix components so containment also works before output/cache exists.
;; Existing components are resolved before lexical '..' is handled.
(define (canonical-path value)
  (define p (path->complete-path value))
  (define canonical
    (cond
      [(exists? p) (normalize-path p)]
      [else
       (define-values (base leaf directory?) (split-path p))
       (unless (path? base) (stop "cannot canonicalize path: ~a" p))
       (simplify-path (build-path (canonical-path base) leaf) #f)]))
  ;; A trailing directory marker is semantically harmless to path APIs but not
  ;; to the shell dispatcher's exact argv prefix. Use one Unix representation,
  ;; matching pwd -P from the proven launcher, while preserving filesystem root.
  (apply build-path (explode-path canonical)))
(define (checked-absolute value #:exists? [must-exist? #t])
  (unless (and (string? value) (not (regexp-match? #rx"[\u0000\n\r]" value)))
    (stop "configuration paths cannot contain NUL or line breaks"))
  (unless (absolute-path? value) (stop "supply an explicit absolute path"))
  (when (and must-exist? (not (or (file-exists? value) (directory-exists? value))))
    (stop "configuration path does not exist: ~a" value))
  (canonical-path value))
(define (inside? path parent)
  (define a (explode-path (canonical-path path)))
  (define b (explode-path (canonical-path parent)))
  (and (>= (length a) (length b)) (equal? (take a (length b)) b)))
(define (verify-source source)
  (when (string-contains? (pstr source) ":")
    (stop "the tested preview source path cannot contain a colon"))
  (define raw (file->bytes (build-path source "CONTENTS-SHA256.json")))
  (unless (equal? (digest-bytes raw) manifest-sha256)
    (stop "preview manifest is not the exact tested 0520 snapshot"))
  (define manifest (read-json (open-input-bytes raw)))
  (unless (and (hash? manifest) (= (hash-count manifest) 155))
    (stop "unexpected source count"))
  (for ([(name expected) (in-hash manifest)])
    (define path (build-path source (symbol->string name)))
    (when (or (link-exists? path) (not (equal? (digest-file path) expected)))
      (stop "tested source mismatch: ~a" name))))
(define (verify-runtime-boundary runtime-root racket source output)
  (unless (directory-exists? runtime-root) (stop "runtime root is not a directory"))
  (for ([location (in-list (list source (build-path source "profile") output here))])
    (when (inside? location runtime-root)
      (stop "source/profile/output/builder must be outside the original runtime tree")))
  (when (or (inside? runtime-root source) (inside? runtime-root output))
    (stop "source/output and original runtime trees must not overlap"))
  (define expected (build-path runtime-root "bin" "racket"))
  (unless (and (file-exists? expected) (file-exists? racket)
               (equal? (canonical-path expected) (canonical-path racket)))
    (stop "selected executable does not match the explicit runtime root's bin/racket"))
  (for ([directory '("bin" "collects" "etc" "lib")])
    (define path (build-path runtime-root directory))
    (unless (and (directory-exists? path) (inside? path runtime-root))
      (stop "unsupported runtime layout; expected self-contained official Mac installation")))
  (for ([relative '("bin/raco" "collects/racket/base.rkt")])
    (define path (build-path runtime-root relative))
    (unless (and (file-exists? path) (inside? path runtime-root))
      (stop "full official Mac runtime layout check failed"))))
(define (verify-runtime-report report runtime-root)
  (unless (and (hash? report) (equal? (hash-ref report 'version #f) "9.3")
               (equal? (hash-ref report 'os #f) "macosx"))
    (stop "runtime query did not identify Racket 9.3 on macOS"))
  (for ([key '(collects config lib pkgs console-bin gui-bin gui-exe)])
    (define value (hash-ref report key #f))
    (unless (and (string? value) (absolute-path? value) (inside? value runtime-root))
      (stop "runtime ~a directory escapes the explicit installation root" key)))
  (for ([pair '((collects . "collects") (config . "etc") (console-bin . "bin"))])
    (unless (equal? (explode-path (canonical-path (hash-ref report (car pair))))
                    (explode-path (canonical-path (build-path runtime-root (cdr pair)))))
      (stop "unsupported runtime ~a layout" (car pair)))))
(define (isolated-environment source racket theme)
  (define env (environment-variables-copy (current-environment-variables)))
  (for ([key (in-list (environment-variables-names env))])
    (when (or (regexp-match? #rx#"^OPENRACKET_" key)
              (member key (map string->bytes/utf-8 isolation-overrides)))
      (environment-variables-set! env key #f)))
  (define profile (build-path source "profile"))
  (define values
    (list (cons "PATH" "/usr/bin:/bin:/usr/sbin:/sbin") (cons "RACKET" (pstr racket))
          (cons "PLTUSERHOME" (pstr profile))
          (cons "PLTADDONDIR" (pstr (build-path profile ".local/share/racket")))
          (cons "PLTCOMPILEDROOTS" (string-append (pstr (build-path profile "compiled-cache")) ":"))
          (cons "XDG_CACHE_HOME" (pstr (build-path profile ".cache")))
          (cons "OPENRACKET_PROFILE" (pstr profile))
          (cons "OPENRACKET_AUTOSAVE_GUARD" "1") (cons "OPENRACKET_NATIVE_APPEARANCE" "1")))
  (for ([pair (in-list (if (equal? theme "saved") values (cons (cons "OPENRACKET_THEME" theme) values)))])
    (environment-variables-set! env (string->bytes/utf-8 (car pair)) (string->bytes/utf-8 (cdr pair))))
  env)
(define (shell-quote s)
  (if (regexp-match? #px"^[A-Za-z0-9_@%+=:,./-]+$" s) s
      (string-append "'" (string-replace s "'" "'\"'\"'") "'")))
(define (config-shell source racket native-name theme)
  (unless (member theme themes) (stop "invalid theme"))
  (define pairs (list (cons "OPENRACKET_SOURCE" (pstr source))
                      (cons "OPENRACKET_OFFICIAL_RACKET" (pstr racket))
                      (cons "OPENRACKET_NATIVE_NAME" native-name)
                      (cons "OPENRACKET_AUTOSAVE_GUARD" "1")
                      (cons "OPENRACKET_NATIVE_APPEARANCE" "1")))
  (define out (open-output-string))
  (displayln "# Generated data, quoted with POSIX shell rules." out)
  (for ([pair (in-list (if (equal? theme "saved") pairs (append pairs (list (cons "OPENRACKET_THEME" theme)))))])
    (fprintf out "~a=~a\nexport ~a\n" (car pair) (shell-quote (cdr pair)) (car pair)))
  (get-output-string out))
(define (write-text path text)
  (call-with-output-file path (lambda (out) (display text out)) #:exists 'truncate/replace))
(define (executable? path)
  (and (file-exists? path) (memq 'execute (file-or-directory-permissions path))))
(define (plist->hash plist)
  (unless (and (list? plist) (pair? plist) (eq? (car plist) 'dict))
    (stop "official Info.plist is not a dictionary"))
  (define result (make-hash))
  (for ([pair (in-list (cdr plist))])
    (unless (and (list? pair) (= (length pair) 3) (eq? (car pair) 'assoc-pair) (string? (cadr pair)))
      (stop "invalid official Info.plist dictionary entry"))
    (hash-set! result (cadr pair) (caddr pair)))
  result)
(define (hash->plist info)
  (cons 'dict (for/list ([key (in-list (sort (hash-keys info) string<?))])
                (list 'assoc-pair key (hash-ref info key)))))
(define (decorate-bundle bundle source racket theme [runtime-root #f])
  (define info-path (build-path bundle "Contents/Info.plist"))
  (define info (plist->hash (call-with-input-file info-path read-plist)))
  (define native-name (hash-ref info "CFBundleExecutable" #f))
  (unless (and (string? native-name) (not (equal? native-name ""))
               (not (string-contains? native-name "/"))
               (not (member native-name '("." ".." "OpenRacket-launch"))))
    (stop "unexpected official launcher executable name"))
  (define native (build-path bundle "Contents/MacOS" native-name))
  (unless (and (executable? native) (not (link-exists? native)))
    (stop "official launcher executable missing or not executable"))
  (define native-before (digest-file native))
  (define resources (build-path bundle "Contents/Resources"))
  (unless (directory-exists? resources) (make-directory resources))
  (for ([filename '("runtime-dispatch.sh" "report-error.applescript")])
    (define destination (build-path resources filename))
    (copy-file (build-path here filename) destination #t)
    (file-or-directory-permissions destination (if (string-suffix? filename ".sh") #o755 #o644)))
  (define entry (build-path bundle "Contents/MacOS/OpenRacket-launch"))
  (copy-file (build-path here "bootstrap.sh") entry #t)
  (file-or-directory-permissions entry #o755)
  (write-text (build-path resources "openracket-config.sh") (config-shell source racket native-name theme))
  (define identifier (string-append "local.openracket.preview.p" (substring (digest-bytes (path->bytes source)) 0 16)))
  (for ([pair (in-list
               (list (cons "CFBundleExecutable" "OpenRacket-launch")
                     (cons "CFBundleName" "OpenRacket Preview") (cons "CFBundleDisplayName" "OpenRacket Preview")
                     (cons "CFBundleIdentifier" identifier) (cons "CFBundlePackageType" "APPL")
                     (cons "CFBundleVersion" "1") (cons "CFBundleShortVersionString" "0.1.0")
                     (cons "LSMinimumSystemVersion" "15.0") (cons "LSMultipleInstancesProhibited" '(true))
                     (cons "CFBundleDocumentTypes"
                           '(array (dict (assoc-pair "CFBundleTypeName" "Racket source and editor document")
                                         (assoc-pair "CFBundleTypeRole" "Editor")
                                         (assoc-pair "CFBundleTypeExtensions" (array "rkt" "rktl" "ss" "scm" "wxme"))
                                         (assoc-pair "LSHandlerRank" "Alternate"))))))])
    (hash-set! info (car pair) (cdr pair)))
  (for ([key '("LSUIElement" "LSBackgroundOnly" "LSEnvironment")]) (hash-remove! info key))
  (call-with-output-file info-path (lambda (out) (write-plist (hash->plist info) out)) #:exists 'truncate/replace)
  (define record
    (hash 'status "native acceptance pending" 'source (pstr source) 'racket (pstr racket)
          'source_manifest_sha256 manifest-sha256 'runtime_root (if runtime-root (pstr runtime-root) 'null)
          'native_executable native-name 'theme theme 'developer_id_signed #f 'notarized #f
          'self_contained #f 'profile (pstr (build-path source "profile"))))
  (call-with-output-file (build-path resources "build-record.json")
    (lambda (out) (write-json record out #:indent 2) (newline out)) #:exists 'truncate/replace)
  (unless (equal? native-before (digest-file native))
    (stop "native executable changed during decoration")))
(define (run! command args #:capture? [capture? #f])
  (define out (and capture? (open-output-string)))
  (define code
    (parameterize ([current-output-port (or out (current-output-port))])
      (apply system*/exit-code command args)))
  (unless (zero? code) (stop "subprocess failed with status ~a: ~a" code command))
  (and out (get-output-string out)))
(define (read-single-json text)
  (define in (open-input-string text))
  (define value (read-json in))
  (unless (regexp-match? #px"^[ \t\r\n]*$" (port->string in))
    (stop "runtime query emitted trailing non-JSON output"))
  value)
(define (copy-directory-metadata! source destination)
  ;; copy-directory/files preserves file modes/times; copy directory metadata
  ;; explicitly, children first. Extended attributes are not copied by this port.
  (for ([name (in-list (directory-list source))])
    (define child (build-path source name))
    (when (directory-exists? child)
      (copy-directory-metadata! child (build-path destination name))))
  (file-or-directory-permissions destination (file-or-directory-permissions source 'bits))
  (file-or-directory-modify-seconds destination (file-or-directory-modify-seconds source)))
(define (build source racket output theme runtime-root)
  (unless (eq? (system-type) 'macosx)
    (stop "native bundle generation must run on macOS; no cross-platform stub is produced"))
  (unless (member theme themes) (stop "invalid theme"))
  (unless (and (equal? (path-get-extension output) #".app") (not (exists? output)))
    (stop "output must be a new .app path; existing paths are never replaced"))
  (when (inside? output source) (stop "output must be outside the tested source folder"))
  (verify-runtime-boundary runtime-root racket source output)
  (verify-source source)
  (define profile (build-path source "profile"))
  (unless (and (directory-exists? profile) (not (link-exists? profile)))
    (stop "a prepared, non-symlink preview profile is required; setup is separate"))
  (unless (executable? racket) (stop "the configured official Racket executable is not executable"))
  (for ([relative '(".local" ".local/share" ".local/share/racket" ".cache" "compiled-cache")])
    (when (link-exists? (build-path profile relative)) (stop "a managed profile path is a symbolic link")))
  (define env (isolated-environment source racket theme))
  (define prefix (list "-U" "-A" (pstr (build-path profile ".local/share/racket"))
                       "-R" (string-append (pstr (build-path profile "compiled-cache")) ":")))
  (parameterize ([current-directory source] [current-environment-variables env])
    (define query (run! racket (append prefix (list "-e" runtime-path-query)) #:capture? #t))
    (verify-runtime-report (read-single-json query) runtime-root)
    (run! "/bin/sh" (list (pstr (build-path source "scripts/launch-openracket.sh")) "--check"))
    (define temporary (make-temporary-file ".openracket-build-~a" 'directory (path-only output)))
    (dynamic-wind void
      (lambda ()
        (define staging (build-path temporary (file-name-from-path output)))
        (run! racket (append prefix (list (pstr (build-path here "make-native-launcher.rkt")) (pstr staging))))
        (decorate-bundle staging source racket theme runtime-root)
        (verify-source source)
        ;; Exclusive destination mkdir; never rename over an existing directory.
        ;; Keep any partial output on failure, but always remove private staging.
        (copy-directory/files staging output #:keep-modify-seconds? #t)
        (copy-directory-metadata! staging output))
      (lambda () (delete-directory/files temporary)))))
(module+ main
  (with-handlers ([exn:fail? (lambda (e) (eprintf "OpenRacket app build stopped: ~a\n" (exn-message e)) (exit 1))])
    (define source-arg #f) (define racket-arg #f) (define root-arg #f) (define output-arg #f) (define theme "saved")
    (command-line #:program "OpenRacket app builder" #:once-each
      [("--source") path "Prepared tested 0520 preview source" (set! source-arg path)]
      [("--runtime-root") path "Full official Racket 9.3 installation root" (set! root-arg path)]
      [("--racket") path "Explicit runtime bin/racket executable" (set! racket-arg path)]
      [("--output") path "New destination .app path" (set! output-arg path)]
      [("--theme") choice "saved (default), light or dark" (set! theme choice)]
      #:args () (void))
    (unless (and source-arg racket-arg root-arg output-arg) (stop "--source, --runtime-root, --racket and --output are required"))
    (define source (checked-absolute source-arg))
    (define racket (checked-absolute racket-arg))
    (define runtime-root (checked-absolute root-arg))
    (checked-absolute output-arg #:exists? #f)
    (when (link-exists? output-arg) (stop "output is a symbolic link"))
    (define raw-output (string->path output-arg))
    (define parent (checked-absolute (pstr (path-only raw-output))))
    (unless (directory-exists? parent) (stop "output parent is not a directory"))
    (define output (build-path parent (file-name-from-path raw-output)))
    (build source racket output theme runtime-root)
    (printf "Created ~a. Mac native acceptance is still required.\n" output)))
