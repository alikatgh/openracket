#lang racket/base
;; Independent headless model: executes the parsed upstream and candidate
;; clever-file-format-mixin bodies, plus the parsed upstream do-autosave method.
;; This is not a native GUI/serialization/recovery test or a speed benchmark.
(require racket/class racket/file racket/list racket/match racket/runtime-path
         rackunit rackunit/text-ui)
(define-runtime-path stock "../vendor/text-misc-v9.3.rkt")
(define-runtime-path candidate "../overlay/framework/private/text-misc.rkt")
(define-runtime-path editor-stock "../vendor/editor-misc-v9.3.rkt")
(define-runtime-path mred-stock "../vendor/editor-mred-v9.3.rkt")
(define-namespace-anchor here)
(define (read-module p)
  (match (parameterize ([read-accept-reader #t]) (call-with-input-file p read))
    [`(module ,_ ,language ,body) `(module normalized ,language ,body)]))
(define racket-format format)
(define (find-form tree pred)
  (cond [(pred tree) tree]
        [(pair? tree) (or (find-form (car tree) pred) (find-form (cdr tree) pred))]
        [else #f]))
(define (definition tree name)
  (find-form tree (lambda (f) (match f [`(define ,n ,_ ...) (eq? n name)] [_ #f]))))
(define stock-tree (read-module stock))
(define candidate-tree (read-module candidate))
(define env-name "OPENRACKET_EXPERIMENTAL_SAVE_SCAN_GUARD")
(define guard '(or (not openracket-experimental-save-scan-guard?) (eq? format 'same)))
(define trace (make-parameter #f))
(define verify? (make-parameter #f))
(define binary-answer (make-parameter 1))
(define text-answer (make-parameter #t))
(define doing-autosave? (make-parameter #f))
(define hook-result (make-parameter #t))
(define hook-action (make-parameter (lambda (_) (void))))
(define first-action (make-parameter void))
(define next-action (make-parameter void))
(define save-fails? (make-parameter #f))
(define (note . values) (when (trace) (set-box! (trace) (cons values (unbox (trace))))))
(define (events) (reverse (unbox (trace))))
(define snip%
  (class object%
    (init-field [following #f])
    (super-new)
    (define/public (next) (note 'scan-next) ((next-action)) following)
    (define/public (link! x) (set! following x))))
(define string-snip% (class snip% (super-new)))
(define (make-snips kinds)
  (define xs (for/list ([kind (in-list kinds)]) (new (if (eq? kind 'string) string-snip% snip%))))
  (for ([s (in-list xs)] [next (in-list (if (null? xs) '() (append (cdr xs) '(#f))))]) (send s link! next))
  xs)
(define text%
  (class object%
    (init-field [contents '()] [file-format 'text])
    (super-new)
    (define/public (find-first-snip)
      (note 'scan-first) ((first-action)) (and (pair? contents) (car contents)))
    (define/public (get-file-format) (note 'get-format file-format) file-format)
    (define/public (peek-format) file-format)
    (define/public (set-file-format f) (note 'set-format f) (set! file-format f))
    (define/public (get-filename) 'original)
    (define/public (is-modified?) #t)
    (define/pubment (can-save-file? name format) (inner #t can-save-file? name format))
    (define/pubment (on-save-file name format) (inner (void) on-save-file name format))
    (define/pubment (after-save-file result) (inner (void) after-save-file result))
    ;; Deliberately small model of the pinned mred save hook order. No file I/O.
    (define/public (save-file [name 'destination] [format 'same] [show-errors? #t])
      (note 'save-file name format show-errors? (doing-autosave?))
      (and (send this can-save-file? name format)
           (begin
             (send this on-save-file name format)
             (when (save-fails?) (error 'model-save "injected write failure"))
             (note 'serialize (if (memq format '(same copy)) file-format format))
             (send this after-save-file #t)
             #t)))))
(define (preferences:get key)
  (unless (eq? key 'framework:verify-change-format) (error 'preference "unexpected ~a" key))
  (note 'preference key (verify?)) (verify?))
(define (message-box/custom #:dialog-mixin mixin . args) (note 'binary-prompt) (binary-answer))
(define (gui-utils:get-choice #:dialog-mixin mixin . args) (note 'text-prompt) (text-answer))
(define autosave-method
  (find-form (read-module editor-stock)
             (lambda (f) (match f [`(define/public (do-autosave) ,_ ...) #t] [_ #f]))))
(define (load-class file env-value)
  (define ns (make-base-namespace))
  (namespace-attach-module (namespace-anchor->namespace here) 'racket/class ns)
  (parameterize ([current-namespace ns])
    (namespace-require 'racket/class)
    (for ([entry (in-list
                 (list (cons 'text% text%) (cons 'string-snip% string-snip%)
                       (cons 'editor:doing-autosave? doing-autosave?)
                       (cons 'doing-autosave? doing-autosave?)
                       (cons 'preferences:get preferences:get)
                       (cons 'message-box/custom message-box/custom)
                       (cons 'gui-utils:get-choice gui-utils:get-choice)
                       (cons 'frame:focus-table-mixin values)
                       (cons 'path-utils:generate-autosave-name (lambda (_) 'autosave-file))
                       (cons 'file-exists? (lambda (_) #f))
                       (cons 'delete-file (lambda (x) (error 'unexpected-delete "~a" x)))
                       (cons 'getenv (lambda (key)
                                       (unless (equal? key env-name) (error 'env "unexpected key"))
                                       env-value))))])
      (namespace-set-variable-value! (car entry) (cdr entry) #t))
    (eval '(define-syntax-rule (string-constant name) 'name))
    (define flag (definition (read-module file) 'openracket-experimental-save-scan-guard?))
    (when flag (eval flag))
    (eval (definition stock-tree 'clever-file-format<%>))
    (eval (definition (read-module file) 'clever-file-format-mixin))
    (define clever% ((eval 'clever-file-format-mixin) text%))
    (namespace-set-variable-value! 'clever% clever% #t)
    (define autosave%
      (eval `(class clever%
               (super-new)
               (inherit is-modified? get-filename save-file find-first-snip)
               (define auto-saved-name #f)
               (define auto-save-out-of-date? #t)
               (define auto-save-error? #f)
               (define/public (autosave?) #t)
               (define/private (show-autosave-error exn orig-name) (void))
               ,autosave-method)))
    (values clever% autosave% (and flag (eval 'openracket-experimental-save-scan-guard?)))))
(define (observe base%)
  (class base%
    (super-new)
    (define/augment (can-save-file? name format)
      (note 'inner-can name format (send this peek-format)) ((hook-action) 'can) (hook-result))
    (define/augment (on-save-file name format)
      (note 'inner-on name format (send this peek-format)) ((hook-action) 'on))
    (define/augment (after-save-file result) (note 'inner-after result) ((hook-action) 'after))))
(define-values (stock% stock-auto% stock-flag) (load-class stock #f))
(define-values (off% off-auto% off-flag) (load-class candidate #f))
(define-values (on% on-auto% on-flag) (load-class candidate "1"))
(define models (map observe (list stock% off% on%)))
(define auto-models (map observe (list stock-auto% off-auto% on-auto%)))
(define contents-cases '(() (string) (string string string) (rich) (string rich string) (string string rich)))
(define formats '(guess standard text text-force-cr same copy))
(define (run base% kinds orig format verify binary plain auto accept [autosave-run? #f])
  (parameterize ([trace (box '())] [verify? verify] [binary-answer binary]
                 [text-answer plain] [doing-autosave? auto] [hook-result accept])
    (define t (new base% [contents (make-snips kinds)] [file-format orig]))
    (define result (if autosave-run? (send t do-autosave) (send t save-file 'destination format #f)))
    (list result (send t peek-format) (events))))
(define (strip-scans result)
  (list (car result) (cadr result)
        (filter (lambda (e) (not (memq (car e) '(scan-first scan-next)))) (caddr result))))
(define (count-event result tag) (count (lambda (e) (eq? (car e) tag)) (caddr result)))
(define matrix-count 0)
(define autosave-count 0)
(define cases
  (test-suite
   "Independent parsed-stock/candidate save-scan guard"
   (test-case "entire parsed module differs only by the flag export, flag definition, and two guards"
     (define removed 0)
     (define (restore f)
       (cond
         [(equal? f '(provide text-misc@ openracket-experimental-save-scan-guard?)) '(provide text-misc@)]
         [(pair? f)
          (if (or (equal? (car f) (definition candidate-tree 'openracket-experimental-save-scan-guard?))
                  (equal? (car f) guard))
              (begin (when (equal? (car f) guard) (set! removed (add1 removed))) (restore (cdr f)))
              (cons (restore (car f)) (restore (cdr f))))]
         [else f]))
     (check-equal? (restore candidate-tree) stock-tree)
     (check-equal? removed 2)
     (check-not-false autosave-method)
     (check-not-false (member '(save-file auto-name 'copy #f)
                             (let flatten ([x autosave-method])
                               (if (pair? x) (cons x (append (flatten (car x)) (flatten (cdr x)))) '())))))
   (test-case "model format list matches pinned public save-file checker exactly"
     (define checker
       (find-form (read-module mred-stock)
                  (lambda (f) (match f [`(define (check-format who format) ,_ ...) #t] [_ #f]))))
     (check-not-false checker)
     (check-not-false
      (find-form checker (lambda (f) (equal? f `(memq format ',formats))))))
   (test-case "activation requires exact 1; unset and plausible truthy spellings stay off"
     (check-false off-flag) (check-true on-flag)
     (for ([value '("0" "" "true" "yes" " 1" "1 ")])
       (define-values (_a _b enabled?) (load-class candidate value))
       (check-false enabled?)))
   (test-case "full ordinary matrix preserves default trace and enabled non-scan behavior"
     (for* ([kinds (in-list contents-cases)] [format (in-list formats)]
            [orig '(text standard)] [verify '(#f #t)] [binary '(1 2 3)]
            [plain '(#f #t)] [auto '(#f #t)] [accept '(#f #t)])
       (set! matrix-count (add1 matrix-count))
       (define results (for/list ([base% (in-list models)])
                         (run base% kinds orig format verify binary plain auto accept)))
       (define context (racket-format "kinds=~s format=~s original=~s verify=~s binary=~s plain=~s autosave=~s inner=~s"
                               kinds format orig verify binary plain auto accept))
       (check-equal? (cadr results) (car results) context)
       (check-equal? (strip-scans (caddr results)) (strip-scans (car results)) context)
       (when (eq? format 'same) (check-equal? (caddr results) (car results) context))
       (unless (eq? format 'same) (check-equal? (count-event (caddr results) 'scan-first) 0 context))))
   (test-case "stock required autosave selection still scans and restores original format"
     (for* ([kinds (in-list contents-cases)] [orig '(text standard)] [verify '(#f #t)] [accept '(#f #t)])
       (set! autosave-count (add1 autosave-count))
       (define results (for/list ([base% (in-list auto-models)])
                         (run base% kinds orig 'copy verify 1 #t #f accept #t)))
       (check-equal? (cadr results) (car results))
       (check-equal? (strip-scans (caddr results)) (strip-scans (car results)))
       (check-equal? (cadr (caddr results)) orig)
       (check-equal? (count-event (caddr results) 'scan-first) 1 "Required stock selection scan survives")
       (check-equal? (count-event (car results) 'scan-first) (if accept 3 2))
       (when accept
         (check-not-false (member (list 'serialize (if (memq 'rich kinds) 'standard 'text))
                                  (caddr (caddr results)))))
       (check-equal? (count-event (caddr results) 'binary-prompt) 0)
       (check-equal? (count-event (caddr results) 'text-prompt) 0)))
   (test-case "actual parsed autosave restores original format on injected write failure"
     (for* ([base% (in-list auto-models)] [kinds (in-list contents-cases)] [orig '(text standard)])
       (parameterize ([trace (box '())] [verify? #f] [save-fails? #t])
         (define t (new base% [contents (make-snips kinds)] [file-format orig]))
         (check-false (send t do-autosave))
         (check-equal? (send t peek-format) orig))))
   (test-case "inner-hook exceptions preserve the failure and later-hook suppression"
     (for* ([format '(copy same)] [failure-stage '(can on after)])
       (define results
         (for/list ([base% (in-list models)])
           (parameterize ([trace (box '())]
                          [hook-action (lambda (kind) (when (eq? kind failure-stage)
                                                        (error 'inner-hook "injected ~a" kind)))])
             (define t (new base% [contents (make-snips '(string))]))
             (define message
               (with-handlers ([exn:fail? exn-message])
                 (send t save-file 'destination format #f)
                 'unexpected-success))
             (list message (send t peek-format) (events)))))
       (check-equal? (cadr results) (car results))
       (check-equal? (strip-scans (caddr results)) (strip-scans (car results)))
       (check-true (regexp-match? #rx"injected" (car (car results))))))
   (test-case "explicit callback-count canary demonstrates enabled non-same differences"
     (define results (for/list ([base% (in-list models)])
                       (run base% '(string string string) 'text 'copy #f 1 #t #f #t)))
     (check-equal? (map (lambda (r) (count-event r 'scan-first)) results) '(2 2 0))
     (check-equal? (map (lambda (r) (count-event r 'scan-next)) results) '(6 6 0))
     (printf "CANARY copy/3 string snips: stock/off/on first calls = (2 2 0); next calls = (6 6 0)\n"))
   (test-case "side-effect exception canary is an intentional semantic limitation, not hidden equivalence"
     (for ([base% (in-list models)] [raises? '(#t #t #f)])
       (parameterize ([trace (box '())] [first-action (lambda () (error 'plugin-first "observed"))])
         (define t (new base% [contents (make-snips '(string))]))
         (if raises? (check-exn #rx"observed" (lambda () (send t save-file 'destination 'copy #f)))
             (check-true (send t save-file 'destination 'copy #f)))))
     (for ([base% (in-list models)] [raises? '(#t #t #f)])
       (parameterize ([trace (box '())] [next-action (lambda () (error 'plugin-next "observed"))])
         (define t (new base% [contents (make-snips '(string))]))
         (if raises? (check-exn #rx"observed" (lambda () (send t save-file 'destination 'text #f)))
             (check-true (send t save-file 'destination 'text #f)))))
     (for ([base% (in-list models)])
       (parameterize ([trace (box '())] [first-action (lambda () (error 'plugin-first "observed"))])
         (define t (new base% [contents (make-snips '(string))]))
         (check-exn #rx"observed" (lambda () (send t save-file 'destination 'same #f))))))
   (test-case "independent prompt-policy expectations hold with matching preferences"
     (for ([base% (in-list models)])
       (define convert (run base% '(string rich) 'text 'same #t 1 #t #f #t))
       (check-true (car convert)) (check-eq? (cadr convert) 'standard)
       (check-equal? (count-event convert 'binary-prompt) 1)
       (check-not-false (member '(inner-can destination same standard) (caddr convert)))
       (define keep (run base% '(rich) 'text 'same #t 2 #t #f #t))
       (check-true (car keep)) (check-eq? (cadr keep) 'text)
       (define decline (run base% '(rich) 'text 'same #t 3 #t #f #t))
       (check-false (car decline)) (check-equal? (count-event decline 'inner-can) 0)
       (define auto-decline (run base% '(rich) 'text 'same #t 1 #t #t #t))
       (check-false (car auto-decline))
       (check-equal? (count-event auto-decline 'binary-prompt) 0)
       (define no-confirm (run base% '(rich) 'text 'same #f 3 #f #f #t))
       (check-true (car no-confirm)) (check-eq? (cadr no-confirm) 'standard)
       (check-equal? (count-event no-confirm 'binary-prompt) 0)
       (define plain-convert (run base% '(string) 'standard 'same #t 1 #t #f #t))
       (check-true (car plain-convert)) (check-eq? (cadr plain-convert) 'text)
       (check-equal? (count-event plain-convert 'text-prompt) 1)
       (define plain-keep (run base% '() 'standard 'same #t 1 #f #f #t))
       (check-true (car plain-keep)) (check-eq? (cadr plain-keep) 'standard)
       (check-equal? (count-event plain-keep 'text-prompt) 1)))
   (test-case "inner can-save rejection still prevents on-save, serialization, after-save"
     (for ([base% (in-list models)])
       (define result (run base% '(string rich) 'text 'copy #f 1 #t #f #f))
       (check-false (car result))
       (check-equal? (count-event result 'inner-can) 1)
       (for ([tag '(inner-on serialize inner-after)]) (check-equal? (count-event result tag) 0))))))
(module+ main
  (define failures (run-tests cases))
  (printf "Ordinary scenarios: ~a; actual stock do-autosave scenarios: ~a\n" matrix-count autosave-count)
  (exit (if (zero? failures) 0 1)))
(module+ test
  (define failures (run-tests cases))
  (unless (zero? failures) (error 'independent-model "~a failures" failures)))
