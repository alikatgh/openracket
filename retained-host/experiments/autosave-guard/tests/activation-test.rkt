#lang racket/base
(require rackunit "../performance/autosave-activation.rkt")
(define (env v) (lambda (_) v))
(define (lookup v) (lambda (_module _export absent) (if (eq? v 'absent) (absent) v)))
(check-equal? (hash-ref (verify-autosave-activation "stock" #:environment (env #f)
                                                  #:lookup (lookup 'absent)) 'status) "verified")
(check-true (hash-ref (verify-autosave-activation "candidate" #:environment (env "1")
                                                #:lookup (lookup #t)) 'selected))
(for ([case '(("stock" #f #f) ("stock" "1" absent) ("candidate" #f #t)
              ("candidate" "1" #f) ("candidate" "1" absent))])
  (check-exn exn:fail? (lambda () (verify-autosave-activation (car case)
                                 #:environment (env (cadr case)) #:lookup (lookup (caddr case))))))
(check-exn exn:fail? (lambda () (verify-autosave-activation "stock" #:environment (env #f)
                                #:lookup (lambda _ (error 'module "broken dependency")))))
