#lang racket/base
(require rackunit racket/class racket/set racket/list "binding-export.rkt"
         (submod "binding-export.rkt" test-support))
(parameterize ([current-check-handler raise])
  (define editor% (class object% (super-new)
                    (define table (make-hash))
                    (define/public (syncheck:get-bindings-table) table)
                    (define/public (populate!)
                      (hash-set! table (list this 0 1) (set (list this 2 3) (list this 4 4))))))
  (define editor (new editor%))
  (send editor populate!)
  (define stock (measure-binding-export editor "stock" 10))
  (check-equal? (hash-ref stock 'before_state) 'null)
  (check-equal? (hash-ref (hash-ref stock 'export) 'key_count) 1)
  (check-equal? (hash-ref (hash-ref stock 'export) 'edge_count) 2)
  (check-true (hash-ref stock 'same_public_hash_identity))
  (check-exn exn:fail? (lambda () (measure-binding-export editor "candidate" 10)))
  (check-exn exn:fail? (lambda () (measure-binding-export editor "stock" 2)))
  (check-exn exn:fail? (lambda () (measure-binding-export editor "stock" #f)))
  (define table (send editor syncheck:get-bindings-table))
  (define wrong (make-hash))
  (hash-set! wrong (list (new object%) 0 1) (set (list editor 2 3)))
  (check-exn exn:fail? (lambda () (export-summary wrong editor 10)))
  (hash-set! wrong (list editor 0 1) (mutable-set (list editor 2 3)))
  (hash-remove! wrong (car (filter (lambda (k) (not (eq? (car k) editor))) (hash-keys wrong))))
  (check-exn exn:fail? (lambda () (export-summary wrong editor 10)))
  (check-exn exn:fail? (lambda () (export-summary (hash-copy-clear table) editor 10)))
  (define other-order (make-hash))
  (hash-set! other-order (list editor 0 1) (set (list editor 4 4) (list editor 2 3)))
  (check-equal? (export-summary table editor 10) (export-summary other-order editor 10))
  (for ([bad-table (in-list (list (make-weak-hash) (make-ephemeron-hash)))])
    (hash-set! bad-table (list editor 0 1) (set (list editor 2 3)))
    (check-exn exn:fail? (lambda () (export-summary bad-table editor 10))))
  (check-exn exn:fail? (lambda () (export-summary (hash (list editor 0 1) (set (list editor 2 3))) editor 10)))
  (for ([bad-set (in-list (list (set) (mutable-set (list editor 2 3)) (weak-set (list editor 2 3))))])
    (define bad-table (make-hash))
    (hash-set! bad-table (list editor 0 1) bad-set)
    (check-exn exn:fail? (lambda () (export-summary bad-table editor 10))))
  (for ([bad-endpoint (in-list (list (list (new object%) 2 3) (list editor 3 2)
                                        (list editor -1 0) (list editor 2 11) (list editor 2.0 3)))])
    (define bad-table (make-hash))
    (hash-set! bad-table (list editor 0 1) (set bad-endpoint))
    (check-exn exn:fail? (lambda () (export-summary bad-table editor 10))))
  (define with-empty (hash-copy table))
  (hash-set! with-empty (list editor 5 6) (set))
  (check-exn exn:fail? (lambda () (export-summary with-empty editor 10)))
  (check-true (quad<? '(0 1 2 3) '(0 1 2 4)))
  (check-false (quad<? '(0 1 2 3) '(0 1 2 3)))
  (define (valid-state active)
    (hash 'enabled #t 'active active 'in_flight #f 'generation 1
          'accepted 2 'duplicates 0 'eager_writes 2 'stock_calls 0
          'pending 0 'materializations 0 'public_keys 1
          'indexed_edges (if active 2 0) 'cached_starts (if active 1 0)
          'exposed (not active) 'unsupported_fallbacks 0 'failure_fallbacks 0
          'fallback_reason (if active #f 'public-exposure)))
  (define candidate%
    (class editor% (super-new)
      (init-field [state-change (lambda (s) s)] [after-change (lambda (s) s)])
      (define active #t)
      (define/public (openracket:get-binding-table-eager-state)
        ((if active state-change after-change) (valid-state active)))
      (define/override (syncheck:get-bindings-table)
        (set! active #f)
        (super syncheck:get-bindings-table))))
  (define candidate (new candidate%))
  (send candidate populate!)
  (define c (measure-binding-export candidate "candidate" 10))
  (check-true (hash-ref (hash-ref c 'before_state) 'active))
  (check-equal? (hash-ref (hash-ref c 'before_state) 'pending) 0)
  (check-equal? (hash-ref (hash-ref c 'before_state) 'eager_writes) 2)
  (check-equal? (hash-ref (hash-ref c 'after_first_state) 'fallback_reason) "public-exposure")
  (check-equal? (hash-ref c 'after_first_state) (hash-ref c 'after_second_state))
  (check-exn exn:fail? (lambda () (measure-binding-export candidate "stock" 10)))
  ;; A second separate measurement cannot reuse an already exposed candidate.
  (define partial #f)
  (check-exn exn:fail? (lambda () (measure-binding-export candidate "candidate" 10
                                  #:on-progress (lambda (value) (set! partial value)))))
  (check-equal? (hash-ref partial 'status) "failed")
  (check-false (hash-ref partial 'verified))
  (check-false (hash-has-key? partial 'first_start))
  (define state-reads 0)
  (define second-changing
    (new candidate% [after-change
                     (lambda (s)
                       (set! state-reads (add1 state-reads))
                       (if (= state-reads 1) s (hash-set s 'duplicates 1)))]))
  (send second-changing populate!)
  (check-exn #rx"Repeated getter changed"
             (lambda () (measure-binding-export second-changing "candidate" 10)))
  ;; Every declared state field is mandatory; all types are exact and no extras.
  (for ([key (in-list (hash-keys (valid-state #t)))])
    (for ([change (in-list (list (lambda (s) (hash-remove s key))
                                (lambda (s) (hash-set s key 'invalid))))])
      (define bad (new candidate% [state-change change]))
      (send bad populate!)
      (check-exn exn:fail? (lambda () (measure-binding-export bad "candidate" 10)))))
  (for ([changes (in-list
                 (list (hash 'pending 1) (hash 'materializations 1) (hash 'stock_calls 1)
                       (hash 'failure_fallbacks 1) (hash 'unsupported_fallbacks 1)
                       (hash 'public_keys 2 'cached_starts 2)
                       (hash 'eager_writes 1) (hash 'indexed_edges 1)
                       (hash 'in_flight #t) (hash 'exposed #t) (hash 'active #f)
                       (hash 'generation 0) (hash 'accepted 0) (hash 'duplicates #f)
                       (hash 'public_keys 1.0) (hash 'extra 0)))])
    (define bad (new candidate% [state-change
                                (lambda (s) (for/fold ([s s]) ([(k v) (in-hash changes)])
                                              (hash-set s k v)))]))
    (send bad populate!)
    (check-exn exn:fail? (lambda () (measure-binding-export bad "candidate" 10))))
  (for ([changes (in-list
                 (list (hash 'active #t) (hash 'exposed #f) (hash 'in_flight #t)
                       (hash 'eager_writes 1) (hash 'public_keys 2) (hash 'accepted 1)
                       (hash 'generation 2) (hash 'duplicates 1)
                       (hash 'pending 1) (hash 'materializations 1) (hash 'stock_calls 1)
                       (hash 'indexed_edges 2) (hash 'cached_starts 1)
                       (hash 'failure_fallbacks 1) (hash 'unsupported_fallbacks 1)
                       (hash 'fallback_reason 'unsupported-input)))])
    (define bad (new candidate% [after-change
                                (lambda (s) (for/fold ([s s]) ([(k v) (in-hash changes)])
                                              (hash-set s k v)))]))
    (send bad populate!)
    (check-exn exn:fail? (lambda () (measure-binding-export bad "candidate" 10)))))
(displayln "OPENRACKET_BINDING_EAGER_EXPORT_TESTS_PASSED")
