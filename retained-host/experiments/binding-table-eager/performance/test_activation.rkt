#lang racket/base
(require rackunit racket/file racket/path
         "gui-observer.rkt" (submod "activation.rkt" test-support))
(current-check-handler raise)
(define root (make-temporary-file "activation-test~a" 'directory))
(define counter 0)
(define (module-fixture body)
  (set! counter (add1 counter))
  (define gui (build-path root (format "gui~a.rkt" counter)))
  (call-with-output-file gui
    (lambda (out) (display (string-append "#lang racket/base\n" body) out)))
  (values gui (digest (file->bytes gui))))
(define (in-clean-environment thunk)
  (define environment (environment-variables-copy (current-environment-variables)))
  (environment-variables-set! environment #"OPENRACKET_BINDING_TABLE_EAGER" #f)
  (environment-variables-set! environment #"OPENRACKET_GUI_PHASE_POINTS" #f)
  (parameterize ([current-environment-variables environment]) (thunk)))
(define (check-case body arm flag expected-status expected-enabled verified?)
  (define-values (gui sha) (module-fixture body))
  (in-clean-environment
   (lambda ()
     (when flag (putenv "OPENRACKET_BINDING_TABLE_EAGER" flag))
     (dynamic-require gui #f) ; ordinary application loading, outside probe
     (define record (existing-module-evidence gui arm sha))
     (check-equal? (hash-ref record 'verified) verified?)
     (check-equal? (hash-ref record 'export_status) expected-status)
     (check-equal? (hash-ref record 'binding_eager_enabled) expected-enabled)
     (check-equal? (hash-ref record 'source_sha256) sha)
     (check-true (hash-ref record 'same_gui_module_instance))
     (check-false (hash-ref (existing-module-evidence gui arm (make-string 64 #\0)) 'verified))
     (putenv "OPENRACKET_GUI_PHASE_POINTS" "1")
     (check-false (hash-ref (existing-module-evidence gui arm sha) 'verified)))))
(define export-header "(provide openracket-binding-table-eager-enabled?)\n")
(define (boolean-body value)
  (string-append export-header "(define openracket-binding-table-eager-enabled? " value ")\n"))
(check-case "(define stock #t)\n" "stock" #f "missing" 'null #t)
(check-case "(define stock #t)\n" "candidate" "1" "missing" 'null #f)
(check-case (boolean-body "#t") "candidate" "1" "boolean" #t #t)
(check-case (boolean-body "#f") "candidate" "1" "boolean" #f #f)
(check-case (boolean-body "#t") "candidate" #f "boolean" #t #f)
(check-case (boolean-body "#t") "stock" #f "boolean" #t #f)
(check-case (boolean-body "#f") "stock" #f "boolean" #f #f)
(check-case (boolean-body "42") "candidate" "1" "non-boolean" 'null #f)
(check-case "(define stock #t)\n" "stock" "0" "missing" 'null #f)
(for ([body (in-list (list "(define stock #t)" "(error 'test \"must not load\")"))])
  (define-values (gui sha) (module-fixture body))
  (check-exn exn:fail? (lambda () (existing-module-evidence gui "stock" sha)))
  (check-exn exn:fail? (lambda () (module->namespace gui))))
(define-values (existing-gui existing-sha) (module-fixture "(define stock #t)"))
(dynamic-require existing-gui #f)
(parameterize ([current-namespace (make-base-namespace)])
  (check-exn exn:fail? (lambda () (existing-module-evidence existing-gui "stock" existing-sha))))
(delete-file existing-gui)
(check-exn exn:fail? (lambda () (existing-module-evidence existing-gui "stock" existing-sha)))
(define-values (syntax-gui syntax-sha)
  (module-fixture (string-append "(require (for-syntax racket/base))\n" export-header
                                "(define-syntax (openracket-binding-table-eager-enabled? stx) #'#t)\n")))
(dynamic-require syntax-gui #f)
(check-exn #rx"Activation export is syntax"
           (lambda () (existing-module-evidence syntax-gui "stock" syntax-sha)))
;; An instantiated dependency's export must never substitute for the GUI's.
(define-values (dep dep-sha) (module-fixture (boolean-body "#t")))
(define-values (plain plain-sha)
  (module-fixture (format "(require (file ~s))\n" (path->string dep))))
(dynamic-require plain #f)
(in-clean-environment (lambda ()
  (check-true (hash-ref (existing-module-evidence plain "stock" plain-sha) 'verified))
  (putenv "OPENRACKET_BINDING_TABLE_EAGER" "1")
  (check-false (hash-ref (existing-module-evidence plain "candidate" plain-sha) 'verified))))
(define-values (eager eager-sha) (module-fixture (boolean-body "#t")))
(dynamic-require eager #f)
(for ([flag (in-list '("OPENRACKET_BINDING_TABLE_INDEX" "OPENRACKET_INTERVAL_INDEX"
                       "OPENRACKET_EXPANSION_REPLAY" "OPENRACKET_EXPANSION_CAPTURE"
                       "OPENRACKET_UNKNOWN"))])
  (in-clean-environment
   (lambda ()
     (putenv "OPENRACKET_BINDING_TABLE_EAGER" "1")
     (putenv flag "0") ; even a present-off prior flag is forbidden
     (define record (existing-module-evidence eager "candidate" eager-sha))
     (check-false (hash-ref record 'verified))
     (check-equal? (hash-ref record 'unexpected_experiment_flags) (list flag)))))
(delete-directory/files root)
(displayln "OPENRACKET_BINDING_EAGER_ACTIVATION_TESTS_PASSED")
