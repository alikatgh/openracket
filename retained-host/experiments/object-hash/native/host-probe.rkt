#lang racket/base
;; Diagnostic host adapter. No synthetic editor hashing is performed here.
(require racket/class racket/gui/base json)
(provide configure-probe! run-probed-follow-on-check! probe-begin! probe-end!)
(define core 'racket/private/class-internal)
(define enabled? (dynamic-require core 'openracket-object-hash-probe-enabled?))
(define instance (dynamic-require core 'openracket-object-hash-probe-instance))
(define arm! (dynamic-require core 'openracket-object-hash-probe-arm!))
(define stop! (dynamic-require core 'openracket-object-hash-probe-stop!))
(define state (dynamic-require core 'openracket-object-hash-probe-state))
(define configured? #f)
(define emitted? #f)
(define (configure-probe! verified-instance)
  (unless (and (eq? instance verified-instance) (not configured?))
    (error 'object-hash-probe "Actual host/core instance proof failed"))
  (set! configured? #t))
(define (probe-begin! frame definitions interactions)
  (unless (and configured? (not emitted?)
               (eq? (current-thread) (eventspace-handler-thread (send frame get-eventspace)))
               (eq? definitions (send frame get-definitions-text))
               (eq? interactions (send frame get-interactions-text)))
    (error 'object-hash-probe "Actual handler/editor registration proof failed"))
  (when enabled? (arm! definitions interactions (current-thread))))
(define (probe-end! [reason 'host-complete])
  (unless configured? (error 'object-hash-probe "Missing pre-registration source proof"))
  (stop! reason)
  (unless emitted?
    (set! emitted? #t)
    (display "OPENRACKET_OBJECT_HASH_OBSERVATION ")
    (write-json (state)) (newline) (flush-output)))
(define (run-probed-follow-on-check! original frame which)
  (unless (eq? which 'check-syntax)
    (error 'object-hash-probe "Only the accepted small Check Syntax fixture is supported"))
  ;; Always disarm on an original workflow failure. Preserve its raised value.
  (with-handlers ([(lambda (v) #t)
                   (lambda (v)
                     ;; Do not replace the workflow's failure with a reporting fault.
                     (with-handlers ([(lambda (ignored) #t) void])
                       (probe-end! 'host-aborted))
                     (raise v))])
    (original frame which)))
