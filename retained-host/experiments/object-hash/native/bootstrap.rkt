#lang racket/base
;; Source/activation/instance proof only. Requires a separately audited clean
;; recompilation of the isolated core AND actual GUI/DrRacket dependency graph.
(require racket/file racket/path racket/runtime-path syntax/modresolve json)
(define-runtime-path package-root "..")
(define-runtime-path host "tests/reference-host-0520.rkt")
(define-runtime-path adapter "host-probe.rkt")
(define-runtime-path pins-path "../SOURCE-PINS.json")
(define-runtime-path runtime-pins-path "../RUNTIME-PINS.json")
(define args (current-command-line-arguments))
(unless (= (vector-length args) 2) (error 'object-hash-probe "Expected off/on and isolated runtime root"))
(define mode (vector-ref args 0))
(unless (member mode '("off" "on")) (error 'object-hash-probe "Expected off/on"))
(define expected-enabled? (equal? mode "on"))
(define expected-flag (if expected-enabled? "1" "0"))
(unless (and (equal? (version) "9.3")
             (equal? (getenv "OPENRACKET_OBJECT_HASH_PROBE") expected-flag)
             (equal? (getenv "OPENRACKET_NATIVE_CASE") "check-syntax")
             (equal? (getenv "OPENRACKET_UI") "stock"))
  (error 'object-hash-probe "Wrong runtime, explicit activation, or small stock Check Syntax case"))
(define allowed '(#"OPENRACKET_OBJECT_HASH_PROBE" #"OPENRACKET_NATIVE_CASE" #"OPENRACKET_UI"
                  #"OPENRACKET_READY_FILE" #"OPENRACKET_CAPTURE_DONE"))
(for ([key (in-list (environment-variables-names (current-environment-variables)))])
  (when (and (regexp-match? #rx#"^OPENRACKET_" key) (not (member key allowed)))
    (error 'object-hash-probe "Unrelated experiment flag: ~a" key)))
;; Resolve every existing symlink component, including native /var aliases.
(define (physical p [links 0])
  (when (>= links 64) (error 'object-hash-probe "Too many symbolic links"))
  (define parts (explode-path (path->complete-path p)))
  (for/fold ([base (car parts)]) ([part (in-list (cdr parts))])
    (define next (cond [(eq? part 'same) base]
                       [(eq? part 'up) (simplify-path (build-path base 'up) #f)]
                       [else (build-path base part)]))
    (if (link-exists? next)
        (physical (path->complete-path (resolve-path next) (or (path-only next) base)) (add1 links))
        next)))
(define root (physical (vector-ref args 1)))
(unless (and (directory-exists? root) (not (equal? root (string->path "/"))))
  (error 'object-hash-probe "Isolated runtime root required"))
(define (within! path parent)
  (define actual (physical path))
  (define rel (find-relative-path (physical parent) actual))
  (unless (and (file-exists? actual) (relative-path? rel)
               (not (member 'up (explode-path rel))) (not (equal? actual (physical parent))))
    (error 'object-hash-probe "File outside required root: ~a" path))
  actual)
(define (digest path)
  (apply string-append
    (for/list ([byte (in-bytes (sha256-bytes (file->bytes path)))])
      (define str (number->string byte 16))
      (if (= (string-length str) 1) (string-append "0" str) str))))
(define pins (call-with-input-file pins-path read-json))
(for ([(name expected) (in-hash (hash-ref pins 'files))])
  (define path (within! (build-path package-root (symbol->string name)) package-root))
  (unless (equal? (digest path) expected) (error 'object-hash-probe "Package source changed: ~a" name)))
(define executable (within! (or (find-executable-path (find-system-path 'exec-file))
                              (find-system-path 'exec-file)) root))
(define runtime-pins (call-with-input-file runtime-pins-path read-json))
(define sources
  (for/hasheq ([(name expected) (in-hash runtime-pins)])
    (define path (within! (resolve-module-path name #f) root))
    (unless (equal? (digest path) expected) (error 'object-hash-probe "Runtime source drift: ~a" name))
    (values name (hasheq 'path (path->string path) 'sha256 expected))))
(define core 'racket/private/class-internal)
(dynamic-require core #f)
(define resolved (make-resolved-module-path (resolve-module-path core #f)))
(unless (= (namespace-base-phase (module->namespace resolved)) 0)
  (error 'object-hash-probe "Wrong core module phase"))
(define actual-enabled? (dynamic-require resolved 'openracket-object-hash-probe-enabled?))
(define instance (dynamic-require resolved 'openracket-object-hash-probe-instance))
(define build-id (dynamic-require resolved 'openracket-object-hash-probe-build-id))
(unless (and (eq? actual-enabled? expected-enabled?)
             (equal? build-id (hash-ref pins 'build_id)) (symbol? instance))
  (error 'object-hash-probe "Actual loaded core activation/build proof failed"))
;; Adapter independently imports the core and requires eq? token identity before
;; registration. This rules out observing a separate namespace/module instance.
((dynamic-require adapter 'configure-probe!) instance)
(display "OPENRACKET_OBJECT_HASH_SOURCE ")
(write-json (hasheq 'schema "openracket-object-hash-source/v1"
                   'runtime_root (path->string root) 'executable (path->string executable)
                   'flag expected-flag 'enabled actual-enabled? 'build_id build-id
                   'instance (symbol->string instance) 'sources sources
                   'host_sha256 (digest host) 'workflow_window "check-syntax-command-through-binding-completion"
                   'dependency_recompile "separate-required-preflight"))
(newline) (flush-output)
(dynamic-require host #f)
