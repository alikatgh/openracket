#lang racket/base
;; Real thread objects, fake work only. No DrRacket worker or GUI is run here.
(require rackunit racket/list racket/file file/sha1 "phase-probe.rkt")
(define temp (make-temporary-file "phase-service-test~a" 'directory))
(define service (build-path temp "fake-xref.rkt"))
(define absent (build-path temp "uninstantiated-xref.rkt"))
(define wrong (build-path temp "wrong-xref.rkt"))
(define marker (build-path temp "must-not-instantiate"))
(define (write-source path contents)
  (call-with-output-file path (lambda (out) (display contents out))))
(write-source service "#lang racket/base\n(define thd (thread (lambda () (sync never-evt))))\n")
(write-source absent
              (format "#lang racket/base\n(call-with-output-file ~s void)\n(define thd (current-thread))\n" (path->string marker)))
(write-source wrong "#lang racket/base\n(define thd 42)\n")
(define (pin path)
  (call-with-input-file path (lambda (in) (bytes->hex-string (sha256-bytes in)))))
;; An absent instance must remain absent, including its side effect.
(define-values (missing-ref missing-info) (existing-service-thread-reference absent (pin absent)))
(check-false missing-ref)
(check-equal? (hash-ref missing-info 'status) "unavailable")
(check-false (file-exists? marker))
(dynamic-require wrong #f)
(define-values (wrong-ref wrong-info) (existing-service-thread-reference wrong (pin wrong)))
(check-false wrong-ref)
(check-equal? (hash-ref wrong-info 'status) "unavailable")
(define service-cust (make-custodian))
(parameterize ([current-custodian service-cust]) (dynamic-require service #f))
(define-values (service-ref service-info) (existing-service-thread-reference service (pin service)))
(check-true (weak-box? service-ref))
(check-equal? (hash-ref service-info 'status) "registered_existing_service_thread")
(define-values (bad-pin-ref bad-pin-info) (existing-service-thread-reference service "wrong"))
(check-false bad-pin-ref)
(define control (start-probe! #:xref-module service #:xref-pin (pin service)))
(define (make-job)
  (define cust (make-custodian))
  (define ready (make-channel))
  (parameterize ([current-custodian cust])
    (thread
     (lambda ()
       (phase-hook! 'worker-start)
       (phase-hook! 'worker-phase-09)
       (thread
        (lambda ()
          (phase-hook! 'monitor-start)
          (phase-hook! 'monitor-build-trace-start)
          (channel-put ready #t)
          (let monitor-wait-loop () (sleep .01) (monitor-wait-loop))))
       (let worker-wait-loop () (sleep .01) (worker-wait-loop)))))
  (unless (sync/timeout 2 ready) (error 'test "Fake monitor did not start"))
  cust)
(check-eq? (control 'begin 1) 'phase-begun)
(define c1 (make-job))
(sleep .6)
(check-eq? (control 'end 1) 'phase-ended)
(define first (control 'snapshot))
(check-false (hash-ref first 'active))
(check-equal? (hash-ref first 'job_generation) 1)
(check-true (hash-ref (hash-ref first 'attribution_evidence) 'working_thread_registered))
(check-true (hash-ref (hash-ref first 'attribution_evidence) 'monitor_thread_registered))
;; Optimized contexts may be empty. Report incomplete rather than inventing stacks.
(check-true (hash-ref (hash-ref first 'attribution_evidence) 'xref_service_thread_registered))
(define useful? (and (hash-ref (hash-ref first 'attribution_evidence) 'usable_monitor_frames)
                     (hash-ref (hash-ref first 'attribution_evidence) 'usable_xref_frames)))
(check-equal? (hash-ref (hash-ref first 'attribution_evidence) 'status)
              (if useful? "coarse_thread_context_available" "incomplete"))
(check-true (positive? (length (hash-ref first 'thread_samples))))
(for* ([sample (in-list (hash-ref first 'thread_samples))]
       [th (in-list (hash-ref sample 'threads))])
  (check-equal? (hash-ref sample 'job_generation) 1)
  (check-true (<= (length (hash-ref th 'frames '())) 8)))
;; First job remains alive temporarily: generation two must not reuse its weak refs.
(check-eq? (control 'begin 2) 'phase-begun)
(define before-second (control 'snapshot))
(check-equal? (hash-ref (hash-ref before-second 'attribution_evidence) 'status) "incomplete")
(check-false (hash-ref (hash-ref before-second 'attribution_evidence) 'working_thread_registered))
(define c2 (make-job))
(sleep .3)
(custodian-shutdown-all c1)
(custodian-shutdown-all c2)
(check-eq? (control 'end 2) 'phase-ended)
(define second (control 'snapshot))
(check-equal? (hash-ref second 'job_generation) 2)
(check-true (hash-ref (hash-ref second 'attribution_evidence) 'xref_service_thread_registered))
(check-equal? (hash-ref first 'xref_service_registration) (hash-ref second 'xref_service_registration))
(check-false (thread-dead? (weak-box-value service-ref)))
(for ([point (in-list (hash-ref second 'phase_points))])
  (check-equal? (hash-ref point 'job_generation) 2))
(check-true (<= (length (hash-ref second 'thread_samples)) 256))
(check-true (<= (length (hash-ref second 'phase_points)) 128))
(check-false (hash-ref second 'stock_logger_subscription))
(check-true (control 'stop))
(custodian-shutdown-all service-cust)
(check-true (thread-dead? (weak-box-value service-ref)))
(delete-directory/files temp)
(displayln "Phase probe headless thread/generation tests passed; no native expansion executed.")
