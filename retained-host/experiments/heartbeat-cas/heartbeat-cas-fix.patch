+;; Fault only the once-claim CAS, never scalar-state updates. The hook returns
+;; #f while leaving the unclaimed box unchanged, exactly as native CAS permits.
+;; Parameterize both producer creation and fake GUI dispatch: callbacks run in
+;; the dispatching thread, not necessarily in their producer's parameterization.
+(define (make-spurious-cas count)
+  (define remaining (box count))
+  (define attempts (box 0))
+  (define (cas! once old new)
+    (check-false old)
+    (check-true new)
+    (set-box! attempts (add1 (unbox attempts)))
+    (cond
+      [(positive? (unbox remaining))
+       (check-false (unbox once))
+       (set-box! remaining (sub1 (unbox remaining)))
+       #f]
+      [else (box-cas! once old new)]))
+  (values cas! remaining attempts))
+
+(test-case "spurious callback claims retry and still record, acknowledge and join"
+  (for ([failures (in-list '(1 3))])
+    (define-values (cas! remaining attempts) (make-spurious-cas failures))
+    (parameterize ([current-once-cas! cas!])
+      (define d (make-dispatcher))
+      (with-heartbeat
+       d
+       (lambda (h)
+         (await-queued d)
+         (define until (deadline))
+         (heartbeat-stop! h)
+         (check-true (heartbeat-join! h (dispatcher-yield d) until))
+         (check-equal? (unbox remaining) 0)
+         (check-true (>= (unbox attempts) (add1 failures)))
+         (check-equal? (field h 'submitted_count) 1)
+         (check-equal? (field h 'handled_count) 1)
+         (check-equal? (length (rows h)) 1)
+         (check-equal? (field h 'outstanding_callbacks) 0)
+         (check-equal? (field h 'error_count) 0)
+         (check-false (field h 'join_timed_out))
+         (check-true (field h 'joined))
+         (check-true (field h 'producer_exited))
+         (check-true (heartbeat-ok? h))
+         (check-equal? (unbox (dispatcher-maximum d)) 1)
+         (check-equal? (unbox (dispatcher-priorities d)) '(#f)))))))
+
+(test-case "a truly repeated callback is still rejected after spurious retry"
+  (define-values (cas! remaining attempts) (make-spurious-cas 1))
+  (parameterize ([current-once-cas! cas!])
+    (define d (make-dispatcher))
+    (define accepted-callback #f)
+    (define h
+      (start-heartbeat!
+       (lambda (callback priority)
+         (set! accepted-callback callback)
+         ((dispatcher-queue d) callback priority))
+       #:period-ms 1.0))
+    (dynamic-wind
+      void
+      (lambda ()
+        (await-queued d)
+        (heartbeat-stop! h)
+        ((dispatcher-pop d))
+        (define first-attempts (unbox attempts))
+        (accepted-callback)
+        (check-true (heartbeat-join! h (dispatcher-yield d) (deadline)))
+        (check-equal? (unbox remaining) 0)
+        (check-equal? (unbox attempts) first-attempts)
+        (check-equal? (field h 'errors) '("duplicate-callback"))
+        (check-equal? (field h 'error_count) 1)
+        (check-equal? (field h 'submitted_count) 1)
+        (check-equal? (field h 'handled_count) 1)
+        (check-equal? (length (rows h)) 1)
+        (check-equal? (field h 'outstanding_callbacks) 0)
+        (check-false (heartbeat-ok? h)))
+      (lambda () (stop/join h d)))))
+
+(test-case "spurious queue-failure cleanup claims cannot strand acknowledgment"
+  (define-values (cas! remaining attempts) (make-spurious-cas 3))
+  (parameterize ([current-once-cas! cas!])
+    (define attempted (make-semaphore 0))
+    (define h
+      (start-heartbeat!
+       (lambda (_callback _priority)
+         (semaphore-post attempted)
+         (error 'fake "queue unavailable"))
+       #:period-ms 1.0))
+    (check-not-false (sync/timeout 2.0 attempted))
+    (define until (deadline))
+    (check-true (heartbeat-join! h sync until))
+    (check-equal? (unbox remaining) 0)
+    (check-true (>= (unbox attempts) 4))
+    (check-equal? (field h 'errors) '("queue-callback-failed"))
+    (check-equal? (field h 'error_count) 1)
+    (check-equal? (field h 'submitted_count) 1)
+    (check-equal? (field h 'handled_count) 0)
+    (check-equal? (rows h) '())
+    (check-equal? (field h 'outstanding_callbacks) 0)
+    (check-true (field h 'joined))
+    (check-true (field h 'producer_exited))
+    (check-false (field h 'join_timed_out))
+    (check-false (heartbeat-ok? h))))
+
+(test-case "callback then queue error preserves the original acknowledgment owner"
+  (define-values (cas! remaining attempts) (make-spurious-cas 1))
+  (parameterize ([current-once-cas! cas!])
+    (define attempted (make-semaphore 0))
+    (define callback-attempts #f)
+    (define h
+      (start-heartbeat!
+       (lambda (callback _priority)
+         ;; Deliberately broken queue: callback succeeds before queueing raises.
+         (callback)
+         (set! callback-attempts (unbox attempts))
+         (semaphore-post attempted)
+         (error 'fake "queue raised after callback"))
+       #:period-ms 1.0))
+    (check-not-false (sync/timeout 2.0 attempted))
+    (define until (deadline))
+    (check-true (heartbeat-join! h sync until))
+    (check-equal? (unbox remaining) 0)
+    (check-equal? (unbox attempts) callback-attempts)
+    (check-equal? (field h 'errors) '("queue-callback-failed"))
+    (check-equal? (field h 'error_count) 1)
+    (check-equal? (field h 'submitted_count) 1)
+    (check-equal? (field h 'handled_count) 1)
+    (check-equal? (length (rows h)) 1)
+    (check-equal? (field h 'outstanding_callbacks) 0)
+    (check-true (field h 'joined))
+    (check-true (field h 'producer_exited))
+    (check-false (field h 'join_timed_out))
+    (check-false (heartbeat-ok? h))))
+
