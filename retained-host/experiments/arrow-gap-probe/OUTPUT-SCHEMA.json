  "cli": {
    "prepare": "native_preflight.py --racket EXE --pristine-source PRIVATE --profile PROFILE; prepare_gui.py --diagnostic-root CLONE --racket EXE",
    "capture": "capture.py --arm control|observed --racket EXE --fixture FIXTURE --output NEW_DIRECTORY",
