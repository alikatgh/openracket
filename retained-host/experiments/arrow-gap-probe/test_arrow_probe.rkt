#lang racket/base
;; Native deterministic tests for scalar nested arrow attribution and pending tokens.
(require rackunit racket/list racket/runtime-path)
(define-runtime-path helper "application-probe.rkt")
(define observed? (equal? (getenv "OPENRACKET_GUI_APPLICATION_POINTS") "1"))
(define arrow-tag 'syncheck:add-arrow/name-dup/pxpy)
(define (fresh run)
  (parameterize ([current-namespace (make-base-namespace)])
    (run (dynamic-require helper 'application-hook)
         (dynamic-require helper 'application-arrow-hook)
         (dynamic-require helper 'application-summary)
         (dynamic-require helper 'application-pending-box))))
(define (row s [n 0]) (list-ref (hash-ref (s) 'records) n))
(define (detail s) (hash-ref (row s) 'arrow_detail))
(define (open-arrow h a)
  (define r (h 'begin #(9 1))) (h 'batch-start r)
  (h 'entry-before r arrow-tag)
  (values r (a 'method-before #f)))
(define (call-binding a ar result)
  (a 'before ar 0)
  (let ([original-result result])
    (a 'binding-after ar original-result)
    original-result))
(define (call-endpoints a ar)
  (for ([index '(1 2)])
    (a 'before ar index)
    (begin0 (void) (a 'endpoint-after ar index))))

(fresh (lambda (h a s pending)
  ;; Before/after a selected replay is ordinary stock work, not an attribution error.
  (check-false (a 'method-before #f))
  (define r (h 'begin #(9 1))) (h 'batch-start r)
  (check-false (a 'method-before #f))
  (h 'batch-yield r)
  (cond [observed?
         (define token (unbox pending))
         (check-true (immutable? token))
         (check-equal? (vector->list token) (list 9 1 1 (vector-ref token 3)))
         (h 'batch-resume r)
         (check-false (unbox pending))]
        [else (check-false (unbox pending)) (h 'batch-resume r)])
  (h 'finish r #t)
  (check-false (a 'method-before #f))
  (check-equal? (hash-ref (row s) 'errors) 0)))

(when observed?
  (for ([result '(#f #t)])
    (fresh (lambda (h a s pending)
      (define-values (r ar) (open-arrow h a))
      (check-eq? ar r)
      (when (call-binding a ar result) (call-endpoints a ar))
      (a 'method-after ar) (h 'entry-after r) (h 'finish r #t)
      (check-equal? (hash-ref (row s) 'errors) 0)
      (define d (detail s))
      (check-equal? (hash-ref d 'binding_true) (if result 1 0))
      (check-equal? (hash-ref d 'binding_false) (if result 0 1))
      (define ops (hash-ref d 'operations))
      (check-equal? (map (lambda (v) (hash-ref v 'count)) ops)
                    (if result '(1 1 1) '(1 0 0)))
      (check-true (<= (for/sum ([v (in-list ops)]) (hash-ref v 'wall_ms))
                      (hash-ref (car (hash-ref (row s) 'tag_buckets)) 'wall_ms)))
      (check-equal? (hash-ref d 'open_method_depth) 0)
      (check-false (hash-ref d 'open_nested)))))
  ;; Original outer guard false: method safely exits; stock-workload acceptance
  ;; separately requires binding count equals inclusive arrow count.
  (fresh (lambda (h a s pending)
    (define-values (r ar) (open-arrow h a))
    (a 'method-after ar) (h 'entry-after r)
    (check-equal? (hash-ref (row s) 'errors) 0)
    (check-equal? (hash-ref (car (hash-ref (detail s) 'operations)) 'count) 0)))
  ;; A true result without both endpoints cannot become complete attribution.
  (fresh (lambda (h a s pending)
    (define-values (r ar) (open-arrow h a))
    (call-binding a ar #t) (a 'method-after ar) (h 'entry-after r)
    (check-true (positive? (hash-ref (row s) 'unmatched_events)))))
  ;; An endpoint after false, unmatched after, and reentrant before all fail.
  (for ([bad '(false-endpoint unmatched-after nested-before)])
    (fresh (lambda (h a s pending)
      (define-values (r ar) (open-arrow h a))
      (case bad
        [(false-endpoint) (call-binding a ar #f) (a 'before ar 1)]
        [(unmatched-after) (a 'endpoint-after ar 1)]
        [(nested-before) (a 'before ar 0) (a 'before ar 0)])
      (check-true (positive? (hash-ref (row s) 'errors))))))
  ;; Nested method invocation never gets attributed to an outer original call.
  (fresh (lambda (h a s pending)
    (define-values (r ar) (open-arrow h a))
    (define nested (a 'method-before #f))
    (call-binding a nested #f) (a 'method-after nested)
    (call-binding a ar #f) (a 'method-after ar) (h 'entry-after r)
    (check-true (positive? (hash-ref (row s) 'reentrant_entries)))))
  ;; Wrong selected entry kind is a conflict; outside an entry was ignored above.
  (fresh (lambda (h a s pending)
    (define r (h 'begin #(9 1))) (h 'batch-start r)
    (h 'entry-before r 'syncheck:add-tail-arrow)
    (check-false (a 'method-before #f))
    (check-true (positive? (hash-ref (row s) 'unmatched_events)))))
  ;; An exception/escape in the original consumer is never caught by the hook.
  (for ([where '(binding start end)])
    (fresh (lambda (h a s pending)
      (define-values (r ar) (open-arrow h a))
      (define original (exn:fail "original consumer" (current-continuation-marks)))
      (define answer
        (with-handlers ([exn:fail? values])
          (a 'before ar 0)
          (define got (if (eq? where 'binding) (raise original) #t))
          (a 'binding-after ar got)
          (a 'before ar 1)
          (when (eq? where 'start) (raise original))
          (a 'endpoint-after ar 1)
          (a 'before ar 2)
          (raise original)
          (a 'endpoint-after ar 2)))
      (check-eq? answer original)
      (check-true (hash-ref (detail s) 'open_nested))
      (check-equal? (hash-ref (detail s) 'open_method_depth) 1)
      (check-equal? (hash-ref (row s) 'open_entry_depth) 1))))
  ;; Captured scalar record remains stale after a new selected generation.
  (fresh (lambda (h a s pending)
    (define-values (r ar) (open-arrow h a))
    (a 'before ar 0)
    (define next (h 'begin #(9 2))) (h 'batch-start next)
    (a 'binding-after ar #t)
    (check-true (positive? (hash-ref (row s) 'stale_events)))))
  ;; Stale callback clears its formerly pending token before stock liveness.
  (fresh (lambda (h a s pending)
    (define r (h 'begin #(9 1))) (h 'batch-start r) (h 'batch-yield r)
    (define old (unbox pending))
    (h 'begin #(9 2))
    (h 'batch-resume r)
    (check-false (unbox pending))
    (check-true (positive? (hash-ref (row s) 'stale_events))))))

(when observed?
  (fresh (lambda (h a s pending)
    (define first (h 'begin #(9 1))) (h 'batch-start first) (h 'batch-yield first)
    (define second (h 'begin #(9 2))) (h 'batch-start second) (h 'batch-yield second)
    (define newer-token (unbox pending))
    (h 'batch-resume first)
    (check-eq? (unbox pending) newer-token)
    (check-true (positive? (hash-ref (row s) 'stale_events)))
    (h 'batch-resume second)
    (check-false (unbox pending)))))
