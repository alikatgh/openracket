#lang racket/base
;; Pure contract; no GUI and no application operations.
(require json racket/file racket/list racket/path racket/string)
(provide validate-config read-json-file canonical contained? step-names control-path
         envelope ack-valid? json-safe expected-memory-bytes)
(define (canonical value)
  (define p (path->complete-path value))
  (unless (or (file-exists? p) (directory-exists? p))
    (error 'quit-contract "Missing managed path: ~a" p))
  (path->string (apply build-path (explode-path (normalize-path p)))))
(define (contained? child parent)
  (define c (explode-path (string->path (canonical child))))
  (define p (explode-path (string->path (canonical parent))))
  (and (> (length c) (length p)) (equal? (take c (length p)) p)))
(define (json-safe x)
  (cond [(eq? x 'null) 'null] [(symbol? x) (symbol->string x)]
        [(path? x) (path->string x)]
        [(hash? x) (for/hash ([(k v) (in-hash x)]) (values k (json-safe v)))]
        [(list? x) (map json-safe x)] [else x]))
(define (read-json-file p)
  (unless (<= (file-size p) 65536) (error 'quit-contract "Oversized control JSON"))
  (call-with-input-file p (lambda (in)
    (define v (read-json in))
    (unless (eof-object? (read-json in)) (error 'quit-contract "Trailing JSON data")) v)))
(define (step-names c)
  (if (equal? (hash-ref c 'case) "clean")
      '("ready" "quit-confirm-1" "terminal-response")
      '("ready" "dirty" "quit-confirm-1" "unsaved-1" "cancelled"
        "quit-confirm-2" "unsaved-2" "terminal-response")))
(define (control-path c stage suffix)
  (build-path (hash-ref c 'output_dir)
              (format "~a.~a.~a.json" (hash-ref c 'run_id) stage suffix)))
(define (envelope c stage)
  (hash 'schema 1 'run_id (hash-ref c 'run_id) 'stage stage
        'token (hash-ref (hash-ref c 'step_tokens) (string->symbol stage))))
(define (ack-valid? a c stage)
  (and (hash? a)
       (equal? (sort (hash-keys a) symbol<?) '(capture_ok run_id schema stage token))
       (for/and ([(k v) (in-hash (envelope c stage))]) (equal? (hash-ref a k #f) v))
       (eq? (hash-ref a 'capture_ok #f) #t)))
(define (expected-memory-bytes c)
  (* (hash-ref c 'memory_mib) 1024 1024))
(define keys '(schema run_id mode case root_dir output_dir profile_path app_path
               native_executable_path bundle_id fixture_path original_text edited_text
               runtime_root step_tokens memory_mib process_timeout_seconds))
(define (validate-config c)
  (define (check v message) (unless v (error 'quit-contract "~a" message)))
  (check (hash? c) "Config must be an object")
  (check (equal? (sort (hash-keys c) symbol<?) (sort keys symbol<?)) "Exact config keys required")
  (check (eqv? (hash-ref c 'schema) 1) "Schema integer 1 required")
  (define (token? v) (and (string? v) (regexp-match-exact? #px"[A-Za-z0-9_-]{16,100}" v)))
  (check (token? (hash-ref c 'run_id)) "Fresh run ID required")
  (check (member (hash-ref c 'mode) '("stock" "modern-dark")) "Known mode required")
  (check (member (hash-ref c 'case) '("clean" "save" "discard")) "Known case required")
  (check (eqv? (hash-ref c 'process_timeout_seconds) 150) "Frozen 150-second bound required")
  (check (eqv? (hash-ref c 'memory_mib) (if (equal? (hash-ref c 'mode) "stock") 128 256))
         "Preserve stock default 128MiB and product-owned 256MiB")
  (for ([k '(root_dir output_dir profile_path app_path native_executable_path fixture_path runtime_root)])
    (define p (hash-ref c k))
    (check (and (string? p) (<= 1 (string-length p) 4096)
                (not (regexp-match? #rx"[\u0000\r\n]" p)) (complete-path? (string->path p)))
           (format "Absolute bounded ~a required" k))
    (check (not (link-exists? p)) (format "Symlinked managed ~a refused" k))
    (canonical p))
  (for ([k '(output_dir profile_path app_path fixture_path)])
    (check (contained? (hash-ref c k) (hash-ref c 'root_dir)) (format "~a escapes case root" k)))
  (check (contained? (hash-ref c 'native_executable_path) (hash-ref c 'app_path)) "Native image escapes bundle")
  (check (and (string? (hash-ref c 'bundle_id))
              (regexp-match-exact? #px"[A-Za-z0-9.-]+" (hash-ref c 'bundle_id))) "Bundle identity required")
  (for ([k '(original_text edited_text)])
    (define v (hash-ref c k))
    (check (and (string? v) (<= 1 (string-length v) 4096)
                (string-prefix? v "#lang racket/base\n") (string-suffix? v "\n")
                (not (regexp-match? #rx"\u0000" v))) "Bounded newline-terminated fixture required"))
  (define original (hash-ref c 'original_text))
  (define edited (hash-ref c 'edited_text))
  (check (and (> (string-length edited) (string-length original))
              (string-prefix? edited original)
              (string-prefix? (substring edited (string-length original)) ";; "))
         "Only a bounded appended comment is permitted")
  (check (equal? (file->bytes (hash-ref c 'fixture_path)) (string->bytes/utf-8 original))
         "Fixture must initially contain exact original bytes")
  (define ts (hash-ref c 'step_tokens))
  (check (and (hash? ts)
              (equal? (sort (map symbol->string (hash-keys ts)) string<?) (sort (step-names c) string<?))
              (andmap token? (hash-values ts))
              (= (hash-count ts) (length (remove-duplicates (hash-values ts)))))
         "Unique tokens for every exact stage required")
  c)
