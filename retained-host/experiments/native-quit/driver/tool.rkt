#lang racket/base
;; Separate test actor. It edits only a declared new temp fixture and commands
;; existing shown stock controls. It never installs a handler or exits on success.
(require racket/class racket/file racket/list racket/path racket/string racket/unit
         racket/runtime-path racket/gui/base drracket/tool framework string-constants
         file/sha1 json "contract.rkt")
(provide tool@)
(define-runtime-path config-path "quit-config.json")
(define-runtime-path pins-path "source-pins.json")
(define-runtime-path identity-path "cocoa-identity.rkt")
(define (digest b) (bytes->hex-string (sha256-bytes b)))
(define (bounded v [n 1000])
  (define s (if (string? v) v (format "~s" v)))
  (substring s 0 (min n (string-length s))))
(define (atomic-new! p v)
  (define temp (path-add-extension p #".tmp"))
  (call-with-output-file temp #:exists 'error
    (lambda (out) (write-json (json-safe v) out) (newline out)))
  (rename-file-or-directory temp p #f))
(define (geometry w)
  (define-values (width height) (send w get-size))
  (hash 'x (send w get-x) 'y (send w get-y) 'width width 'height height))
(define (visible-descendants node)
  (if (and (is-a? node window<%>) (not (send node is-shown?))) '()
      (cons node (if (is-a? node area-container<%>)
                     (append-map visible-descendants (send node get-children)) '()))))
(define (shown-dialogs)
  (filter (lambda (w) (and (is-a? w dialog%) (send w is-shown?))) (get-top-level-windows)))
(define (diagnostics)
  (for/list ([w (in-list (take (get-top-level-windows) (min 8 (length (get-top-level-windows)))))])
    (hash 'label (bounded (send w get-label)) 'shown (send w is-shown?)
          'dialog (is-a? w dialog%) 'geometry (geometry w)
          'message (if (object-method-arity-includes? w 'get-message 0)
                       (bounded (send w get-message) 2000) #f)
          'labels (for/list ([v (in-list (take (visible-descendants w)
                                               (min 40 (length (visible-descendants w)))))]
                             #:when (object-method-arity-includes? v 'get-label 0))
                    (bounded (send v get-label) 300)))))
(define tool@
  (unit
    (import drracket:tool^)
    (export drracket:tool-exports^)
    (define (phase1) (void))
    (define (phase2) (when (file-exists? config-path) (start!)))
    (define (start!)
      (define c #f)
      (define timer #f)
      (define phase 'startup)
      (define stage "ready")
      (define frame #f)
      (define defs #f)
      (define ints #f)
      (define tab #f)
      (define dc #f)
      (define ic #f)
      (define quit-handler #f)
      (define identity-reader #f)
      (define pid #f)
      (define source-reports #f)
      (define ready-report #f)
      (define active-dialog #f)
      (define request-attempt #f)
      (define request-frame #f)
      (define request-windows '())
      (define last-activation #f)
      (define request-activation #f)
      (define request-evidence #f)
      (define checks 0)
      (define closed? #f)
      (define focused? #f)
      (define ids (make-hasheq))
      (define next-id 0)
      (define stage-deadline (+ (current-inexact-monotonic-milliseconds) 60000))
      (define overall-deadline (+ (current-inexact-monotonic-milliseconds) 150000))
      (define cancel-since #f)
      (define cancel-turns 0)
      (define last-state (hash))
      (define (id obj) (hash-ref! ids obj (lambda () (set! next-id (add1 next-id)) next-id)))
      (define (assert! v why)
        (unless v (error 'native-quit-driver "~a" why))
        (set! checks (add1 checks)))
      (define (fail! problem)
        (unless closed?
          (set! closed? #t)
          (when timer (send timer stop))
          (define report
            (hash 'schema 1 'status "failed" 'stage stage 'phase phase
                  'run_id (if c (hash-ref c 'run_id) #f) 'error (bounded problem 4000)
                  'checks checks 'last_state last-state
                  'activation last-activation 'quit_request request-evidence
                  'windows (with-handlers ([(lambda (_) #t) (lambda (e) (list (bounded e)))])
                             (diagnostics))))
          ;; Failure is durable before the only explicit application exit here.
          (when c
            (with-handlers ([(lambda (_) #t) (lambda (e)
                            (eprintf "OPENRACKET_QUIT_FAILURE_WRITE ~a\n" (bounded e)))])
              (atomic-new! (build-path (hash-ref c 'output_dir) "failure.json") report)))
          (printf "OPENRACKET_QUIT_FAILED ~a\n" (jsexpr->string (json-safe report)))
          (flush-output)
          (exit 2)))
      (define (gui!)
        (assert! (and frame
                      (eq? (current-eventspace) (send frame get-eventspace))
                      (eq? (current-thread) (eventspace-handler-thread (send frame get-eventspace)))
                      (current-eventspace-has-standard-menus?))
                 "Actual initial GUI handler and standard application menus"))
      ;; Public focus observes the toolkit's actual activation flag. Edit-target
      ;; alone can select a shown frame whose activation timestamps are still 0.
      ;; These are observations, not installed on-activate handlers or native writes.
      (define (observe-activation!)
        (gui!)
        (define focus (get-top-level-focus-window))
        (define edit-target (get-top-level-edit-target-window))
        (set! last-activation
              (hash 'active_focus (eq? focus frame)
                    'focus_frame_id (and focus (id focus))
                    'edit_target_frame_id (and edit-target (id edit-target))))
        last-activation)
      (define (activation-ready? a)
        (and (hash-ref a 'active_focus)
             (equal? (hash-ref a 'focus_frame_id) (id frame))
             (equal? (hash-ref a 'edit_target_frame_id) (id frame))))
      (define (sources!)
        (for/list ([p (in-list (read-json-file pins-path))])
          (define parts (string-split (hash-ref p 'module) "/"))
          (define source (apply collection-file-path (last parts) (drop-right parts 1)))
          (define actual (digest (file->bytes source)))
          (assert! (equal? actual (hash-ref p 'sha256)) (format "Exact official Quit source: ~a" source))
          (hash 'module (hash-ref p 'module) 'path source 'sha256 actual)))
      (define (identity!)
        (gui!)
        (define x (identity-reader))
        (define real-pid (hash-ref x 'pid))
        (unless pid (set! pid real-pid))
        (assert! (and (exact-positive-integer? real-pid) (= real-pid pid)
                      (= real-pid (hash-ref x 'running_pid)) (hash-ref x 'same_running_application))
                 "Actual stable libc/Cocoa process identity")
        (for ([k '(running_bundle_identifier main_bundle_identifier)])
          (assert! (equal? (hash-ref x k) (hash-ref c 'bundle_id)) "Exact generated bundle identifier"))
        (for ([k '(running_bundle_path main_bundle_path)])
          (assert! (and (hash-ref x k) (equal? (canonical (hash-ref x k)) (canonical (hash-ref c 'app_path))))
                   "Exact actual generated bundle path"))
        (assert! (equal? (canonical (hash-ref x 'process_image_path))
                         (canonical (hash-ref c 'native_executable_path))) "Exact actual dyld process image")
        x)
      (define (host! dirty?)
        (gui!)
        (assert! (is-a? frame (drracket:get/extend:get-unit-frame)) "Genuine registered frame")
        (assert! (and (send frame is-shown?) (equal? (send frame get-tabs) (list tab))
                      (eq? (send frame get-current-tab) tab) (eq? (send tab get-frame) frame))
                 "One original shown frame/tab")
        (assert! (and (eq? (send frame get-definitions-text) defs) (eq? (send tab get-defs) defs)
                      (eq? (send frame get-interactions-text) ints) (eq? (send tab get-ints) ints)
                      (eq? (send frame get-definitions-canvas) dc) (eq? (send dc get-editor) defs)
                      (eq? (send frame get-interactions-canvas) ic) (eq? (send ic get-editor) ints))
                 "Original retained editor/canvas wiring")
        (assert! (and (is-a? defs (drracket:get/extend:get-definitions-text))
                      (is-a? ints (drracket:get/extend:get-interactions-text))) "Registered editor classes")
        (assert! (equal? (canonical (send defs get-filename)) (canonical (hash-ref c 'fixture_path)))
                 "Exact named temporary document")
        (assert! (equal? (send defs get-text) (hash-ref c (if dirty? 'edited_text 'original_text)))
                 "Exact live fixture text")
        (assert! (eq? (send defs is-modified?) dirty?) "Actual editor modified flag")
        (assert! (equal? (file->bytes (hash-ref c 'fixture_path))
                         (string->bytes/utf-8 (hash-ref c 'original_text))) "Disk stays original before final response")
        (assert! (eq? quit-handler (application-quit-handler)) "Installed application Quit handler unchanged")
        (assert! (eq? (preferences:get 'framework:verify-exit) #t) "Keep original verify-exit preference true")
        (assert! (equal? (preferences:get 'drracket:child-only-memory-limit) (expected-memory-bytes c))
                 "Unchanged selected profile memory contract")
        (hash 'frame_id (id frame) 'tab_id (id tab) 'definitions_id (id defs)
              'interactions_id (id ints) 'definitions_canvas_id (id dc) 'interactions_canvas_id (id ic)
              'filename (canonical (send defs get-filename)) 'text (send defs get-text)
              'modified (send defs is-modified?) 'disk_sha256 (digest (file->bytes (hash-ref c 'fixture_path)))
              'verify_exit #t 'handler_unchanged #t 'geometry (geometry frame)))
      (define (check-profile!)
        (for ([pair (list (cons "PLTUSERHOME" (hash-ref c 'profile_path))
                         (cons "PLTADDONDIR" (build-path (hash-ref c 'profile_path) ".local" "share" "racket")))])
          (assert! (and (getenv (car pair)) (equal? (canonical (getenv (car pair))) (canonical (cdr pair))))
                   "Actual selected private profile/addon"))
        (assert! (and (pair? (current-compiled-file-roots))
                      (path? (car (current-compiled-file-roots)))
                      (equal? (canonical (car (current-compiled-file-roots)))
                              (canonical (build-path (hash-ref c 'profile_path) "compiled-cache"))))
                 "Private-first compiled cache"))
      (define (mode-evidence!)
        (define modern? (equal? (hash-ref c 'mode) "modern-dark"))
        (define native #f)
        (assert! (equal? (getenv "OPENRACKET_UI") (if modern? "modern" "stock")) "Actual requested UI mode")
        (when modern?
          (assert! (equal? (getenv "OPENRACKET_THEME") "dark") "Actual product explicit dark theme")
          (assert! (eq? (preferences:get 'openracket:appearance-state) 'applied) "Actual appearance transaction")
          (assert! (eq? (preferences:get 'framework:white-on-black-mode?) #t) "Actual dark editor preference")
          (assert! (eq? ((dynamic-require 'mrlib/private/openracket-paint 'get-modern-host-theme)) 'dark)
                   "Actual dark painter")
          (assert! ((dynamic-require 'mrlib/private/openracket-paint 'get-modern-chrome-blended?))
                   "Actual native blending")
          (assert! (eq? (dynamic-require 'framework/private/text-misc 'openracket-experimental-save-scan-guard?) #t)
                   "Accepted product save-scan guard remains enabled")
          (assert! (and (eq? (color-prefs:get-current-color-scheme-name #:wob? #f) '|OpenRacket Light|)
                        (eq? (color-prefs:get-current-color-scheme-name #:wob? #t) '|OpenRacket Dark|))
                   "Actual selected OpenRacket palettes")
          (define make-adapter (dynamic-require 'openracket-appearance/native-appearance-platform
                                               'make-platform-native-appearance-adapter))
          (define inspect (dynamic-require 'openracket-appearance/native-appearance
                                          'native-appearance-adapter-inspect))
          (define unavailable #f)
          (define adapter (make-adapter #:enabled? #t #:on-unavailable (lambda (why) (set! unavailable why))))
          (assert! adapter (format "Existing native appearance read-only inspector: ~s" unavailable))
          (set! native ((inspect adapter)))
          (assert! (and (eq? (hash-ref native 'backend #f) 'cocoa)
                        (equal? (hash-ref native 'explicit-name #f) "NSAppearanceNameDarkAqua")
                        (equal? (hash-ref native 'effective-name #f) "NSAppearanceNameDarkAqua"))
                   "Actual Cocoa explicit and effective DarkAqua"))
        (unless modern?
          (assert! (not (member (color-prefs:get-current-color-scheme-name)
                               '(|OpenRacket Light| |OpenRacket Dark|))) "Stock palette remains stock"))
        (hash 'mode (hash-ref c 'mode) 'memory_mib (hash-ref c 'memory_mib)
              'stock_control (if modern? #f "official-generator native app running unchanged DrRacket")
              'native native 'finder_or_apple_event_route_tested #f))
      (define mode-report #f)
      (define (dirty?) (not (equal? (hash-ref c 'case) "clean")))
      (define (publish! next-stage extra dirty-state?)
        (set! stage next-stage)
        (define base (envelope c stage))
        (define report
          (hash-set* base 'status "ready" 'checks checks 'identity (identity!)
                     'host (host! dirty-state?) 'mode_evidence mode-report
                     'sources source-reports 'evidence extra 'test_actor #t
                     'handler_replaced #f 'test_exit_used #f 'entrypoint_replaced #f))
        (set! ready-report report) (set! last-state report)
        (atomic-new! (control-path c stage "ready") report)
        (printf "OPENRACKET_QUIT_READY ~a\n" (jsexpr->string (json-safe report))) (flush-output)
        (set! phase 'capture)
        (set! stage-deadline (min overall-deadline (+ (current-inexact-monotonic-milliseconds) 20000))))
      (define (unique-control dlg class% label)
        (define matches
          (filter (lambda (x) (and (is-a? x class%) (equal? (send x get-label) label)))
                  (visible-descendants dlg)))
        (assert! (= (length matches) 1) (format "Exactly one shown control ~s" label))
        (assert! (send (car matches) is-enabled?) "Actual control enabled")
        (car matches))
      (define (dialog! kind)
        (define ds (shown-dialogs))
        (cond [(null? ds) #f]
              [else
               (assert! (= (length ds) 1) "Exactly one shown modal")
               (define d (car ds))
               (assert! (and (equal? (send d get-label) (string-constant warning))
                             (eq? (send d get-eventspace) (send frame get-eventspace))
                             (object-method-arity-includes? d 'get-message 0)) "Actual stock warning dialog")
               (define unsaved? (eq? kind 'unsaved))
               (assert! (and (eq? request-frame frame) (member request-attempt '(1 2))
                             (equal? stage (format "~a-~a" (if unsaved? "unsaved" "quit-confirm") request-attempt))
                             (not (memq d request-windows))) "Modal belongs to the current real Quit request")
               (define expected-message
                 (if unsaved? (format (string-constant file-is-not-saved)
                                      (send defs get-filename/untitled-name))
                     (string-constant are-you-sure-quit)))
               (assert! (equal? (send d get-message) expected-message) "Exact stock warning message")
               (define labels (if unsaved? (list (string-constant save) (string-constant cancel) (string-constant dont-save))
                                  (list (string-constant quit) (string-constant dont-quit))))
               (define buttons (filter (lambda (x) (is-a? x button%)) (visible-descendants d)))
               (assert! (equal? (sort (map (lambda (b) (send b get-label)) buttons) string<?)
                                (sort labels string<?)) "Exact stock button set")
               (for ([label (in-list labels)]) (unique-control d button% label))
               (define boxes (filter (lambda (x) (is-a? x check-box%)) (visible-descendants d)))
               (if unsaved?
                   (begin (assert! (null? boxes) "Unsaved dialog has no checkbox")
                          (assert! (eq? (send d get-parent) frame) "Actual unsaved-dialog parent frame"))
                   (let ([cb (unique-control d check-box% (string-constant dont-ask-again))])
                     (assert! (not (send d get-parent)) "Original application-modal Quit confirmation has no parent")
                     (assert! (= (length boxes) 1) "Single actual persistence checkbox")
                     (assert! (eq? (send cb get-value) #f) "Persistence checkbox remains unchecked")))
               (set! active-dialog d)
               (hash 'dialog_id (id d) 'kind kind 'shown #t 'message (send d get-message)
                     'request_attempt request-attempt 'request_frame_id (id request-frame)
                     'request_activation request-activation
                     'parent_frame_id (if (send d get-parent) (id (send d get-parent)) #f)
                     'labels labels 'checkbox_values (map (lambda (b) (send b get-value)) boxes)
                     'geometry (geometry d))]))
      (define (next-wait! name next-phase)
        (set! stage name) (set! phase next-phase)
        (set! stage-deadline (min overall-deadline (+ (current-inexact-monotonic-milliseconds) 20000))))
      (define (request-quit! attempt)
        (assert! (null? (shown-dialogs)) "No modal before application Quit")
        (assert! (not (exit:exiting?)) "Original exit state reset before Quit")
        (set! request-activation (observe-activation!))
        (assert! (activation-ready? request-activation) "Original frame has actual active focus and edit target before Quit")
        (assert! (eq? quit-handler (application-quit-handler)) "Original installed Quit thunk retained")
        (set! request-attempt attempt) (set! request-frame frame)
        (set! request-windows (get-top-level-windows))
        (next-wait! (format "quit-confirm-~a" attempt) 'quit-dialog)
        (set! request-evidence
              (hash-set* (envelope c stage) 'status "pre-dispatch"
                         'request_attempt request-attempt 'request_frame_id (id request-frame)
                         'activation request-activation))
        ;; Preserve the observed precondition even when no modal ever appears.
        (printf "OPENRACKET_QUIT_REQUEST ~a\n" (jsexpr->string (json-safe request-evidence)))
        (flush-output)
        ;; Public zero-argument getter only. No application handler is installed.
        ((application-quit-handler)))
      (define (command! kind label)
        (define prior active-dialog)
        (define evidence (dialog! kind))
        (assert! (and evidence (eq? active-dialog prior)) "Same screenshot-acknowledged shown modal")
        (define button (unique-control active-dialog button% label))
        (send button command (new control-event% [event-type 'button]))
        (assert! (not (send prior is-shown?)) "Original response callback dismissed its modal")
        (hash 'dialog_id (id prior) 'button_id (id button) 'label label
              'event "button" 'callback_returned #t 'modal_dismissed #t))
      (define (terminal! response)
        (set! stage "terminal-response")
        (define r (hash-set* (envelope c stage) 'status "response-dispatched" 'response response
                             'case (hash-ref c 'case) 'pid pid 'checks checks
                             'test_exit_used #f 'handler_replaced #f 'cleanup_used #f))
        (atomic-new! (control-path c stage "ready") r)
        (printf "OPENRACKET_QUIT_RESPONSE_DISPATCHED ~a\n" (jsexpr->string (json-safe r))) (flush-output)
        (set! phase 'await-native-exit)
        (send timer stop)
        ;; No explicit exit, frame closure or custodian shutdown: stock owns exit.
        (void))
      (define (after-capture!)
        (cond
          [(equal? stage "ready")
           (if (dirty?)
               (begin
                 (send defs insert (substring (hash-ref c 'edited_text)
                                              (string-length (hash-ref c 'original_text)))
                       (send defs last-position))
                 (publish! "dirty" (hash 'edit "appended bounded synthetic Unicode comment") #t))
               (request-quit! 1))]
          [(equal? stage "dirty") (request-quit! 1)]
          [(equal? stage "quit-confirm-1")
           (define response (command! 'quit (string-constant quit)))
           (if (dirty?) (next-wait! "unsaved-1" 'unsaved-dialog) (terminal! response))]
          [(equal? stage "unsaved-1")
           (command! 'unsaved (string-constant cancel))
           (set! cancel-since #f) (set! cancel-turns 0)
           (next-wait! "cancelled" 'cancelled)]
          [(equal? stage "cancelled") (request-quit! 2)]
          [(equal? stage "quit-confirm-2")
           (command! 'quit (string-constant quit))
           (next-wait! "unsaved-2" 'unsaved-dialog)]
          [(equal? stage "unsaved-2")
           (terminal! (command! 'unsaved (if (equal? (hash-ref c 'case) "save")
                                           (string-constant save) (string-constant dont-save))))]
          [else (error 'native-quit-driver "Unexpected capture stage")]))
      (define (startup!)
        (assert! (null? (shown-dialogs)) "Unexpected startup dialog is not dismissed")
        (define fs (filter (lambda (w) (is-a? w (drracket:get/extend:get-unit-frame))) (get-top-level-windows)))
        (when (pair? fs)
          (assert! (= (length fs) 1) "Exactly one original startup frame")
          (define f (car fs))
          (define d (send f get-definitions-text))
          (when (and (send f is-shown?) (send d get-filename)
                     (equal? (canonical (send d get-filename)) (canonical (hash-ref c 'fixture_path)))
                     (equal? (send d get-text) (hash-ref c 'original_text)) (not (send d is-modified?)))
            (set! frame f) (set! defs d) (set! ints (send f get-interactions-text))
            (set! tab (send f get-current-tab)) (set! dc (send f get-definitions-canvas))
            (set! ic (send f get-interactions-canvas))
            (unless focused? (send frame show #t) (send dc focus) (set! focused? #t))
            (define activation (observe-activation!))
            (when (activation-ready? activation)
              (gui!) (check-profile!)
              (set! quit-handler (application-quit-handler))
              (assert! (and (procedure? quit-handler) (procedure-arity-includes? quit-handler 0)
                            (not (eq? quit-handler void))) "Real installed application Quit thunk")
              (set! source-reports (sources!))
              (define es (send frame get-eventspace))
              (set! identity-reader ((dynamic-require identity-path 'make-cocoa-identity-reader)
                                     (lambda () (eq? (current-thread) (eventspace-handler-thread es)))))
              (set! mode-report (mode-evidence!))
              (publish! "ready" (hash 'fixture_opened_by_driver #f 'fixture_mutated #f
                                      'activation activation) #f)))))
      (define (tick)
        (with-handlers ([(lambda (_) #t) (lambda (e) (fail! (if (exn? e) (exn-message e) e)))])
          (assert! (< (current-inexact-monotonic-milliseconds) stage-deadline)
                   (format "Frozen deadline for ~a/~a" phase stage))
          (case phase
            [(startup) (startup!)]
            [(quit-dialog)
             (define e (dialog! 'quit)) (when e (publish! stage e (dirty?)))]
            [(unsaved-dialog)
             (define e (dialog! 'unsaved)) (when e (publish! stage e #t))]
            [(capture)
             (define p (control-path c stage "ack"))
             (when (file-exists? p)
               (assert! (ack-valid? (read-json-file p) c stage) "Exact screenshot ACK envelope")
               (after-capture!))]
            [(cancelled)
             (assert! (null? (shown-dialogs)) "No unexpected modal after Cancel")
             (host! #t) (identity!)
             (define focus-returned? (and (eq? (get-top-level-focus-window) frame)
                                          (eq? (get-top-level-edit-target-window) frame)))
             (unless focus-returned? (set! cancel-since #f) (set! cancel-turns 0))
             (when (and (not (exit:exiting?)) focus-returned?)
               (unless cancel-since (set! cancel-since (current-inexact-monotonic-milliseconds)))
               (set! cancel-turns (add1 cancel-turns))
               (when (and (>= cancel-turns 3)
                          (>= (- (current-inexact-monotonic-milliseconds) cancel-since) 1000))
                 (publish! "cancelled" (hash 'responsive_gui_turns cancel-turns 'stable_ms
                                            (- (current-inexact-monotonic-milliseconds) cancel-since)
                                            'focus_restored #t 'focus_frame_id (id frame) 'edit_target_frame_id (id frame)
                                            'exit_state_reset #t 'live_identity_preserved #t) #t)))]
            [else (error 'native-quit-driver "Unexpected timer state")])))
      (with-handlers ([(lambda (_) #t) (lambda (e) (fail! (if (exn? e) (exn-message e) e)))])
        (set! c (validate-config (read-json-file config-path)))
        (assert! (and (equal? (version) "9.3") (eq? (system-type) 'macosx)) "Native official 9.3 only")
        (assert! (null? (directory-list (hash-ref c 'output_dir))) "Fresh empty evidence directory")
        (set! timer (new timer% [notify-callback tick] [interval 100]))))))
