#lang racket/base
;; Headless data/capability tests with fake source modules. No actual expansion/GUI.
(require rackunit racket/file racket/path racket/place racket/serialize racket/vector json
         "support.rkt")
(define temp (make-temporary-file "replay-support-test-~a" 'directory))
(define fake-private (build-path temp "collects" "drracket" "private"))
(make-directory* fake-private)
(for ([name '("expanding-place.rkt" "module-language.rkt" "test-handler.rkt")])
  (call-with-output-file (build-path fake-private name)
    (lambda (out) (display "#lang racket/base\n(provide go monitor)\n(define go void)\n(define monitor void)\n" out))))
(define capture-dir (build-path temp "capture"))
(define expected-snapshot "#lang racket/base\n; actual edited x λ snapshot\n")
(define settings (make-prefab-struct 'prefab-module-settings #() '(default) #t #t 'none #t))
(define-values (response-in response-out) (place-channel))
(define-values (status-in status-out) (place-channel))
(define actual (vector-immutable expected-snapshot (build-path temp "source.rkt")
                                  response-in settings status-in (list (build-path temp "source.rkt"))))
(define actual-registry (list (list (build-path fake-private "test-handler.rkt") 'go #f)
                             (list (build-path fake-private "test-handler.rkt") 'monitor #t)))
(putenv "OPENRACKET_EXPANSION_CAPTURE" "1")
(environment-variables-set! (current-environment-variables) #"OPENRACKET_EXPANSION_REPLAY" #f)
(putenv "OPENRACKET_CAPTURE_OUTPUT" (path->string capture-dir))
(putenv "OPENRACKET_CAPTURE_EXPECTED_SHA256" (digest (string->bytes/utf-8 expected-snapshot)))
(parameterize ([current-library-collection-paths
                (cons (build-path temp "collects") (current-library-collection-paths))])
  (capture-registry! actual-registry)
  (define mismatch (vector-copy actual))
  (vector-set! mismatch 0 "not the selected edited snapshot")
  (check-false (capture-request! mismatch 134217728))
  (define first-id (capture-request! actual 134217728))
  (check-equal? first-id 2)
  (check-eq? (vector-ref actual 0) expected-snapshot)
  (check-eq? (vector-ref actual 2) response-in)
  (check-eq? (vector-ref actual 4) status-in)
  ;; A same-snapshot replacement must not leave capture waiting on a killed old
  ;; pending thread. Keep each attempt immutable and pair only the newest id.
  (define id (capture-request! actual 134217728))
  (check-equal? id 3)
  (capture-result! first-id (vector 'handler-results '() '() #f))
  (check-false (capture-complete?))
  (define captured (load-capture (build-path capture-dir "capture.rktd")))
  (check-equal? (hash-ref captured 'snapshot) expected-snapshot)
  (check-equal? (hash-ref captured 'registry) actual-registry)
  (check-equal? (hash-ref captured 'settings) settings)
  (check-equal? (hash-ref captured 'open-files) (vector-ref actual 5))
  (check-equal? (validate-capture! captured) captured)
  (check-exn exn:fail? (lambda () (validate-capture! (hash-set captured 'snapshot "corrupted") #:runtime? #f)))
  (check-exn exn:fail? (lambda () (validate-capture! (hash-set captured 'registry (reverse actual-registry)) #:runtime? #f)))
  (check-exn exn:fail? (lambda () (validate-capture! (hash-set captured 'child-limit 268435456) #:runtime? #f)))
  (check-exn exn:fail? (lambda () (validate-capture! (hash-set captured 'settings
      (make-prefab-struct 'prefab-module-settings #() '(default) #t #t 'debug #t)) #:runtime? #f)))
  (capture-status! id 'finished-expansion)
  (check-false (capture-complete?))
  (capture-result! id (vector 'monitor-message (car actual-registry) response-out))
  (check-false (capture-complete?))
  (capture-result! id (vector 'abnormal-termination "Expansion thread terminated unexpectedly (out of memory)" '() '()))
  (check-true (capture-complete?))
  (define summary (call-with-input-file (build-path capture-dir "capture-summary.json") read-json))
  (check-equal? (hash-ref summary 'monitor_messages) 1)
  (check-equal? (hash-ref (hash-ref summary 'terminal) 'tag) "abnormal-termination")
  (check-true (hash-ref (hash-ref summary 'terminal) 'explicit_out_of_memory))
  (check-equal? (hash-ref summary 'statuses) '("finished-expansion"))
  (check-exn exn:fail? (lambda () (capture-registry! actual-registry)))
  (putenv "OPENRACKET_EXPANSION_REPLAY" "1")
  (check-exn exn:fail? (lambda () (capture-request! actual 134217728))))

(check-false (captured-terminal? (vector 'monitor-message 'key response-out)))
(check-true (captured-terminal? (vector 'handler-results '() '() #f)))
(check-equal? (hash-ref (summarize-result (vector 'handler-results '() '() #f)) 'tag) "handler-results")
(check-true (hash-ref (summarize-result (vector 'exn (make-string 9000 #\x) '())) 'exception_details_truncated))
(define-values (gc-snapshot gc-stop) (make-gc-observer (current-logger)))
(check-true (hash-has-key? (gc-snapshot) 'monotonic_ms))
(check-not-false (gc-stop))

;; Preference restoration is confined to a marked, disposable profile and is
;; byte-identical, with the post-exit file retained as a backup.
(define profile (build-path temp "disposable-profile"))
(make-directory* profile)
(call-with-output-file (build-path profile "openracket-diagnostic-profile")
  (lambda (out) (display "openracket-expansion-diagnostic-profile\n" out)))
(define pref (build-path profile "prefs.rktd"))
(define backup-output (build-path temp "restore-output"))
(make-directory* backup-output)
(define captured-bytes #"captured preference bytes")
(call-with-output-file pref (lambda (out) (display "later preference bytes" out)))
(putenv "PLTUSERHOME" (path->string profile))
(define preference-record
  (hasheq 'preferences-bytes captured-bytes
          'context (hasheq 'preferences-path pref 'preferences-sha256 (digest captured-bytes)
                           'environment (hasheq 'PLTUSERHOME (path->string profile)))))
(check-true (hash-ref (restore-disposable-preferences! preference-record backup-output) 'restored))
(check-equal? (file->bytes pref) captured-bytes)
(check-equal? (file->bytes (build-path backup-output "preferences-after-capture.rktd")) #"later preference bytes")
(check-false (hash-ref (restore-disposable-preferences! preference-record backup-output) 'restored))
(define outside (build-path temp "outside-prefs.rktd"))
(call-with-output-file outside (lambda (out) (display "untouched" out)))
(define outside-record
  (hash-set preference-record 'context
            (hash-set (hash-ref preference-record 'context) 'preferences-path outside)))
(check-exn exn:fail? (lambda () (restore-disposable-preferences! outside-record backup-output)))
(check-equal? (file->bytes outside) #"untouched")
(delete-directory/files temp)
(displayln "Headless support tests passed; no stock worker or native GUI executed.")
