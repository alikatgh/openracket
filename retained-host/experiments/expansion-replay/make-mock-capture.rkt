#lang racket/base
;; TEST DOUBLE ONLY. Creates protocol fixtures, never a claimed native capture.
(require racket/file racket/path racket/runtime-path racket/serialize json "support.rkt")
(define-runtime-path worker "mock-worker.rkt")
(define-runtime-path caller "make-mock-capture.rkt")
(define-runtime-path support "support.rkt")
(define output (path->complete-path (vector-ref (current-command-line-arguments) 0)))
(make-directory* output)
(define snapshot "#lang racket/base\n; protocol test x\n")
(define (serialized-bytes value)
  (define out (open-output-bytes)) (write (serialize value) out) (get-output-bytes out))
(define registry '())
(define context (runtime-context))
(define pref (hash-ref context 'preferences-path))
(define record
  (hasheq 'schema-version 1 'request-id 1 'snapshot snapshot 'source (build-path output "test-source.rkt")
          'settings (make-prefab-struct 'prefab-module-settings #() '(default) #t #t 'none #t)
          'open-files '() 'snapshot-sha256 (digest (string->bytes/utf-8 snapshot))
          'snapshot-kind 'string 'snapshot-bytes (bytes-length (string->bytes/utf-8 snapshot))
          'snapshot-characters (string-length snapshot)
          'registry registry 'registry-files '() 'registry-sha256 (digest (serialized-bytes registry))
          'context context 'preferences-bytes (and (file-exists? pref) (file->bytes pref))
          'child-limit 134217728 'worker-path worker 'worker-sha256 (file-hash worker)
          'caller-path caller 'caller-sha256 (file-hash caller)
          'support-path support 'support-sha256 (file-hash support)))
(write-datum-atomic (build-path output "capture.rktd") record)
(call-with-output-file (build-path output "capture.launch.json")
  (lambda (out) (write-json (hasheq 'environment (hash-ref context 'environment)
                                   'cwd (path->string (current-directory))
                                   'snapshot_sha256 (hash-ref record 'snapshot-sha256)
                                   'registry_sha256 (hash-ref record 'registry-sha256)) out)))
(call-with-output-file (build-path output "capture-summary.json")
  (lambda (out) (write-json (hasheq 'status "terminal_observed"
                                   'test_double #t
                                   'terminal (summarize-result (vector 'handler-results '() '() #f))) out)))
