#lang racket/base
;; Read-only scalar snapshots of the actual definitions editor's style list.
;; Never call find-named-style, prewarm, yield, mutate an editor, or log from here.
(require racket/class racket/list)
(provide make-style-witness style-snapshot! style-witness-summary finish-style-witness!)
(struct witness (editor arm reader identities rows verified) #:mutable)
(define bool-fields '(enabled cache-valid))
(define count-fields '(lookups hits rebuilds members-traversed named-entries member-count))
(define labels '("before-open" "after-open" "ordinary-ready" "post-join" "final"))
(define (make-style-witness editor arm reader)
  (unless (and (member arm '("stock" "candidate"))
               (if (equal? arm "stock") (not reader)
                   (and (procedure? reader) (procedure-arity-includes? reader 1))))
    (error 'style-witness "Invalid arm/state-reader contract"))
  (witness editor arm reader (make-hasheq) '() #f))
(define (checked-state reader actual)
  (define s (reader actual))
  (unless (and (hash? s) (immutable? s)
               (equal? (sort (hash-keys s) symbol<?) (sort (append bool-fields count-fields) symbol<?))
               (for/and ([key (in-list bool-fields)]) (boolean? (hash-ref s key)))
               (for/and ([key (in-list count-fields)]) (exact-nonnegative-integer? (hash-ref s key)))
               (eq? (hash-ref s 'enabled) #t))
    (error 'style-witness "Malformed or disabled immutable named-style scalar state"))
  s)
(define (style-snapshot! w label)
  (unless (and (< (length (witness-rows w)) (length labels))
               (equal? label (list-ref labels (length (witness-rows w)))))
    (error 'style-witness "Missing, duplicate or out-of-order snapshot"))
  (define actual (send (witness-editor w) get-style-list))
  (define ids (witness-identities w))
  (define id (hash-ref! ids actual (lambda () (add1 (hash-count ids)))))
  (define s (if (witness-reader w) (checked-state (witness-reader w) actual) 'null))
  (define row (hasheq 'label label 'style_list_identity id
                      'actual_definitions_editor #t 'monotonic_ms (current-inexact-monotonic-milliseconds)
                      'state s))
  (set-witness-rows! w (append (witness-rows w) (list row)))
  row)
(define (style-witness-summary w)
  (hasheq 'schema_version 1 'kind "actual-editor-named-style-counters" 'arm (witness-arm w)
          'verified (witness-verified w) 'snapshots (witness-rows w)
          'diagnostic_counters_synchronized #f 'synthetic_lookup_performed #f
          'scope "Actual editor style-list scalar endpoints; counters are diagnostic, not synchronized accounting"))
(define (finish-style-witness! w)
  (define rows (witness-rows w))
  (unless (= (length rows) (length labels)) (error 'style-witness "Incomplete style snapshots"))
  (define ids (map (lambda (r) (hash-ref r 'style_list_identity)) rows))
  (unless (apply = (cdr ids)) (error 'style-witness "Style list changed after post-open checkpoint"))
  (define start (if (= (car ids) (cadr ids)) (car rows) (cadr rows)))
  (define ready (list-ref rows 2))
  (when (equal? (witness-arm w) "candidate")
    (define before (hash-ref start 'state))
    (define after (hash-ref ready 'state))
    ;; No hits<=lookups, rebuild arithmetic, cross-counter equality, or general
    ;; monotonicity invariant is asserted for unsynchronized diagnostics.
    (unless (and (> (hash-ref after 'lookups) (hash-ref before 'lookups))
                 (> (hash-ref after 'hits) (hash-ref before 'hits)))
      (error 'style-witness "No real workload lookup/hit increase on the same actual style list")))
  (set-witness-verified! w #t)
  (hash-set* (style-witness-summary w)
             'workload_baseline (hash-ref start 'label)
             'style_list_replaced_on_open (not (= (car ids) (cadr ids)))))
(module+ test-support (provide checked-state))
