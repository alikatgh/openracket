#lang racket/base
(require rackunit racket/class racket/file racket/path
         "gui-observer.rkt" (submod "activation.rkt" test-support))
(current-check-handler raise)
(define root (make-temporary-file "activation-test~a" 'directory))
(define serial 0)
(define (fixture body [gui-body #f])
  (set! serial (add1 serial))
  (define style (build-path root (format "style~a.rkt" serial)))
  (define gui (build-path root (format "gui~a.rkt" serial)))
  (call-with-output-file style
    (lambda (out) (display (string-append "#lang racket/base\n(require racket/class)\n(provide style-list%)\n(define style-list% (class object% (super-new) (define/public (probe) #t)))\n" body) out)))
  (call-with-output-file gui
    (lambda (out) (display (or gui-body (format "#lang racket/base\n(require (file ~s))\n(provide style-list%)\n" (path->string style))) out)))
  (values gui style (digest (file->bytes style))))
(define enabled-body "(provide openracket-named-style-index-enabled? openracket-named-style-index-state)\n(define openracket-named-style-index-enabled? #t)\n(define (openracket-named-style-index-state actual) (error 'test \"activation must not read state\"))\n")
(define (clean thunk)
  (define e (environment-variables-copy (current-environment-variables)))
  (for ([key (in-list (environment-variables-names e))] #:when (regexp-match? #rx#"^OPENRACKET_" key))
    (environment-variables-set! e key #f))
  (parameterize ([current-environment-variables e]) (thunk)))
(define (check-case body arm flag expected-status expected-reader enabled verified?)
  (define-values (gui style sha) (fixture body))
  (clean
   (lambda ()
     (when flag (putenv "OPENRACKET_NAMED_STYLE_INDEX" flag))
     (dynamic-require gui #f) ; ordinary loader, deliberately outside probe
     (define actual (new (dynamic-require gui 'style-list%)))
     (define (probe [pin sha] [source style] [runtime root])
       (existing-module-evidence gui style actual arm pin source runtime))
     (define record (probe))
     (check-equal? (hash-ref record 'verified) verified?)
     (check-equal? (hash-ref record 'export_status) expected-status)
     (check-equal? (hash-ref record 'state_export_status) expected-reader)
     (check-equal? (hash-ref record 'named_style_index_enabled) enabled)
     (check-true (hash-ref record 'same_gui_imported_style_instance))
     (check-false (hash-ref (probe (make-string 64 #\0)) 'verified))
     (check-exn exn:fail? (lambda () (probe sha (build-path root "wrong.rkt"))))
     (check-exn exn:fail? (lambda () (probe sha style (build-path root "foreign"))))
     (putenv "OPENRACKET_GUI_PHASE_POINTS" "1")
     (check-false (hash-ref (probe) 'verified)))))
(check-case "" "stock" #f "missing" "missing" 'null #t)
(check-case "" "stock" "0" "missing" "missing" 'null #f)
(check-case "" "candidate" "1" "missing" "missing" 'null #f)
(check-case enabled-body "candidate" "1" "boolean" "procedure" #t #t)
(check-case enabled-body "candidate" #f "boolean" "procedure" #t #f)
(check-case enabled-body "stock" #f "boolean" "procedure" #t #f)
(check-case (regexp-replace #rx"enabled[?] #t" enabled-body "enabled? #f") "candidate" "1" "boolean" "procedure" #f #f)
(check-case (regexp-replace #rx"enabled[?] #t" enabled-body "enabled? 42") "candidate" "1" "non-boolean" "procedure" 'null #f)
(check-case "(provide openracket-named-style-index-enabled?)\n(define openracket-named-style-index-enabled? #t)\n" "candidate" "1" "boolean" "missing" #t #f)
(define-values (not-loaded not-style not-sha) (fixture "(error 'test \"must not load\")"))
(check-exn exn:fail? (lambda () (existing-module-evidence not-loaded not-style (new object%) "stock" not-sha not-style root)))
(check-exn exn:fail? (lambda () (module->namespace not-loaded)))
(define-values (gui style sha) (fixture enabled-body))
(dynamic-require gui #f)
(define actual (new (dynamic-require gui 'style-list%)))
(clean
 (lambda ()
   (putenv "OPENRACKET_NAMED_STYLE_INDEX" "1")
   (for ([flag (in-list '("OPENRACKET_BINDING_TABLE_EAGER" "OPENRACKET_BINDING_TABLE_INDEX"
                          "OPENRACKET_INTERVAL_INDEX" "OPENRACKET_EXPANSION_REPLAY" "OPENRACKET_UNKNOWN"))])
     (putenv flag "0")
     (define row (existing-module-evidence gui style actual "candidate" sha style root))
     (check-false (hash-ref row 'verified))
     (check-equal? (hash-ref row 'unexpected_experiment_flags) (list flag))
     (environment-variables-set! (current-environment-variables) (string->bytes/utf-8 flag) #f))))
(parameterize ([current-namespace (make-base-namespace)])
  (check-exn exn:fail? (lambda () (existing-module-evidence gui style actual "candidate" sha style root))))
(check-exn exn:fail? (lambda () (existing-module-evidence gui style (new object%) "candidate" sha style root)))
(define-values (foreign-gui foreign-style foreign-sha)
  (fixture enabled-body "#lang racket/base\n(require racket/class)\n(provide style-list%)\n(define style-list% (class object% (super-new)))"))
(dynamic-require foreign-gui #f)
(dynamic-require foreign-style #f)
(check-exn exn:fail? (lambda () (existing-module-evidence foreign-gui foreign-style (new (dynamic-require foreign-gui 'style-list%)) "candidate" foreign-sha foreign-style root)))
(define-values (syntax-gui syntax-style syntax-sha)
  (fixture "(require (for-syntax racket/base))\n(provide openracket-named-style-index-enabled?)\n(define-syntax (openracket-named-style-index-enabled? stx) #'#t)"))
(dynamic-require syntax-gui #f)
(check-exn #rx"Activation export is syntax" (lambda () (existing-module-evidence syntax-gui syntax-style (new (dynamic-require syntax-gui 'style-list%)) "stock" syntax-sha syntax-style root)))
(define-values (wrapped-gui wrapped-style wrapped-sha) (fixture enabled-body))
(call-with-output-file wrapped-gui #:exists 'truncate/replace
  (lambda (out)
    (display (format "#lang racket/base\n(require racket/contract racket/class (prefix-in raw: (file ~s)))\n(provide style-list%)\n(define style-list% (contract (class/c [probe (->m boolean?)]) raw:style-list% 'provider 'client))\n"
                     (path->string wrapped-style)) out)))
(dynamic-require wrapped-gui #f)
(clean
 (lambda ()
   (putenv "OPENRACKET_NAMED_STYLE_INDEX" "1")
   ;; Mimic the editor creating an internal-class instance while the GUI exports
   ;; its contracted class. is-a? unwraps class-orig-cls; class eq? is not required.
   (define internal-instance (new (dynamic-require wrapped-style 'style-list%)))
   (check-true (hash-ref (existing-module-evidence wrapped-gui wrapped-style internal-instance
                             "candidate" wrapped-sha wrapped-style root) 'verified))))
(delete-file style)
(check-exn exn:fail? (lambda () (existing-module-evidence gui style actual "candidate" sha style root)))
(delete-directory/files root)
(displayln "OPENRACKET_NAMED_STYLE_ACTIVATION_TESTS_PASSED")
