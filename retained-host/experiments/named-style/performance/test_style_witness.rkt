#lang racket/base
(require rackunit racket/class "style-witness.rkt" (submod "style-witness.rkt" test-support))
(current-check-handler raise)
(define (state [n 0])
  (hasheq 'enabled #t 'cache-valid #t 'lookups n 'hits (+ n 10) 'rebuilds 2
          'members-traversed 55 'named-entries 3 'member-count 4))
(define editor% (class object% (super-new)
                  (define actual (new object%))
                  (define/public (get-style-list) actual)
                  (define/public (replace!) (set! actual (new object%)))))
(define (run arm #:replace-open? [replace-open? #f] #:replace-late? [replace-late? #f] #:activity? [activity? #t])
  (define editor (new editor%))
  (define n 100)
  (define reads 0)
  (define w (make-style-witness editor arm (and (equal? arm "candidate")
                      (lambda (actual)
                        (check-eq? actual (send editor get-style-list))
                        (set! reads (add1 reads)) (state n)))))
  (style-snapshot! w "before-open")
  (when replace-open? (send editor replace!))
  (style-snapshot! w "after-open")
  (when activity? (set! n 101))
  (style-snapshot! w "ordinary-ready")
  (when replace-late? (send editor replace!))
  (style-snapshot! w "post-join")
  (style-snapshot! w "final")
  (check-equal? reads (if (equal? arm "candidate") 5 0))
  (finish-style-witness! w))
(for ([arm (in-list '("stock" "candidate"))])
  (check-true (hash-ref (run arm) 'verified))
  (check-equal? (hash-ref (run arm) 'workload_baseline) "before-open")
  (check-equal? (hash-ref (run arm #:replace-open? #t) 'workload_baseline) "after-open")
  (check-true (hash-ref (run arm #:replace-open? #t) 'style_list_replaced_on_open))
  (check-exn exn:fail? (lambda () (run arm #:replace-late? #t))))
(check-exn #rx"No real workload" (lambda () (run "candidate" #:activity? #f)))
(for ([key (in-list (hash-keys (state)))])
  (for ([bad (in-list (list (hash-remove (state) key) (hash-set (state) key 'wrong)))])
    (check-exn exn:fail? (lambda () (checked-state (lambda (_) bad) (new object%))))))
(for ([bad (in-list (list (hash-copy (state)) (hash-set (state) 'enabled #f)
                          (hash-set (state) 'extra 1) (hash-set (state) 'lookups #t)
                          (hash-set (state) 'member-count -1)))])
  (check-exn exn:fail? (lambda () (checked-state (lambda (_) bad) (new object%)))))
(check-equal? (checked-state (lambda (_) (state)) (new object%)) (state))
(define partial (make-style-witness (new editor%) "candidate" (lambda (_) (state))))
(style-snapshot! partial "before-open")
(check-exn exn:fail? (lambda () (style-snapshot! partial "before-open")))
(check-exn exn:fail? (lambda () (finish-style-witness! partial)))
(check-equal? (length (hash-ref (style-witness-summary partial) 'snapshots)) 1)
(check-false (hash-ref (style-witness-summary partial) 'verified))
(displayln "OPENRACKET_STYLE_WITNESS_TESTS_PASSED")
