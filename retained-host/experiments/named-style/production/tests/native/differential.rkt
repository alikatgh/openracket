#lang racket/base
;; Full pinned style.rkt modules, not a hand-written reproduction of the method.
;; This file has been source-checked only until a native report says otherwise.
(require racket/class racket/list racket/cmdline racket/string json)
(define-values (stock-path candidate-path mode)
  (command-line #:args (stock candidate expected-mode)
                (values (string->path stock) (string->path candidate) expected-mode)))
(unless (equal? (version) "9.3") (error 'version "expected native Racket 9.3"))
(unless (member mode '("unset" "zero" "unexpected" "on")) (error 'mode "invalid mode"))
(define enabled? (equal? mode "on"))
(define checks 0)
(define (same a b why)
  (set! checks (add1 checks))
  (unless (equal? a b) (error 'named-style-differential "~a: ~s != ~s" why a b)))
(define (yes a why) (same (and a #t) #t why))
(define (identical a b why) (yes (eq? a b) why))
(define (load path export) (dynamic-require path export))
(define stock-list% (load stock-path 'style-list%))
(define candidate-list% (load candidate-path 'style-list%))
(define stock-delta% (load stock-path 'style-delta%))
(define candidate-delta% (load candidate-path 'style-delta%))
(define candidate-state (load candidate-path 'openracket-named-style-index-state))
(same (load candidate-path 'openracket-named-style-index-enabled?) enabled? "module activation")

(define (exception f)
  (with-handlers ([exn? (lambda (e)
                         (list (if (exn:fail:contract? e) "contract" "exception")
                               (exn-message e)))])
    (f)
    (list "returned")))

(define (scenario list% delta%)
  (define ids (make-hasheq))
  (define (id s)
    (and s (hash-ref! ids s (lambda () (add1 (hash-count ids))))))
  (define events null)
  (define (note tag value) (set! events (cons (list tag value) events)))
  (define (json-value v) (if (symbol? v) (symbol->string v) v))
  (define (delta-view s)
    (define d (new delta%))
    (send s get-delta d)
    (append
     (for/list ([method '(get-family get-face get-size-mult get-size-add
                        get-weight-on get-weight-off get-style-on get-style-off
                        get-smoothing-on get-smoothing-off get-underlined-on get-underlined-off
                        get-size-in-pixels-on get-size-in-pixels-off
                        get-transparent-text-backing-on get-transparent-text-backing-off
                        get-alignment-on get-alignment-off)])
       (json-value (dynamic-send d method)))
     (for/list ([method '(get-foreground-mult get-background-mult
                        get-foreground-add get-background-add)])
       (define c (dynamic-send d method))
       (list (send c get-r) (send c get-g) (send c get-b) (send c get-a)))))
  (define (view sl)
    (for/list ([i (in-range (send sl number))])
      (define s (send sl index-to-style i))
      (list i (id s) (send s get-name) (id (send s get-base-style))
            (and (send s is-join?) (id (send s get-shift-style)))
            (send sl style-to-index s) (delta-view s))))
  (define (oracle sl name)
    ;; index-to-style runs in the reverse of the private members-list order.
    (for/or ([i (in-range (sub1 (send sl number)) -1 -1)])
      (define s (send sl index-to-style i))
      (and (equal? name (send s get-name)) s)))
  (define (lookup sl name)
    (define result (send sl find-named-style name))
    (identical result (oracle sl name) "lookup returns exact first object in members order")
    (id result))
  (define (plain sl size)
    (define d (new delta%))
    (send d set-delta 'change-size size)
    (send sl find-or-create-style (send sl basic-style) d))

  (define sl (new list%))
  (define basic (send sl basic-style))
  (id basic)
  (identical (send sl find-named-style "Basic") basic "Basic identity")
  (same (send sl find-named-style "basic") #f "case-sensitive name")
  (same (send sl find-named-style "missing") #f "missing name")
  (note "contracts"
        (for/list ([bad (list #f 0 'Basic #"Basic" null (new object%))])
          (define result (exception (lambda () (send sl find-named-style bad))))
          (same (car result) "contract" "wrong type still raises contract")
          result))
  (define p (plain sl 17))
  (id p)
  (for ([name (in-list (list "" "λ" "名🎨" "Case" "case" "é" "é"))])
    (define s (send sl new-named-style name p))
    (identical (send sl find-named-style name) s "empty/Unicode exact lookup")
    (id s))
  (define mutable-name (string-copy "mutable"))
  (define mutable-style (send sl new-named-style mutable-name p))
  (id mutable-style)
  (string-set! mutable-name 0 #\M)
  (same (send sl find-named-style mutable-name) #f "caller name mutation does not rename stored style")
  (string-set! mutable-name 0 #\m)
  (identical (send sl find-named-style mutable-name) mutable-style "mutable query exact string lookup")
  (string-set! mutable-name 0 #\M)
  (same (send sl find-named-style mutable-name) #f "query is not retained as a cache key")
  (same (send mutable-style get-name) "mutable" "stored immutable name")
  (yes (immutable? (send mutable-style get-name)) "published name immutable")
  (for ([size (in-range 20 55)])
    (plain sl size)
    (lookup sl "mutable")
    (lookup sl "missing"))
  (define n (send sl number))
  (identical (send sl new-named-style "mutable" basic) mutable-style "existing create identity")
  (same (send sl number) n "existing create does not add member")
  (define replacement (plain sl 66))
  (identical (send sl replace-named-style "mutable" replacement) mutable-style "replace preserves identity")
  (identical (send sl replace-named-style "Basic" replacement) basic "Basic cannot be replaced")
  (lookup sl "mutable")
  (note "ordinary-state" (view sl))

  (define other (new list%))
  (define imported (send other convert mutable-style))
  (identical (send other convert mutable-style) imported "convert reuses named member")
  (identical (send other find-named-style "mutable") imported "convert lookup identity")
  (send other copy sl)
  (for ([name '("Basic" "mutable" "" "λ" "missing")]) (lookup other name))
  (note "copy-convert" (view other))

  ;; Existing public dispatch remains virtual; the internal naming scan must not
  ;; become a new find-named-style override call. An ordinary method with the
  ;; diagnostic spelling does not collide with the candidate's local key.
  (define calls 0)
  (define subclass%
    (class list%
      (super-new)
      (define/override (find-named-style name)
        (set! calls (add1 calls))
        (super find-named-style name))
      (define/public (get-openracket-named-style-index-state) 'user-method)))
  (define sub (new subclass%))
  (send sub new-named-style "mutable" (send sub basic-style))
  (same calls 0 "do-named-style does not dispatch through overridden lookup")
  (send sub new-named-style "mutable" (send sub basic-style))
  (same calls 0 "existing naming retains private linear scan")
  (send sub convert mutable-style)
  (yes (> calls 0) "convert retains its original virtual lookup")
  (same (send sub get-openracket-named-style-index-state) 'user-method "no diagnostic method collision")
  (note "subclass-calls" calls)

  ;; Reentry before add-member creates two same-name objects. A single callback
  ;; makes the complete callback trace deterministic rather than relying on
  ;; weak-hash enumeration order between unrelated callback procedures.
  (define dup (new list%))
  (define dup-basic (send dup basic-style))
  (id dup-basic)
  (define inner #f)
  (define entered? #f)
  (define dup-events null)
  (define notification
    (send dup notify-on-change
          (lambda (which)
            (set! dup-events
                  (cons (list (id which) (lookup dup "duplicate") (view dup)) dup-events))
            (when (and which (not entered?))
              (set! entered? #t)
              (set! inner (send dup new-named-style "duplicate" dup-basic))
              (set! dup-events (cons (list "inner-return" (id inner) (lookup dup "duplicate")) dup-events))))))
  (define outer (send dup new-named-style "duplicate" dup-basic))
  (send dup forget-notification notification)
  (yes (and inner (not (eq? inner outer))) "reentrant naming genuinely creates distinct duplicates")
  (same (send dup number) 3 "both duplicates are present")
  (identical (send dup find-named-style "duplicate") outer "outer prepended style wins initially")
  (note "duplicate-notifications" (reverse dup-events))
  (note "duplicate-before-reorder" (view dup))
  ;; The official source mutates members before its get-s-join-style error. This
  ;; test records and compares both the actual exception and partial new state.
  (define reorder (exception (lambda () (send inner set-base-style outer))))
  (note "duplicate-base-reorder-result" reorder)
  (note "duplicate-after-reorder" (view dup))
  (identical (send dup find-named-style "duplicate") inner "first-in-members duplicate winner changes after reorder")
  (yes (not (equal? (car reorder) "returned")) "pinned reorder typo remains an exception")
  (yes (regexp-match? #rx"get-s-join-style" (cadr reorder)) "exact stock typo not silently repaired")

  ;; Exercise actual shift reordering through a join style. The callback/error
  ;; boundary must preserve the same partially reordered style indices.
  (define shifts (new list%))
  (define shift-base (send shifts basic-style))
  (define early (send shifts find-or-create-join-style shift-base shift-base))
  (define late (send shifts new-named-style "late-shift" shift-base))
  (lookup shifts "late-shift")
  (note "shift-reorder-result" (exception (lambda () (send early set-shift-style late))))
  (lookup shifts "late-shift")
  (note "shift-after-reorder" (view shifts))

  ;; Nested batching keeps all stock notifications and membership boundaries.
  (define batched (new list%))
  (define batch-events null)
  (define batch-key
    (send batched notify-on-change
          (lambda (which)
            (set! batch-events (cons (list (and which (send which get-name))
                                          (lookup batched "batched")) batch-events)))))
  (send batched begin-style-change-sequence)
  (send batched begin-style-change-sequence)
  (send batched new-named-style "batched" (send batched basic-style))
  (same batch-events null "nested batching has no premature callback")
  (send batched end-style-change-sequence)
  (same batch-events null "inner batch end has no premature callback")
  (send batched end-style-change-sequence)
  (note "batched-notifications" (reverse batch-events))
  (send batched forget-notification batch-key)

  ;; A failing pre-insertion notification leaves the new name absent.
  (define failed (new list%))
  (lookup failed "aborted")
  (define bad-key (send failed notify-on-change (lambda (s) (error 'notify "intentional abort"))))
  (note "notification-error" (exception (lambda () (send failed new-named-style "aborted" (send failed basic-style)))))
  (same (send failed number) 1 "failed notification does not insert")
  (same (send failed find-named-style "aborted") #f "failed notification does not publish a name")
  (send failed forget-notification bad-key)
  ;; Callback removing itself exercises the stock hash-has-key? guard without
  ;; making the differential test depend on callback iteration order.
  (define self-events 0)
  (define self-key #f)
  (set! self-key (send failed notify-on-change
                       (lambda (s) (set! self-events (add1 self-events))
                         (send failed forget-notification self-key))))
  (send failed new-named-style "after-abort" (send failed basic-style))
  (same self-events 1 "self-removing callback called only once")
  (note "after-abort" (view failed))
  (reverse events))

(define stock-result (scenario stock-list% stock-delta%))
(define candidate-result (scenario candidate-list% candidate-delta%))
(same candidate-result stock-result "complete observable state and notification/exception trace")

;; Diagnostic checks use the candidate's genuine class instance, not a second
;; independently loaded module in place of the instance under examination.
(define witnessed (new candidate-list%))
(define initial (candidate-state witnessed))
(same initial (candidate-state witnessed) "read-only diagnostic accessor")
(yes (immutable? initial) "immutable diagnostic snapshot")
(same (hash-ref initial 'lookups) 0 "no diagnostic prewarm")
(same (hash-ref initial 'rebuilds) 0 "no diagnostic rebuild")
(same (hash-ref initial 'cache-valid) #f "unbuilt initial cache")
(send witnessed find-named-style "Basic")
(send witnessed find-named-style "missing")
(send witnessed find-named-style (string-copy "Basic"))
(define used (candidate-state witnessed))
(same (hash-ref used 'lookups) (if enabled? 3 0) "actual lookup count")
(same (hash-ref used 'hits) (if enabled? 2 0) "actual cache hit count including absent query")
(same (hash-ref used 'rebuilds) (if enabled? 1 0) "cold completed cache publication")
(same (hash-ref used 'members-traversed) (if enabled? 1 0) "cold traversal visible")
(same (hash-ref used 'named-entries) (if enabled? 1 0) "Basic is included in the index")
(send witnessed new-named-style "new" (send witnessed basic-style))
(same (hash-ref (candidate-state witnessed) 'cache-valid) #f "membership invalidates by identity without mutator hook")
(send witnessed find-named-style "new")
(define rebuilt (candidate-state witnessed))
(same (hash-ref rebuilt 'rebuilds) (if enabled? 2 0) "insertion rebuild recorded")
(same (hash-ref rebuilt 'members-traversed) (if enabled? 3 0) "full cold rebuild traversal counted")
(define stable (candidate-state witnessed))
(same stable (candidate-state witnessed) "state inspection never changes counters")
(same (car (exception (lambda () (candidate-state #f)))) "contract" "diagnostics type guard")
;; A future negative-control run must fail nonzero before emitting success JSON.
;; Every assertion uses an uncaught error, avoiding a nonfatal check handler.
(when (equal? (getenv "OPENRACKET_NAMED_STYLE_TEST_WRONG_IDENTITY") "1")
  (displayln "OPENRACKET_NAMED_STYLE_NEGATIVE_CONTROL_INJECTED_V1" (current-error-port))
  (flush-output (current-error-port))
  (identical witnessed (new candidate-list%) "negative-control-wrong-object-identity"))
(write-json (hasheq 'schema "openracket-named-style-native-v1" 'mode mode
                    'passed #t 'checks checks 'scenario-count (length stock-result)
                    'diagnostics rebuilt 'observations candidate-result))
(newline)
