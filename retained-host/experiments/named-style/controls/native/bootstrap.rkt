#lang racket/base
;; Test-only source/activation wrapper. The accepted host and workflows are intact.
(require json racket/file racket/path racket/runtime-path syntax/modresolve)
(define-runtime-path host "tests/reference-host-0520.rkt")
(define-runtime-path pins-path "../RUNTIME-PINS.json")
(define-runtime-path provenance-path "../PROVENANCE.json")
(define-runtime-path package-root "..")
(define args (current-command-line-arguments))
(unless (= (vector-length args) 2) (error 'named-style-control "Expected mode and runtime root"))
(define mode (vector-ref args 0))
(unless (member mode '("stock" "candidate-off" "candidate-on"))
  (error 'named-style-control "Unknown mode"))
(define root (simplify-path (path->complete-path (vector-ref args 1)) #t))
(define stock? (equal? mode "stock"))
(define enabled? (equal? mode "candidate-on"))
(define flag (getenv "OPENRACKET_NAMED_STYLE_INDEX"))
(unless (and (equal? (version) "9.3")
             (equal? flag (cond [stock? #f] [enabled? "1"] [else "0"]))
             (equal? (getenv "OPENRACKET_NATIVE_CASE") "check-syntax")
             (equal? (getenv "OPENRACKET_UI") "stock"))
  (error 'named-style-control "Expected 9.3, exact mode environment, stock UI and Check Syntax"))
(define allowed '(#"OPENRACKET_NAMED_STYLE_INDEX" #"OPENRACKET_NATIVE_CASE" #"OPENRACKET_UI"
                  #"OPENRACKET_READY_FILE" #"OPENRACKET_CAPTURE_DONE"))
(for ([key (in-list (environment-variables-names (current-environment-variables)))])
  (when (and (regexp-match? #rx#"^OPENRACKET_" key) (not (member key allowed)))
    (error 'named-style-control "Unrelated experiment environment: ~a" key)))
(define (digest path)
  (apply string-append
         (for/list ([byte (in-bytes (sha256-bytes (file->bytes path)))])
           (define str (number->string byte 16))
           (if (= (string-length str) 1) (string-append "0" str) str))))
(define (descendant! path parent)
  (define actual (simplify-path (path->complete-path path) #t))
  (define rel (find-relative-path (simplify-path parent #t) actual))
  (unless (and (file-exists? actual) (relative-path? rel)
               (not (member 'up (explode-path rel)))
               (not (equal? actual parent)) (not (link-exists? path)))
    (error 'named-style-control "Not an actual file within the selected root: ~a" path))
  actual)
(unless (and (directory-exists? root) (not (equal? root (string->path "/"))))
  (error 'named-style-control "Explicit disposable runtime root required"))
(define executable
  (descendant! (find-executable-path (find-system-path 'exec-file)) root))
(define provenance (call-with-input-file provenance-path read-json))
(for ([(name pin) (in-hash (hash-ref provenance 'unchanged_copies))])
  (define path (descendant! (build-path package-root (symbol->string name)) package-root))
  (unless (equal? (digest path) pin)
    (error 'named-style-control "Copied host/dependency changed: ~a" name)))
(define pins (call-with-input-file pins-path read-json))
(define sources
  (for/hasheq ([(module pin) (in-hash pins)])
    (define source (descendant! (resolve-module-path module #f) root))
    (define expected (if (hash? pin) (hash-ref pin (if stock? 'stock 'candidate)) pin))
    (define actual (digest source))
    (unless (equal? actual expected)
      (error 'named-style-control "Runtime source mismatch for ~a: ~a" module actual))
    (values module (hasheq 'path (path->string source) 'sha256 actual))))
;; Source-first only for the changed module; shared identity is retained when the
;; unchanged host imports GUI. No lookup, style construction, cache warming or observer.
(define style-module 'racket/snip/private/style)
(parameterize ([use-compiled-file-paths '()]) (dynamic-require style-module #f))
(define style-resolved (make-resolved-module-path (resolve-module-path style-module #f)))
(unless (= (namespace-base-phase (module->namespace style-resolved)) 0)
  (error 'named-style-control "Style module is not instantiated at phase zero"))
(define missing (gensym 'missing-export))
(define enabled (dynamic-require style-resolved 'openracket-named-style-index-enabled? (lambda () missing)))
(define state (dynamic-require style-resolved 'openracket-named-style-index-state (lambda () missing)))
(unless (if stock?
            (and (eq? enabled missing) (eq? state missing))
            (and (boolean? enabled) (eq? enabled enabled?)
                 (procedure? state) (procedure-arity-includes? state 1)))
  (error 'named-style-control "Actual style activation/export mismatch"))
(display "OPENRACKET_NAMED_STYLE_CONTROL_SOURCE ")
(write-json
 (hasheq 'schema "openracket-named-style-control-source/v1" 'mode mode
         'version (version) 'runtime_root (path->string root) 'executable (path->string executable)
         'flag (or flag 'null) 'activation (if stock? "unexported" enabled)
         'state_export (if stock? "unexported" "present") 'source_first_load #t
         'sources sources 'host_sha256 (digest host)))
(newline) (flush-output)
;; The host owns READY, capture wait, all GUI actions, cleanup and process exit.
(dynamic-require host #f)
