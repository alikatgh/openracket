#lang racket/base
;; Public API snapshots. Arrays are ordered; references are exact per-list
;; indices, preserving aliasing and base/shift edges without process addresses.
(require racket/class racket/gui/base racket/list)
(provide editor-view style-view snips position-style check! same! json-scalar)
(define (check! v why) (unless v (error 'editor-gate "~a" why)))
(define (same! a b why) (unless (equal? a b) (error 'editor-gate "~a: ~s != ~s" why a b)))
(define (json-scalar v) (if (symbol? v) (symbol->string v) v))
(define (snips t)
  (let loop ([s (send t find-first-snip)] [n 0] [rev '()])
    (check! (< n 1024) "snip fixture exceeded bound/cycle")
    (if s (loop (send s next) (add1 n) (cons s rev)) (reverse rev))))
(define (rgba c) (list (send c red) (send c green) (send c blue) (send c alpha)))
(define (channels c) (list (send c get-r) (send c get-g) (send c get-b) (send c get-a)))
(define delta-methods
  '(get-family get-face get-size-mult get-size-add get-weight-on get-weight-off
    get-style-on get-style-off get-smoothing-on get-smoothing-off get-underlined-on
    get-underlined-off get-size-in-pixels-on get-size-in-pixels-off
    get-transparent-text-backing-on get-transparent-text-backing-off get-alignment-on get-alignment-off))
(define appearance-methods
  '(get-family get-face get-size get-weight get-style get-smoothing get-underlined
    get-size-in-pixels get-transparent-text-backing get-alignment))
(define (method-fields obj methods)
  (for/hasheq ([method (in-list methods)]) (values method (json-scalar (dynamic-send obj method)))))
(define (style-ref sl s)
  (cond [s (define i (send sl style-to-index s))
           (check! (exact-nonnegative-integer? i) "style belongs to its actual editor list") i]
        [else #f]))
(define (style-view sl)
  (check! (<= 1 (send sl number) 1024) "style fixture count bound")
  (for/list ([i (in-range (send sl number))])
    (define s (send sl index-to-style i))
    (same! (style-ref sl s) i "indexed style roundtrip")
    (define delta (new style-delta%))
    (send s get-delta delta)
    (hasheq 'index i 'name (send s get-name)
            'base (style-ref sl (send s get-base-style))
            'join (send s is-join?)
            'shift (and (send s is-join?) (style-ref sl (send s get-shift-style)))
            'delta (hash-set* (method-fields delta delta-methods)
                             'foreground-mult (channels (send delta get-foreground-mult))
                             'foreground-add (channels (send delta get-foreground-add))
                             'background-mult (channels (send delta get-background-mult))
                             'background-add (channels (send delta get-background-add)))
            'appearance (hash-set* (method-fields s appearance-methods)
                                  'foreground (rgba (send s get-foreground))
                                  'background (rgba (send s get-background))))))
(define (position-style t p)
  (define s (send t find-snip p 'after-or-none))
  (check! s "position must resolve to an actual snip")
  (style-ref (send t get-style-list) (send s get-style)))
(define (bitmap-view bitmap)
  (check! (and bitmap (send bitmap ok?)) "real image bitmap must be present")
  (define w (send bitmap get-width))
  (define h (send bitmap get-height))
  (check! (and (<= 1 w 12) (<= 1 h 9)) "small deterministic bitmap geometry")
  (define bs (make-bytes (* 4 w h)))
  (send bitmap get-argb-pixels 0 0 w h bs)
  (hasheq 'width w 'height h 'argb (bytes->list bs)))
(define (four-boxes s method)
  (define boxes (for/list ([i (in-range 4)]) (box 0)))
  (apply dynamic-send s method boxes)
  (map unbox boxes))
(define (editor-view t [depth 0])
  (check! (and (is-a? t text%) (<= depth 1)) "bounded genuine text editor nesting")
  (define sl (send t get-style-list))
  (define length (send t last-position))
  (check! (<= length 1024) "text fixture length bound")
  (hasheq 'kind "text" 'text (send t get-text) 'flattened (send t get-text 0 'eof #t)
          'length length 'styles (style-view sl)
          'position_styles (for/list ([p (in-range length)]) (position-style t p))
          'snips
          (for/list ([s (in-list (snips t))])
            (define classname (send s get-snipclass))
            (check! classname "snip has a registered serialization class")
            (define common
              (hasheq 'position (send t get-snip-position s) 'count (send s get-count)
                      'class (send classname get-classname) 'version (send classname get-version)
                      'flags (map symbol->string (send s get-flags))
                      'style (style-ref sl (send s get-style))))
            (cond
              [(is-a? s editor-snip%)
               (define nested (send s get-editor))
               (hash-set* common 'kind "editor" 'editor (editor-view nested (add1 depth))
                          'shared_style_list (eq? sl (send nested get-style-list))
                          'border (send s border-visible?) 'margin (four-boxes s 'get-margin)
                          'inset (four-boxes s 'get-inset)
                          'min_width (json-scalar (send s get-min-width))
                          'max_width (json-scalar (send s get-max-width))
                          'min_height (json-scalar (send s get-min-height))
                          'max_height (json-scalar (send s get-max-height))
                          'tight_text_fit (send s get-tight-text-fit)
                          'align_top_line (send s get-align-top-line))]
              [(is-a? s image-snip%)
               (hash-set* common 'kind "image" 'bitmap (bitmap-view (send s get-bitmap))
                          'mask (and (send s get-bitmap-mask) (bitmap-view (send s get-bitmap-mask))))]
              [(is-a? s string-snip%)
               (hash-set* common 'kind "string" 'text (send s get-text 0 (send s get-count)))]
              [else (error 'editor-gate "Unexpected fixture snip class: ~a" (send classname get-classname))]))))
