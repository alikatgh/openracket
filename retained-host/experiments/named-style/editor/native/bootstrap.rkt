#lang racket/base
;; Source-first loading of the ACTUAL installed style module, never a copied
;; substitute module. This correctness process is not a timing measurement.
(require json racket/class racket/exn racket/file racket/path racket/runtime-path
         syntax/modresolve)
(define-runtime-path gate-path "editor-gate.rkt")
(define args (current-command-line-arguments))
(unless (= (vector-length args) 4)
  (error 'editor-gate "Expected mode, runtime root, expected style SHA256, output directory"))
(define mode (vector-ref args 0))
(define root (simplify-path (path->complete-path (vector-ref args 1))))
(define expected-sha (vector-ref args 2))
(define output (path->complete-path (vector-ref args 3)))
(define report (make-hasheq))
(hash-set! report 'schema "openracket-named-style-editor-v1")
(hash-set! report 'mode mode)
(hash-set! report 'passed #f)
(hash-set! report 'stages '())
(define (record! key value) (hash-set! report key value))
(define (stage! s)
  (record! 'stages (append (hash-ref report 'stages) (list s))))
(define (digest bs)
  (apply string-append
         (for/list ([b (in-bytes (sha256-bytes bs))])
           (define s (number->string b 16))
           (if (= (string-length s) 1) (string-append "0" s) s))))
(define (fail-details e)
  (hasheq 'message (if (exn? e) (exn-message e) (format "~s" e))
          'details (if (exn? e) (exn->string e) (format "Non-exception raised: ~s" e))))
(define (persist!)
  (call-with-output-file (build-path output "capture.json") #:exists 'truncate/replace
    (lambda (out) (write-json report out) (newline out))))
(with-handlers ([(lambda (_) #t)
                 (lambda (e) (record! 'failure (fail-details e)) (persist!) (exit 1))])
  (unless (member mode '("stock" "stock-again" "off" "on"))
    (error 'editor-gate "Unknown mode ~s" mode))
  (unless (equal? (version) "9.3") (error 'editor-gate "Expected Racket 9.3"))
  (define flag (getenv "OPENRACKET_NAMED_STYLE_INDEX"))
  (unless (equal? flag (cond [(equal? mode "on") "1"] [(equal? mode "off") "0"] [else #f]))
    (error 'editor-gate "Mode does not match exact activation environment"))
  (define unexpected
    (for/list ([k (in-list (environment-variables-names (current-environment-variables)))]
               #:when (and (regexp-match? #rx#"^OPENRACKET_" k)
                           (not (equal? k #"OPENRACKET_NAMED_STYLE_INDEX"))))
      (bytes->string/utf-8 k)))
  (unless (null? unexpected) (error 'editor-gate "Other experiment flags: ~s" unexpected))
  (define module-name 'racket/snip/private/style)
  (define source (simplify-path (resolve-module-path module-name #f)))
  (define relative (find-relative-path root source))
  (unless (and (relative-path? relative)
               (not (member 'up (explode-path relative)))
               (not (link-exists? source)) (file-exists? source)
               (<= (file-size source) (* 1024 1024)))
    (error 'editor-gate "Actual resolved source is not a bounded runtime descendant: ~a" source))
  (define source-sha (digest (file->bytes source)))
  (unless (equal? source-sha expected-sha)
    (error 'editor-gate "Actual resolved source pin mismatch: ~a" source-sha))
  (record! 'runtime (hasheq 'racket_version (version) 'source (path->string source)
                           'source_sha256 source-sha 'flag (or flag 'null)
                           'source_first_load #t))
  (stage! "source-pin-verified")
  ;; Ignore .zo ONLY for the style module's initial source loading. This proves
  ;; the installed source bytes, rather than a stale compiled copy, define the
  ;; shared runtime class. GUI imports subsequently reuse that module instance.
  (parameterize ([use-compiled-file-paths '()]) (dynamic-require module-name #f))
  (define resolved (make-resolved-module-path source))
  (define already-loaded-namespace (module->namespace resolved))
  (unless (= (namespace-base-phase already-loaded-namespace) 0)
    (error 'editor-gate "Style module is not loaded at phase zero"))
  (define missing (gensym 'missing-export))
  ;; Only the explicit missing-export thunk denotes stock. Load and namespace
  ;; errors are never caught and relabelled as a missing export.
  (define enabled (dynamic-require resolved 'openracket-named-style-index-enabled? (lambda () missing)))
  (define state (dynamic-require resolved 'openracket-named-style-index-state (lambda () missing)))
  (define stock? (member mode '("stock" "stock-again")))
  (unless (if stock?
              (and (eq? enabled missing) (eq? state missing))
              (and (boolean? enabled) (eq? enabled (equal? mode "on"))
                   (procedure? state) (procedure-arity-includes? state 1)))
    (error 'editor-gate "Runtime export/activation mismatch"))
  (record! 'activation (hasheq 'enabled (if stock? 'null enabled)
                              'export_status (if stock? "missing" "present")
                              'module_already_loaded #t))
  (define private-list% (dynamic-require resolved 'style-list%))
  (define dependency-pins
    '((framework/private/color . "da45ea64a5a0b413296a60ebe61d3e5ee69a27b53a6f1e13ae258701bdce1578")
      (framework/private/racket . "fd3ada7890a54f715fc0c7369993d59902fb079a43b00c83a1d5fbd2f0fe4520")
      (mred/private/wxme/editor . "63987762c560c5b3b3d4f087e66bb68b3fba3a8aabb7d897bfcb09994391a144")
      (mred/private/wxme/editor-snip . "055f9bd6bdcbbf6712c25dd0ee66b195d0c1a2dbb61ed05da041526c61047049")
      (mred/private/wxme/editor-snip-class . "c0a82e707983738c5b5d76256caecc283993097b7903101f2500e5bf08513f62")))
  (define dependency-evidence
    (for/list ([pin (in-list dependency-pins)])
      (define path (simplify-path (resolve-module-path (car pin) #f)))
      (define rel (find-relative-path root path))
      (unless (and (relative-path? rel) (not (member 'up (explode-path rel)))
                   (not (link-exists? path)) (file-exists? path)
                   (<= (file-size path) (* 1024 1024))
                   (equal? (digest (file->bytes path)) (cdr pin)))
        (error 'editor-gate "Official GUI dependency source mismatch: ~a" (car pin)))
      (hasheq 'module (symbol->string (car pin)) 'source (path->string path) 'sha256 (cdr pin))))
  (record! 'dependencies dependency-evidence)
  (define run! (dynamic-require gate-path 'run-gate!))
  (for ([pin (in-list dependency-pins)])
    ;; Verify these are the modules framework actually instantiated, rather
    ;; than importing a second source copy to manufacture apparent evidence.
    (define namespace (module->namespace (make-resolved-module-path (resolve-module-path (car pin) #f))))
    (unless (= (namespace-base-phase namespace) 0)
      (error 'editor-gate "GUI dependency not loaded at phase zero: ~a" (car pin))))
  (unless (eq? already-loaded-namespace (module->namespace resolved))
    (error 'editor-gate "GUI did not retain the source-first loaded module"))
  (stage! "gui-imported-same-runtime-module")
  (run! output private-list% (and (not stock?) state) record! stage!)
  (unless (equal? source-sha (digest (file->bytes source)))
    (error 'editor-gate "Runtime source changed during capture"))
  (record! 'passed #t)
  (persist!))
(exit 0)
