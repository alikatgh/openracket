#lang racket/base
;; Public per-eventspace registration, only for this fixture's actual stock
;; editor-snip class. No name lookup/autoload, replacement, or alternate reader.
(require racket/class racket/gui/base racket/list
         (only-in mred/private/wxme/editor-snip-class the-editor-snip-class))
(provide setup-editor-snip! run-registration-controls!)
(define (need value message)
  (unless value (error 'editor-registry "~a" message)))
(define (members registry)
  (define count (send registry number))
  (need (and (exact-nonnegative-integer? count) (<= count 1024)) "bounded registry count")
  (for/list ([i (in-range count)])
    (define cls (send registry nth i))
    (need (is-a? cls snip-class%) "actual registry class")
    (need (= (send registry find-position cls) i) "registry index agrees with exact object")
    cls))
(define (view registry cls entries)
  (define index (send registry find-position cls))
  (need (and (exact-integer? index) (<= -1 index) (< index (length entries)))
        "bounded actual class index")
  (hasheq 'index index
          'registered_same_object (and (>= index 0) (eq? (list-ref entries index) cls))
          'classes (for/list ([entry (in-list entries)] [i (in-naturals)])
                     (define name (send entry get-classname))
                     (define version (send entry get-version))
                     (need (and (string? name) (<= (string-length name) 1024)
                                (exact-nonnegative-integer? version) (<= version 100000))
                           "bounded class name and version")
                     (hasheq 'index i 'class name 'version version))))
(define (require-registered! registry cls)
  (define entries (members registry))
  (define result (view registry cls entries))
  (need (hash-ref result 'registered_same_object) "required exact class remains absent or wrong")
  result)
(define (ensure-registration! registry cls)
  (need (and (is-a? cls snip-class%)
             (equal? (send cls get-classname) "wxmedia") (= (send cls get-version) 4))
        "expected stock wxmedia version 4")
  (define before (members registry))
  (define before-view (view registry cls before))
  ;; Reject conflicting identity even when name and version happen to match.
  ;; The public docs and pinned implementation differ on duplicate-name add;
  ;; this path relies on neither behavior because conflict precedes mutation.
  (for ([entry (in-list before)])
    (when (equal? (send entry get-classname) "wxmedia")
      (need (eq? entry cls) "conflicting wxmedia class object or version")))
  (define present? (hash-ref before-view 'registered_same_object))
  (unless present? (send registry add cls))
  (define after-view (require-registered! registry cls))
  (define after (members registry))
  (define expected (if present? before (append before (list cls))))
  (need (and (= (length after) (length expected)) (andmap eq? after expected))
        "registration preserves all earlier class identities and indices")
  (hasheq 'before before-view 'after after-view 'prior_entries_same #t))
(define (setup-editor-snip! embedded record!)
  (define cls (send embedded get-snipclass))
  ;; This installed module is already instantiated and source-pinned by the
  ;; bootstrap. Do not synthesize a snip class merely named wxmedia.
  (need (eq? cls the-editor-snip-class) "fixture uses exact installed stock editor-snip class")
  (define evidence (ensure-registration! (get-the-snip-class-list) cls))
  (record! 'registry_setup (hash-set evidence 'stock_class_same #t)))

(define (run-registration-controls!)
  ;; Isolated fake registries never modify the live GUI registry. The helper
  ;; and validator are the same ones used at the actual pre-save boundary.
  (define (class-with name version)
    (define cls (new snip-class%))
    (send cls set-classname name)
    (send cls set-version version)
    cls)
  (define first (class-with "control:existing" 1))
  (define expected (class-with "wxmedia" 4))
  (define fake-registry%
    (class object%
      (init-field [entries '()] [behavior 'append])
      (super-new)
      (define adds 0)
      (define/public (number) (length entries))
      (define/public (nth i) (list-ref entries i))
      (define/public (find-position cls)
        (or (for/first ([entry (in-list entries)] [i (in-naturals)] #:when (eq? entry cls)) i) -1))
      (define/public (add cls)
        (set! adds (add1 adds))
        (case behavior
          [(append) (set! entries (append entries (list cls)))]
          [(ignore) (void)]
          [(wrong) (set! entries (append entries (list (class-with "wxmedia" 4))))]
          [(reorder) (set! entries (cons cls entries))]))
      (define/public (add-count) adds)))
  (define (reject! thunk message)
    (need (with-handlers ([exn:fail? (lambda (_) #t)]) (thunk) #f) message))
  (define absent (new fake-registry% [entries (list first)]))
  (reject! (lambda () (require-registered! absent expected)) "absent class must fail validation")
  (define evidence (ensure-registration! absent expected))
  (need (and (= (send absent add-count) 1)
             (= (hash-ref (hash-ref evidence 'before) 'index) -1)
             (= (hash-ref (hash-ref evidence 'after) 'index) 1)) "missing class is appended exactly once")
  (ensure-registration! absent expected)
  (need (= (send absent add-count) 1) "existing exact class is not added again")
  (for ([version '(4 3)])
    (define conflict (new fake-registry% [entries (list first (class-with "wxmedia" version))]))
    (reject! (lambda () (ensure-registration! conflict expected)) "same-name different object or version rejected")
    (need (= (send conflict add-count) 0) "conflict rejected before mutation"))
  (for ([behavior '(ignore wrong reorder)])
    (define bad (new fake-registry% [entries (list first)] [behavior behavior]))
    (reject! (lambda () (ensure-registration! bad expected)) "missing/wrong/reordered post-add state rejected"))
  (reject! (lambda () (ensure-registration! (new fake-registry%) (class-with "wxmedia" 3)))
           "wrong requested version rejected")
  (void))
