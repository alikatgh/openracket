#lang racket/base
;; Native-unrun. Read-only receipt support; no compilation or repair operations.
(require racket/file racket/list racket/path racket/runtime-path json setup/dirs)
(provide (all-defined-out))
(define-runtime-path helper-directory ".")
(define (fail fmt . vs) (apply error 'object-hash-ci fmt vs))
(define (physical p [links 0])
  (when (>= links 64) (fail "Too many symbolic links: ~a" p))
  (define parts (explode-path (path->complete-path p)))
  (for/fold ([base (car parts)]) ([part (in-list (cdr parts))])
    (define next (cond [(eq? part 'same) base]
                       [(eq? part 'up) (simplify-path (build-path base 'up) #f)]
                       [else (build-path base part)]))
    (if (link-exists? next)
        (physical (path->complete-path (resolve-path next) (or (path-only next) base))
                  (add1 links))
        next)))
(define (inside? p root)
  (define rel (find-relative-path (physical root) (physical p)))
  (and (relative-path? rel) (not (member 'up (explode-path rel)))))
(define (inside-file! p roots)
  (define actual (physical p))
  (unless (and (file-exists? actual)
               (for/or ([root (in-list roots)]) (inside? actual root)))
    (fail "Missing or out-of-root required file: ~a" p))
  actual)
(define H (physical helper-directory))
(define W (physical (build-path H 'up)))
(define C (physical (build-path W "runtime")))
(define Q (physical (build-path W "probe")))
(define K (physical (build-path W "compiled")))
(define source-roots (list C Q H))
(define (hex bs)
  (apply string-append
         (for/list ([b (in-bytes bs)])
           (define s (number->string b 16))
           (if (= 1 (string-length s)) (string-append "0" s) s))))
(define (digest p) (hex (sha256-bytes (file->bytes p))))
(define (file-record p)
  (hasheq 'path (path->string p) 'size (file-size p) 'sha256 (digest p)))
(define (datum-json v)
  (cond [(or (string? v) (boolean? v) (exact-integer? v)) v]
        [(path? v) (hasheq 'type "path" 'value (path->string v))]
        [(bytes? v) (hasheq 'type "bytes" 'hex (hex v))]
        [(symbol? v) (hasheq 'type "symbol" 'value (symbol->string v))]
        [(list? v) (map datum-json v)]
        [(pair? v) (hasheq 'type "pair" 'car (datum-json (car v)) 'cdr (datum-json (cdr v)))]
        [(hash? v) (hasheq 'type "hash" 'entries
                           (for/list ([(k x) (in-hash v)])
                             (hasheq 'key (datum-json k) 'value (datum-json x))))]
        [(vector? v) (hasheq 'type "vector" 'values (map datum-json (vector->list v)))]
        [(or (regexp? v) (byte-regexp? v))
         (hasheq 'type "regexp" 'source (datum-json (object-name v)))]
        [(number? v) (hasheq 'type "number" 'value (number->string v))]
        [else (fail "Unsupported inventory datum: ~e" v)]))
(define (read-datum p)
  (call-with-input-file p
    (lambda (in)
      (call-with-default-reading-parameterization
       (lambda ()
         (define v (read in))
         (unless (eof-object? (read in)) (fail "Trailing datum: ~a" p))
         v)))))
(define (emit x) (write-json x) (newline) (flush-output))
(define (assert-layout! #:source-only? [source-only? #f])
  (unless (and (equal? (version) "9.3") (eq? (system-type 'vm) 'chez-scheme))
    (fail "Expected Racket 9.3 CS"))
  (unless (and (equal? H (physical (build-path W "ci")))
               (equal? (physical (find-collects-dir)) (physical (build-path C "collects")))
               (equal? (physical (find-config-dir)) (physical (build-path C "etc"))))
    (fail "Unexpected clone/main-collects/config/helper layout"))
  (unless (and (equal? (getenv "PLT_ZO_PATH") "compiled")
               (equal? (map physical (current-compiled-file-roots)) (list K))
               (andmap complete-path? (current-compiled-file-roots))
               (equal? (getenv "PLTCOMPILEDROOTS") (path->string K)))
    (fail "Sole absolute compiled root or PLT_ZO_PATH drift"))
  (unless (equal? (use-compiled-file-paths)
                  (if source-only? null (list (string->path "compiled"))))
    (fail "Unexpected compiled-subdirectory mode"))
  (unless (not (use-user-specific-search-paths)) (fail "-U is required"))
  (define exe (physical (or (find-executable-path (find-system-path 'exec-file))
                            (find-system-path 'exec-file))))
  (unless (inside? exe C) (fail "Executable is outside the selected clone"))
  (void))
(define (profile-root)
  (define home (getenv "HOME"))
  (unless home (fail "HOME is unset"))
  (define p (physical home))
  (unless (and (inside? p W)
               (equal? (physical (build-path p 'up)) W)
               (regexp-match? #rx"^profile-" (path->string (file-name-from-path p))))
    (fail "Fresh arm-local profile-<case> HOME is required"))
  (unless (and (equal? (getenv "PLTUSERHOME") home)
               (equal? (physical (find-system-path 'addon-dir))
                       (physical (build-path p "addon"))))
    (fail "Profile/addon identity drift"))
  p)
(define (make-read-only-guard)
  (make-security-guard
   (current-security-guard)
   (lambda (who path modes)
     (when (ormap (lambda (m) (memq m '(write delete execute))) modes)
       (fail "Read-only inventory rejected ~a on ~a" who path)))
   (lambda args (fail "Network use is forbidden in read-only inventories"))))
(define (install-read-only-guard!)
  (current-security-guard (make-read-only-guard)))
