#lang racket/base
;; CI-only read-only discovery proof. No GUI or appearance tool is instantiated.
(require json racket/file racket/list racket/path racket/gui/dynamic setup/getinfo pkg/lib file/sha1)
(when (gui-available?) (error 'registration "Registration proof must remain headless"))
(define arguments (current-command-line-arguments))
(unless (= (vector-length arguments) 1) (error 'registration "Expected exact proof root"))
(define (canonical p) (simplify-path (path->complete-path p) #t))
(define proof (canonical (vector-ref arguments 0)))
(define addon (canonical (or (getenv "PLTADDONDIR") (error 'registration "Explicit addon required"))))
(define home (canonical (or (getenv "PLTUSERHOME") (error 'registration "Explicit home required"))))
(define (inside? p root)
  (define rel (find-relative-path (path->directory-path root) (canonical p) #:more-than-same? #f))
  (and (relative-path? rel) (not (member 'up (explode-path rel)))))
(unless (and (equal? (version) "9.3") (use-user-specific-search-paths)
             (equal? (path->directory-path addon) (path->directory-path (canonical (find-system-path 'addon-dir)))) (inside? addon home))
  (error 'registration "Wrong version, disabled user collection search, or unrelated addon"))
(define manifest (call-with-input-file (build-path proof "CONTENTS-SHA256.json") read-json))
(define patch (call-with-input-file (build-path proof "reports/patch-manifest.json") read-json))
(define (digest p) (bytes->hex-string (sha256-bytes (file->bytes p))))
(define tool (canonical (collection-file-path "tool.rkt" "openracket-appearance")))
(define expected-tool (canonical (build-path proof "tool/tool.rkt")))
(unless (and (equal? tool expected-tool)
             (equal? (digest tool) (hash-ref manifest 'tool/tool.rkt)))
  (error 'registration "Appearance collection did not resolve to the exact pinned proof tool"))
(define gui (canonical (or (pkg-directory "openracket-gui-lib")
                          (error 'registration "Copied GUI package is missing"))))
(unless (inside? gui addon) (error 'registration "GUI package escaped the fresh addon"))
(define checks
  (for/list ([spec (in-list (list
     (list "switchable-button.rkt" '("mrlib") (hash-ref patch 'patched_sha256))
     (list "openracket-paint.rkt" '("mrlib" "private") (hash-ref patch 'painter_sha256))
     (list "text-misc.rkt" '("framework" "private") "00d1ac5b184b494939a98057ea4b2584c3cda31378dcb32a7685f370ed60475d")))])
    (define p (canonical (apply collection-file-path (car spec) (cadr spec))))
    (define sha (digest p))
    (unless (and (inside? p gui) (equal? sha (caddr spec)))
      (error 'registration "Wrong selected source ~s ~s" p sha))
    (hasheq 'path (path->string p) 'sha256 sha)))
;; Same discovery keys and info API as the original DrRacket tools.rkt.
(define records (find-relevant-directory-records
                 '(drracket-tools drracket-tool-icons drracket-tool-names drracket-tool-urls
                   tools tool-icons tool-names tool-urls)))
(define selected
  (filter (lambda (r) (equal? (path->directory-path (canonical (directory-record-path r)))
                             (path->directory-path (canonical (build-path proof "tool"))))) records))
(unless (= (length selected) 1) (error 'registration "Expected one actual tool discovery record, got ~s" (length selected)))
(define directory (canonical (directory-record-path (car selected))))
(define info (get-info/full directory))
(unless (and info (equal? (info 'drracket-tools (lambda () #f)) '(("tool.rkt")))
             (equal? (info 'drracket-tool-names (lambda () #f)) '("OpenRacket Appearance"))
             (equal? (digest (build-path directory "info.rkt")) (hash-ref manifest 'tool/info.rkt)))
  (error 'registration "Actual discovered tool registration differs from the pinned proof"))
(write-json (hasheq 'status "verified" 'racket_version (version) 'profile (path->string home)
                    'addon (path->string addon) 'gui_package (path->string gui)
                    'tool_directory (path->string directory) 'tool_path (path->string tool)
                    'tool_sha256 (digest tool) 'discovery_records (length selected)
                    'drracket_tools (info 'drracket-tools) 'source_checks checks
                    'gui_started #f 'preferences_changed #f))
(newline)
