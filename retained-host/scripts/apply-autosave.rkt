#lang racket/base
;; Apply only the measured stock-save scan guard inside the isolated GUI package.
(require racket/file racket/path racket/runtime-path racket/cmdline file/sha1 json pkg/lib)
(provide apply-autosave!)
(define-runtime-path root "..")
(define stock-pin "7f95100d31c510ae1b29ddf01c6801d34ba709880b0dfc953ccd895a5bb06638")
(define patched-pin "00d1ac5b184b494939a98057ea4b2584c3cda31378dcb32a7685f370ed60475d")
(define (digest data) (bytes->hex-string (sha256-bytes data)))
(define (apply-autosave! source-root profile gui-dir #:revert? [revert? #f])
  (define (verified relative pin)
    (define bytes (file->bytes (build-path source-root relative)))
    (unless (equal? (digest bytes) pin)
      (error 'openracket-autosave "Source integrity failure: ~a; no changes made" relative))
    bytes)
  ;; Verify BOTH directions before any target mutation.
  (define stock (verified "vendor/text-misc-v9.3.rkt" stock-pin))
  (define patched (verified "overlay/framework/private/text-misc.rkt" patched-pin))
  (define boundary (simplify-path profile #f))
  (when (link-exists? boundary)
    (error 'openracket-autosave "The isolated profile may not be a symbolic link"))
  (define target (simplify-path (build-path gui-dir "framework/private/text-misc.rkt") #f))
  (define relative (find-relative-path boundary target))
  (define elements (explode-path relative))
  (when (or (complete-path? relative) (memq 'up elements))
    (error 'openracket-autosave "Refusing a target outside the isolated profile: ~a" target))
  (for/fold ([at boundary]) ([part (in-list elements)])
    (define next (build-path at part))
    (when (link-exists? next)
      (error 'openracket-autosave "Refusing symbolic-link target in profile: ~a" next))
    next)
  (unless (and (file-exists? target)
               (member (digest (file->bytes target)) (list stock-pin patched-pin)))
    (error 'openracket-autosave "Installed source is missing or has unrelated changes; no changes made"))
  (call-with-atomic-output-file target
    (lambda (out temporary) (write-bytes (if revert? stock patched) out)))
  target)
(module+ main
  (define revert? #f)
  (command-line #:once-each [("--revert") "Restore exact upstream save source" (set! revert? #t)])
  (define gui-dir (or (pkg-directory "openracket-gui-lib") (pkg-directory "gui-lib")))
  (unless gui-dir (error 'openracket-autosave "Complete official gui-lib is required"))
  (define target (apply-autosave! root (build-path root "profile") gui-dir #:revert? revert?))
  (printf "~a measured autosave guard inside the isolated profile: ~a\n"
          (if revert? "Reverted" "Prepared") target))
