#lang racket/base
;; Native-only polish acceptance. Run through the genuine-host harness in an
;; isolated Cocoa process with OPENRACKET_NATIVE_APPEARANCE=1. No desktop settings
;; changes, private production reflection, or synthetic replacement editor.
(require racket/class racket/gui/base racket/list racket/string
         rackunit string-constants
         "../tool/native-appearance.rkt" "../tool/native-appearance-platform.rkt")
(provide capture-native-appearance-baseline run-native-appearance-workflows!)

(define (on-handler!)
  (unless (eq? (current-thread) (eventspace-handler-thread (current-eventspace)))
    (error 'native-appearance-workflows "Existing GUI handler thread required")))
(define (await! what predicate)
  (define end (+ (current-inexact-monotonic-milliseconds) 15000))
  (let loop ()
    (or (predicate)
        (if (> (current-inexact-monotonic-milliseconds) end)
            (error 'native-appearance-workflows "Timed out: ~a; preserve diagnostics" what)
            (begin (yield (alarm-evt (+ (current-inexact-milliseconds) 20))) (loop))))))
(define (fence!)
  (define done (make-semaphore))
  (queue-callback (lambda () (semaphore-post done)) #f)
  (yield (semaphore-peek-evt done)))
(define (descendants widget)
  (cons widget
        (if (is-a? widget area-container<%>)
            (append-map descendants (send widget get-children)) '())))
(define (unique-button frame label)
  (define candidates
    (filter (lambda (widget) (and (is-a? widget button%)
                                 (equal? (send widget get-label) label)))
            (descendants frame)))
  (check-equal? (length candidates) 1 (format "One actual ~s button" label))
  (car candidates))
(define (click! button) (send button command (new control-event% [event-type 'button])))
(define (capture-native-appearance-baseline)
  (on-handler!)
  (define adapter (make-platform-native-appearance-adapter #:enabled? #t))
  (unless adapter
    (error 'native-appearance-workflows "Positive native appearance capability required"))
  ;; Inspect only: this second adapter owns no checkpoint and changes no state.
  (define inspect (native-appearance-adapter-inspect adapter))
  (values (inspect) inspect))

(define (check-native-fonts! frame register-created!)
  (define select-font (dynamic-require 'mrlib/private/openracket-paint 'modern-control-font))
  (define paint (dynamic-require 'mrlib/private/openracket-paint 'paint-modern-button))
  (define theme (dynamic-require 'mrlib/private/openracket-paint 'current-modern-theme))
  (check-eq? (select-font normal-control-font) normal-control-font)
  (define run (send frame get-execute-button))
  (define-values (label-width label-height descent extra)
    (send (send run get-dc) get-text-extent (send run get-label) normal-control-font))
  (check-true (> (send run get-large-width) label-width))
  (check-true (>= (send run min-height) label-height))
  (define specimen (new frame% [label "Per-app supplied control-font specimens"] [width 650]))
  (register-created! specimen)
  (define panel (new vertical-panel% [parent specimen]))
  (define icon (make-bitmap 20 20 #t))
  (define sizes '())
  (define canvases
    (for/list ([scale '(1.0 1.5 2.0)])
      ;; Documented font constructor only. The real stock toolbar's immutable
      ;; normal-control-font and the desktop accessibility settings are untouched.
      (define font
        (make-font #:size (* scale (send normal-control-font get-size))
                   #:face (send normal-control-font get-face)
                   #:family (send normal-control-font get-family)
                   #:style (send normal-control-font get-style)
                   #:weight (send normal-control-font get-weight)
                   #:underlined? (send normal-control-font get-underlined)
                   #:smoothing (send normal-control-font get-smoothing)
                   #:size-in-pixels? (send normal-control-font get-size-in-pixels)))
      (define label "Control font: café λ")
      (define-values (width height d a) (send (send run get-dc) get-text-extent label font))
      (set! sizes (append sizes (list (list scale width height))))
      (new canvas% [parent panel] [style '(transparent)]
           [min-width (inexact->exact (ceiling (+ width 20 6 24)))]
           [min-height (inexact->exact (ceiling (+ (max height 20) 24)))]
           [stretchable-height #f]
           [paint-callback
            (lambda (canvas dc)
              (define before (send dc get-font))
              (define-values (cw ch) (send canvas get-client-size))
              (define-values (tw th td ta) (send dc get-text-extent label (select-font font)))
              (check-= tw width 0.01) (check-= th height 0.01)
              (check-true (> cw (+ tw 26))) (check-true (> ch th))
              (parameterize ([theme (if (white-on-black-panel-scheme?) 'dark 'light)])
                (paint dc cw ch label icon icon #t #f #f #f 32 (select-font font)))
              (check-eq? (send dc get-font) before))])))
  (send specimen show #t)
  (fence!)
  (for ([canvas (in-list canvases)]) (send canvas on-paint))
  (check-true (apply < (map cadr sizes)))
  (check-true (apply <= (map caddr sizes)))
  (printf "OPENRACKET_NATIVE_FONT_METRICS ~s\n" sizes)
  (send specimen show #f)
  (hash 'native_dc #t 'supplied_font_scales '(1.0 1.5 2.0)
        'os_accessibility_scaling_tested #f))

(define (run-native-appearance-workflows! frame original inspect register-created!)
  (on-handler!)
  (parameterize ([current-check-handler raise])
    (define pref-get (dynamic-require 'framework 'preferences:get))
    (define pref-set (dynamic-require 'framework 'preferences:set))
    (define show-tab (dynamic-require 'framework 'preferences:show-tab-panel))
    (define open-frame (dynamic-require 'drracket/tool-lib 'drracket:unit:open-drscheme-window))
    (define painter-mode (dynamic-require 'mrlib/private/openracket-paint 'get-modern-host-theme))
    (define blended? (dynamic-require 'mrlib/private/openracket-paint 'get-modern-chrome-blended?))
    (define native-dark? (dynamic-require 'racket/gui/base 'white-on-black-panel-scheme?))
    (define defs (send frame get-definitions-text))
    (define source (send defs get-text))
    (define original-toolbar (send (send frame get-button-panel) get-children))
    (define (log! stage)
      (printf "OPENRACKET_NATIVE_APPEARANCE_INTEGRATION ~s\n"
              (hash 'stage stage 'native (inspect) 'painter (painter-mode)
                    'blended (blended?) 'state (pref-get 'openracket:appearance-state)
                    'mode (pref-get 'framework:white-on-black-mode?)))
      (flush-output))
    (define (check-mode! dark)
      (await! "native/editor/painter convergence"
              (lambda () (and (eq? (native-dark?) dark) (blended?)
                             (eq? (painter-mode) (if dark 'dark 'light)))))
      (check-equal? (pref-get 'framework:white-on-black-mode?) dark)
      (check-equal? (send (send frame get-button-panel) get-children) original-toolbar)
      (check-eq? (send frame get-definitions-text) defs)
      (check-equal? (send defs get-text) source))
    (define (preferences!)
      (define before (get-top-level-windows))
      (show-tab '("OpenRacket"))
      (define preferences
        (await! "real OpenRacket preferences page"
                (lambda ()
                  (for/or ([window (in-list (get-top-level-windows))])
                    (and (send window is-shown?)
                         (is-a? window frame%)
                         (for/or ([widget (in-list (descendants window))])
                           (and (is-a? widget button%)
                                (equal? (send widget get-label) "Restore previous appearance")))
                         window)))))
      (unless (memq preferences before) (register-created! preferences))
      preferences)
    (check-eq? (pref-get 'openracket:appearance-state) 'applied)
    (check-true (boolean? (pref-get 'framework:white-on-black-mode?)))
    (check-mode! (pref-get 'framework:white-on-black-mode?))
    (define font-result (check-native-fonts! frame register-created!))
    (log! 'initial)
    (define second (open-frame #f))
    (register-created! second)
    (check-not-eq? second frame)
    (check-true (send second is-shown?))
    (for ([dark '(#f #t)])
      (pref-set 'framework:white-on-black-mode? dark)
      (fence!) (check-mode! dark))
    ;; Real frame close lifecycle must not restore an app-global override while
    ;; another genuine DrRacket frame remains open.
    (send second close)
    (fence!)
    (check-false (send second is-shown?))
    (check-mode! #t)
    (log! 'second-frame-closed)
    (pref-set 'framework:white-on-black-mode? 'platform)
    (fence!)
    (await! "exact original app inheritance while following platform"
            (lambda () (equal? (inspect) original)))
    (check-false (blended?))
    (check-eq? (pref-get 'framework:white-on-black-mode?) 'platform)
    (log! 'platform-follow)
    (pref-set 'framework:white-on-black-mode? #t)
    (fence!) (check-mode! #t)
    ;; Exercise Framework's actual full-preference snapshot cancellation, not
    ;; a hand-written facsimile or a direct call to private theme procedures.
    (define preferences (preferences!))
    (define before-restore (inspect))
    (click! (unique-button preferences "Restore previous appearance"))
    (fence!)
    (check-eq? (pref-get 'openracket:appearance-state) 'restored)
    (check-equal? (inspect) original)
    (check-false (blended?))
    (click! (unique-button preferences (string-constant undo-changes)))
    (fence!)
    (await! "Undo Changes reinstates the original applied native transaction"
            (lambda () (and (eq? (pref-get 'openracket:appearance-state) 'applied)
                           (equal? (inspect) before-restore) (blended?))))
    (check-mode! #t)
    (log! 'restore-cancelled)
    ;; Leave a committed restored state using the actual Restore button.
    (set! preferences (preferences!))
    (click! (unique-button preferences "Restore previous appearance"))
    (send preferences close)
    (fence!)
    (check-equal? (inspect) original)
    (check-eq? (pref-get 'openracket:appearance-state) 'restored)
    (check-false (blended?))
    ;; Now Apply followed by Undo Changes must undo app-local native state too.
    (set! preferences (preferences!))
    (click! (unique-button preferences "Apply OpenRacket appearance"))
    (fence!)
    (check-true (blended?))
    (click! (unique-button preferences (string-constant undo-changes)))
    (fence!)
    (await! "Undo Changes after Apply restores prior native inheritance"
            (lambda () (and (eq? (pref-get 'openracket:appearance-state) 'restored)
                           (equal? (inspect) original) (not (blended?)))))
    (set! preferences (preferences!))
    (click! (unique-button preferences "Apply OpenRacket appearance"))
    (fence!)
    ;; The genuine Framework frame's Escape handler runs the same cancellation
    ;; path as a user key event; this is callback routing, not physical input timing.
    (send preferences on-subwindow-char preferences (new key-event% [key-code 'escape]))
    (fence!)
    (await! "Escape cancels the new native appearance transaction"
            (lambda () (and (eq? (pref-get 'openracket:appearance-state) 'restored)
                           (equal? (inspect) original) (not (blended?)))))
    ;; Drain old mode/background callbacks, then create another real frame. Neither
    ;; may silently reapply an explicitly restored transaction.
    (fence!) (fence!)
    (define third (open-frame #f))
    (register-created! third)
    (fence!)
    (check-equal? (inspect) original)
    (check-false (blended?))
    (check-eq? (pref-get 'openracket:appearance-state) 'restored)
    (check-eq? (send frame get-definitions-text) defs)
    (check-equal? (send defs get-text) source)
    (send third close)
    (log! 'restored-after-queued-callbacks-and-new-frame)
    (hash 'status "passed" 'real_preferences_cancel #t 'real_escape_callback #t 'real_multiwindow #t
          'exact_native_restore #t 'platform_follow #t 'font_metrics font-result)))
