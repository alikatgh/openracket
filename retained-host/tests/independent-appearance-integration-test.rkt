#lang racket/base
;; Execute actual polish transaction/bridge functions with real pure native
;; controller, modeled pre-commit Framework callbacks, and owned fake checkpoints.
;; No GUI/FFI imports, no preferences file, no display operations.
(require rackunit racket/list racket/match racket/runtime-path)
(define-runtime-path source "../tool/tool.rkt")
(define-runtime-path native "../tool/native-appearance.rkt")
(define-runtime-path appearance "../tool/appearance-state.rkt")
(define-runtime-path layout "../tool/layout.rkt")
(define forms
  (match (parameterize ([read-accept-reader #t]) (call-with-input-file source read))
    [`(module ,_ ,_ (#%module-begin ,forms ...)) forms]))
(define needed
  '(enabled-pref state-pref snapshot-pref synchronize-painter! set-painter-blended!
    native-controller native-committed? startup-native-considered? native-state-write?
    native-state-generation set-appearance-state! begin-native-state-transaction! modern-session?
    native-appearance-opted-in? native-appearance-eligible? current-native-mode suspend-native-appearance!
    deactivate-native-appearance! synchronize-native-appearance! activate-native-appearance!
    install-painter-bridge! capture-appearance restore-snapshot! apply-appearance! initialize-once!))
(define (name form)
  (match form [`(define (,n ,_ ...) ,_ ...) n] [`(define ,(? symbol? n) ,_ ...) n] [_ #f]))
(define (fixture)
  (define prefs
    (make-hasheq '((framework:color-scheme-light . classic)
                  (framework:color-scheme-dark . white-on-black)
                  (framework:white-on-black-mode? . platform)
                  (framework:standard-style-list:font-name . "Original Mono")
                  (framework:standard-style-list:font-size . #(#hash() 17))
                  (framework:standard-style-list:smoothing . default)
                  (openracket:appearance-enabled? . #f)
                  (openracket:appearance-state . fresh)
                  (openracket:appearance-snapshot . #f))))
  (define original (box 'native-inherited-appearance))
  (define current original)
  (define tokens (make-hasheq))
  (define native-writes '())
  (define blended? #f)
  (define theme "dark")
  (define restore-fails? #f)
  (define refresh-fails? #f)
  (define queued '())
  (define callbacks '())
  (define color-callbacks '())
  (define ns (make-base-namespace))
  (define (invoke key . args)
    (parameterize ([current-namespace ns]) (apply (eval key) args)))
  (define (dark?)
    (define v (hash-ref prefs 'framework:white-on-black-mode?))
    (if (boolean? v) v (eq? current 'dark)))
  (define (put! key value)
    ;; The official Framework callback sees the old committed preference.
    (for ([entry (in-list callbacks)] #:when (eq? key (car entry))) ((cdr entry) key value))
    (hash-set! prefs key value))
  (define (release! token)
    (when (hash-ref tokens token) (error 'double-release "owned checkpoint"))
    (hash-set! tokens token #t))
  (define (drain!)
    (let loop ([fuel 100])
      (unless (null? queued)
        (when (zero? fuel) (error 'event-loop "unbounded callback feedback"))
        (define next (car queued)) (set! queued (cdr queued)) (next) (loop (sub1 fuel)))))
  (parameterize ([current-namespace ns])
    (namespace-require 'racket/class)
    (namespace-require `(file ,(path->string native)))
    (namespace-require `(file ,(path->string appearance)))
    (namespace-require `(file ,(path->string layout)))
    (eval '(define-logger openracket-appearance))
    (eval '(define-syntax-rule (string-constant key) (symbol->string 'key)))
    (define adapter
      ((eval 'native-appearance-adapter)
       'independent (lambda () #t)
       (lambda () (define t (box current)) (hash-set! tokens t #f) t)
       (lambda (mode) (set! current mode) (set! native-writes (cons mode native-writes)))
       (lambda (t)
         (when (hash-ref tokens t) (error 'released-checkpoint "restore"))
         (when restore-fails? (error 'native-restore "injected native failure"))
         (set! current (unbox t)) (set! native-writes (cons 'restore native-writes)))
       release! (lambda () current)))
    ((eval 'set-native-appearance-adapter-matches?!) adapter (lambda (mode) (eq? current mode)))
    (define bindings
      (list
       (cons 'getenv (lambda (key) (cond [(equal? key "OPENRACKET_THEME") theme]
                                        [(equal? key "OPENRACKET_UI") "modern"] [else "1"])))
       (cons 'preferences:get (lambda (key) (hash-ref prefs key)))
       (cons 'preferences:set put!)
       (cons 'preferences:add-callback
             (lambda (key callback . rest) (set! callbacks (cons (cons key callback) callbacks))))
       (cons 'color-prefs:white-on-black-color-scheme? dark?)
       (cons 'color-prefs:register-color-scheme-entry-change-callback
             (lambda (key callback . rest) (set! color-callbacks (cons callback color-callbacks))))
       (cons 'color-prefs:get-current-color-scheme-name
             (lambda (#:wob? dark) (hash-ref prefs (if dark 'framework:color-scheme-dark 'framework:color-scheme-light))))
       (cons 'color-prefs:set-current-color-scheme
             (lambda (value)
               (put! (if (memq value '(white-on-black |OpenRacket Dark|))
                         'framework:color-scheme-dark 'framework:color-scheme-light) value)
               (for ([callback (in-list color-callbacks)]) (callback 'background))))
       (cons 'get-face-list (lambda (_) '("DejaVu Sans Mono")))
       (cons 'queue-callback (lambda (thunk . rest) (set! queued (append queued (list thunk)))))
       (cons 'refresh-retained-toolbars!
             (lambda () (when refresh-fails? (set! refresh-fails? #f) (error 'repaint "late apply failure"))))
       (cons 'optional-painter-export
             (lambda (key)
               (case key [(set-modern-chrome-blended!) (lambda (v) (set! blended? v))]
                 [(set-modern-host-theme! set-modern-role-labels!) void] [else #f])))
       (cons 'make-platform-native-appearance-adapter
             (lambda (#:enabled? enabled #:allow-gtk-candidate? gtk #:on-unavailable unavailable) adapter))))
    (for ([entry (in-list bindings)]) (namespace-set-variable-value! (car entry) (cdr entry) #t))
    (for ([form (in-list forms)] #:when (memq (name form) needed)) (eval form))
    ((eval 'install-painter-bridge!)))
  (define (state)
    (hash 'original original 'current current 'blended blended? 'writes native-writes
          'tokens (hash-count tokens) 'owned (count not (hash-values tokens))
          'committed (parameterize ([current-namespace ns]) (eval 'native-committed?))))
  (values prefs invoke put! drain! state
          (lambda (v) (set! theme v))
          (lambda (v) (set! restore-fails? v))
          (lambda () (set! refresh-fails? #t))))

(test-case "queued callbacks and later windows cannot reapply after explicit restore"
  (define-values (prefs invoke put drain state theme restore-fail late-fail) (fixture))
  (invoke 'initialize-once!)
  (check-eq? (hash-ref (state) 'current) 'dark)
  (check-true (hash-ref (state) 'blended))
  ;; Queued before-commit callbacks are intentionally still outstanding here.
  (invoke 'restore-snapshot! (hash-ref prefs 'openracket:appearance-snapshot))
  (put 'openracket:appearance-enabled? #f) (invoke 'set-appearance-state! 'restored)
  (define writes (hash-ref (state) 'writes))
  (drain) (invoke 'initialize-once!) (drain)
  (check-eq? (hash-ref (state) 'current) (hash-ref (state) 'original))
  (check-false (hash-ref (state) 'blended))
  (check-false (hash-ref (state) 'committed))
  (check-equal? (hash-ref (state) 'writes) writes)
  (check-equal? (hash-ref (state) 'owned) 0))

(test-case "late failed reapply preserves first native baseline and prior native mode"
  (define-values (prefs invoke put drain state theme restore-fail late-fail) (fixture))
  (invoke 'initialize-once!) (drain)
  (define prior (hash-copy prefs))
  (theme "light") (late-fail)
  (check-false (invoke 'apply-appearance!))
  (drain)
  (check-equal? prefs prior)
  (check-eq? (hash-ref (state) 'current) 'dark)
  (check-true (hash-ref (state) 'committed))
  (check-equal? (hash-ref (state) 'owned) 1)
  (invoke 'restore-snapshot! (hash-ref prefs 'openracket:appearance-snapshot))
  (drain)
  (check-eq? (hash-ref (state) 'current) (hash-ref (state) 'original))
  (check-equal? (hash-ref (state) 'owned) 0))

(test-case "native restore failure is surfaced and retains ownership for explicit retry"
  (define-values (prefs invoke put drain state theme restore-fail late-fail) (fixture))
  (invoke 'initialize-once!) (drain)
  (restore-fail #t)
  (check-exn exn:fail? (lambda ()
                       (invoke 'restore-snapshot! (hash-ref prefs 'openracket:appearance-snapshot))))
  (check-eq? (hash-ref prefs 'openracket:appearance-state) 'applied)
  (check-equal? (hash-ref (state) 'owned) 1)
  (check-false (hash-ref (state) 'blended))
  (drain)
  (restore-fail #f)
  (invoke 'restore-snapshot! (hash-ref prefs 'openracket:appearance-snapshot))
  (check-eq? (hash-ref (state) 'current) (hash-ref (state) 'original))
  (check-equal? (hash-ref (state) 'owned) 0))

(test-case "platform-follow preserves app inheritance and original checkpoint across explicit modes"
  (define-values (prefs invoke put drain state theme restore-fail late-fail) (fixture))
  (invoke 'initialize-once!) (drain)
  (put 'framework:white-on-black-mode? 'platform) (drain)
  (check-eq? (hash-ref (state) 'current) (hash-ref (state) 'original))
  (check-false (hash-ref (state) 'blended))
  (check-true (hash-ref (state) 'committed))
  (check-equal? (hash-ref (state) 'owned) 1)
  (put 'framework:white-on-black-mode? #f) (drain)
  (check-eq? (hash-ref (state) 'current) 'light)
  (check-true (hash-ref (state) 'blended))
  (check-equal? (hash-ref (state) 'owned) 1)
  (invoke 'restore-snapshot! (hash-ref prefs 'openracket:appearance-snapshot))
  (drain)
  (check-eq? (hash-ref (state) 'current) (hash-ref (state) 'original))
  (check-equal? (hash-ref (state) 'owned) 0))

(test-case "late failed reapply resumes platform inheritance instead of pinning resolved light mode"
  (define-values (prefs invoke put drain state theme restore-fail late-fail) (fixture))
  (invoke 'initialize-once!) (drain)
  (put 'framework:white-on-black-mode? 'platform) (drain)
  (define prior (hash-copy prefs))
  (theme "light") (late-fail)
  (check-false (invoke 'apply-appearance!)) (drain)
  (check-equal? prefs prior)
  (check-eq? (hash-ref (state) 'current) (hash-ref (state) 'original))
  (check-false (hash-ref (state) 'blended))
  (check-equal? (hash-ref (state) 'owned) 1)
  (invoke 'restore-snapshot! (hash-ref prefs 'openracket:appearance-snapshot))
  (check-equal? (hash-ref (state) 'owned) 0))

(define (restore-external-snapshot! snapshot put)
  ;; Framework Undo Changes and Escape use the same full snapshot restore path.
  (for ([(key value) (in-hash snapshot)]) (put key value)))
(test-case "Undo or Escape after explicit Restore reactivates the saved applied transaction"
  (define-values (prefs invoke put drain state theme restore-fail late-fail) (fixture))
  (invoke 'initialize-once!) (drain)
  (define shown-snapshot (hash-copy prefs))
  (invoke 'restore-snapshot! (hash-ref prefs 'openracket:appearance-snapshot))
  (put 'openracket:appearance-enabled? #f) (invoke 'set-appearance-state! 'restored)
  (restore-external-snapshot! shown-snapshot put) (drain)
  (check-equal? prefs shown-snapshot)
  (check-eq? (hash-ref (state) 'current) 'dark)
  (check-true (hash-ref (state) 'committed))
  (check-true (hash-ref (state) 'blended))
  (check-equal? (hash-ref (state) 'owned) 1))

(test-case "Undo or Escape after Apply restores the previously restored app state"
  (define-values (prefs invoke put drain state theme restore-fail late-fail) (fixture))
  (invoke 'initialize-once!) (drain)
  (invoke 'restore-snapshot! (hash-ref prefs 'openracket:appearance-snapshot))
  (put 'openracket:appearance-enabled? #f) (invoke 'set-appearance-state! 'restored)
  (drain)
  (define shown-snapshot (hash-copy prefs))
  (check-true (invoke 'apply-appearance!))
  (restore-external-snapshot! shown-snapshot put) (drain)
  (check-equal? prefs shown-snapshot)
  (check-eq? (hash-ref (state) 'current) (hash-ref (state) 'original))
  (check-false (hash-ref (state) 'committed))
  (check-false (hash-ref (state) 'blended))
  (check-equal? (hash-ref (state) 'owned) 0))

(test-case "rapid external state and mode changes converge on the last committed state"
  (define-values (prefs invoke put drain state theme restore-fail late-fail) (fixture))
  (invoke 'initialize-once!) (drain)
  (put 'openracket:appearance-state 'restored)
  (put 'framework:white-on-black-mode? #t)
  (put 'openracket:appearance-state 'applied)
  (put 'framework:white-on-black-mode? #f)
  (drain)
  (check-eq? (hash-ref (state) 'current) 'light)
  (check-true (hash-ref (state) 'blended))
  (check-equal? (hash-ref (state) 'owned) 1))

(test-case "failed Restore invalidates an older external callback despite unchanged applied prefs"
  (define-values (prefs invoke put drain state theme restore-fail late-fail) (fixture))
  (invoke 'initialize-once!) (drain)
  (put 'openracket:appearance-state 'applied)
  (restore-fail #t)
  (check-exn exn:fail? (lambda () (invoke 'restore-snapshot! (hash-ref prefs 'openracket:appearance-snapshot))))
  (restore-fail #f)
  (define prior-writes (hash-ref (state) 'writes))
  (drain)
  (check-equal? (hash-ref (state) 'writes) prior-writes)
  (check-false (hash-ref (state) 'committed))
  (check-false (hash-ref (state) 'blended))
  (check-equal? (hash-ref (state) 'owned) 1))

(test-case "new external write after internal Restore updates an already queued state generation"
  (define-values (prefs invoke put drain state theme restore-fail late-fail) (fixture))
  (invoke 'initialize-once!) (drain)
  (define shown-snapshot (hash-copy prefs))
  (put 'openracket:appearance-state 'restored)
  (invoke 'restore-snapshot! (hash-ref prefs 'openracket:appearance-snapshot))
  (invoke 'set-appearance-state! 'restored)
  (restore-external-snapshot! shown-snapshot put)
  (drain)
  (check-eq? (hash-ref (state) 'current) 'dark)
  (check-true (hash-ref (state) 'committed))
  (check-true (hash-ref (state) 'blended)))

(test-case "Undo after a failed native Restore recovers committed mode without replacing baseline"
  (define-values (prefs invoke put drain state theme restore-fail late-fail) (fixture))
  (invoke 'initialize-once!) (drain)
  (define shown-snapshot (hash-copy prefs))
  (restore-fail #t)
  (check-exn exn:fail? (lambda () (invoke 'restore-snapshot! (hash-ref prefs 'openracket:appearance-snapshot))))
  (restore-external-snapshot! shown-snapshot put) (drain)
  (check-eq? (hash-ref (state) 'current) 'dark)
  (check-true (hash-ref (state) 'committed))
  (check-true (hash-ref (state) 'blended))
  (check-equal? (hash-ref (state) 'owned) 1)
  (restore-fail #f)
  (invoke 'restore-snapshot! (hash-ref prefs 'openracket:appearance-snapshot))
  (check-eq? (hash-ref (state) 'current) (hash-ref (state) 'original)))
