#lang racket/base
;; Independent pure lifecycle audit. Executes the real controller with owned
;; checkpoint identities; it does not emulate Cocoa/GTK pixels or start a GUI.
(require rackunit racket/list "../tool/native-appearance.rkt")
(struct token (id value [released? #:mutable]) #:transparent)
(define (make-fixture)
  (define original (box 'native-explicit-appearance))
  (define current original)
  (define gui? #t)
  (define point #f)
  (define next-id 0)
  (define tokens '())
  (define (fail! p) (when (memq p (or point '())) (error p "injected")))
  (define (usable! t) (when (token-released? t) (error 'use-after-release "token ~a" (token-id t))))
  (define adapter
    (native-appearance-adapter
     'independent (lambda () gui?)
     (lambda ()
       (fail! 'capture)
       (set! next-id (add1 next-id))
       (define t (token next-id current #f))
       (set! tokens (append tokens (list t))) t)
     (lambda (mode) (set! current mode) (fail! 'set-after))
     (lambda (t) (usable! t) (fail! 'restore-before)
       (set! current (token-value t)) (fail! 'restore-after))
     (lambda (t) (usable! t) (set-token-released?! t #t))
     (lambda () current)))
  (values (make-native-appearance-controller adapter #:enabled? #t) original
          (lambda () current) (lambda () tokens)
          (lambda (v) (set! point v)) (lambda (v) (set! gui? v))))
(define (status r) (native-appearance-result-status r))

(test-case "failed second mutation and rollback keep original ownership for later restore"
  (define-values (c original current tokens fail gui) (make-fixture))
  (check-eq? (status (native-appearance-set! c 'dark)) 'applied)
  (fail '(set-after restore-before))
  (check-eq? (status (native-appearance-set! c 'light)) 'failed)
  (check-eq? (current) 'light)
  (check-true (native-appearance-active? c))
  (check-false (token-released? (first (tokens))))
  (check-true (token-released? (second (tokens))))
  (fail #f)
  (check-eq? (status (native-appearance-restore! c)) 'restored)
  (check-eq? (current) original)
  (check-true (andmap token-released? (tokens))))

(test-case "capture failure while active neither loses original nor allocates a token"
  (define-values (c original current tokens fail gui) (make-fixture))
  (native-appearance-set! c 'dark)
  (fail '(capture))
  (check-eq? (status (native-appearance-set! c 'light)) 'failed)
  (check-eq? (current) 'dark)
  (check-equal? (length (tokens)) 1)
  (fail #f)
  (check-eq? (status (native-appearance-restore! c)) 'restored)
  (check-eq? (current) original))

(test-case "wrong-thread close keeps controller open and owned until GUI retry"
  (define-values (c original current tokens fail gui) (make-fixture))
  (native-appearance-set! c 'dark)
  (gui #f)
  (check-eq? (status (native-appearance-close! c)) 'wrong-thread)
  (check-false (token-released? (car (tokens))))
  (gui #t)
  (check-eq? (status (native-appearance-close! c)) 'restored)
  (check-eq? (current) original)
  (check-eq? (status (native-appearance-set! c 'light)) 'closed))

(test-case "failed close remains recoverable without double release"
  (define-values (c original current tokens fail gui) (make-fixture))
  (native-appearance-set! c 'dark)
  (fail '(restore-after))
  (check-eq? (status (native-appearance-close! c)) 'failed)
  (check-eq? (current) original)
  (check-false (token-released? (car (tokens))))
  (fail #f)
  (check-eq? (status (native-appearance-close! c)) 'restored)
  (check-true (token-released? (car (tokens))))
  (check-eq? (status (native-appearance-close! c)) 'unchanged))

(test-case "two frame clients sharing one app controller preserve the first baseline"
  (define-values (c original current tokens fail gui) (make-fixture))
  (define (frame-a mode) (native-appearance-set! c mode))
  (define (frame-b mode) (native-appearance-set! c mode))
  (frame-a 'dark) (frame-b 'dark) (frame-a 'light) (frame-b 'dark)
  (check-equal? (length (tokens)) 4)
  (check-false (token-released? (car (tokens))))
  (check-true (andmap token-released? (cdr (tokens))))
  (check-eq? (status (native-appearance-restore! c)) 'restored)
  (check-eq? (current) original)
  (check-true (andmap token-released? (tokens))))

(test-case "failed resume from platform-follow exposes uncertain mutation as active"
  (define-values (c original current tokens fail gui) (make-fixture))
  (native-appearance-set! c 'dark)
  (check-eq? (status (native-appearance-follow-original! c)) 'following)
  (check-false (native-appearance-active? c))
  (check-eq? (current) original)
  (fail '(set-after restore-before))
  (check-eq? (status (native-appearance-set! c 'light)) 'failed)
  (check-eq? (current) 'light)
  (check-true (native-appearance-active? c))
  (fail #f)
  (check-eq? (status (native-appearance-restore! c)) 'restored)
  (check-eq? (current) original)
  (check-true (andmap token-released? (tokens))))
