#lang racket/base
(require rackunit racket/gui/dynamic
         "native-appearance.rkt" "native-appearance-platform.rkt"
         "native-appearance-gtk-pair.rkt" "native-appearance-cocoa-policy.rkt")

(struct checkpoint (value [released? #:mutable]) #:transparent)
(define (fixture [initial #f] #:enabled? [enabled? #t])
  (define value (box initial))
  (define events (box '()))
  (define gui? (box #t))
  (define fail (box #f))
  (define (log! kind . args) (set-box! events (cons (cons kind args) (unbox events))))
  (define (maybe-fail! point)
    (when (memq point (or (unbox fail) '())) (error point "injected failure")))
  (define a
    (native-appearance-adapter
     'mock (lambda () (unbox gui?))
     (lambda ()
       (log! 'capture (unbox value))
       (maybe-fail! 'capture)
       (checkpoint (unbox value) #f))
     (lambda (mode)
       (log! 'set mode)
       (maybe-fail! 'set-before)
       (set-box! value mode)
       (maybe-fail! 'set-after))
     (lambda (saved)
       (check-false (checkpoint-released? saved))
       (log! 'restore (checkpoint-value saved))
       (maybe-fail! 'restore-before)
       (set-box! value (checkpoint-value saved))
       (maybe-fail! 'restore-after))
     (lambda (saved)
       (check-false (checkpoint-released? saved))
       (log! 'dispose (checkpoint-value saved))
       (set-checkpoint-released?! saved #t)
       (maybe-fail! 'dispose))
     (lambda () (unbox value))))
  (set-native-appearance-adapter-matches?! a (lambda (mode) (eq? (unbox value) mode)))
  (values (make-native-appearance-controller a #:enabled? enabled?)
          value events gui? fail))
(define (status r) (native-appearance-result-status r))
(define (count-kind events kind)
  (length (filter (lambda (event) (eq? (car event) kind)) (unbox events))))

(module+ test
  (test-case "opt-in defaults inert and does not capture"
    (define-values (c v e g f) (fixture #f #:enabled? #f))
    (check-eq? (status (native-appearance-set! c 'dark)) 'disabled)
    (check-equal? (unbox e) '())
    (check-eq? (status (native-appearance-restore! c)) 'unchanged))
  (test-case "unsupported backend preserves state"
    (define c (make-native-appearance-controller #f #:enabled? #t))
    (check-eq? (status (native-appearance-set! c 'dark)) 'unsupported)
    (check-false (native-appearance-active? c)))
  (test-case "wrong GUI thread cannot capture or mutate"
    (define-values (c v e g f) (fixture))
    (set-box! g #f)
    (check-eq? (status (native-appearance-set! c 'dark)) 'wrong-thread)
    (check-equal? (unbox e) '()))
  (test-case "nil baseline is captured and restored exactly"
    (define-values (c v e g f) (fixture))
    (check-eq? (status (native-appearance-set! c 'dark)) 'applied)
    (check-true (native-appearance-active? c))
    (check-eq? (status (native-appearance-restore! c)) 'restored)
    (check-false (unbox v))
    (check-false (native-appearance-active? c))
    (check-equal? (reverse (unbox e))
                  '((capture #f) (set dark) (restore #f) (dispose #f))))
  (test-case "opaque original identity survives repeat mode changes"
    (define original (box 'prior-native-object))
    (define-values (c v e g f) (fixture original))
    (for ([mode '(dark light dark light)])
      (check-eq? (status (native-appearance-set! c mode)) 'applied))
    (check-equal? (count-kind e 'capture) 4)
    (check-equal? (count-kind e 'dispose) 3)
    (check-eq? (status (native-appearance-restore! c)) 'restored)
    (check-eq? (unbox v) original)
    (check-equal? (count-kind e 'dispose) 4))
  (test-case "an absent/native nil token is distinct from no checkpoint"
    (define restored '())
    (define c
      (make-native-appearance-controller
       (native-appearance-adapter 'nil void (lambda () #f) void
                                  (lambda (v) (set! restored (cons v restored)))
                                  void void)
       #:enabled? #t))
    (check-eq? (status (native-appearance-set! c 'dark)) 'applied)
    (check-eq? (status (native-appearance-restore! c)) 'restored)
    (check-equal? restored '(#f)))
  (test-case "capture failure cannot invoke setter"
    (define-values (c v e g f) (fixture 'original))
    (set-box! f '(capture))
    (check-eq? (status (native-appearance-set! c 'dark)) 'failed)
    (check-eq? (unbox v) 'original)
    (check-equal? (count-kind e 'set) 0))
  (test-case "first setter failure before or after write restores and releases"
    (for ([point '(set-before set-after)])
      (define-values (c v e g f) (fixture #f))
      (set-box! f (list point))
      (check-eq? (status (native-appearance-set! c 'dark)) 'failed)
      (check-false (unbox v))
      (check-false (native-appearance-active? c))
      (check-equal? (count-kind e 'restore) 1)
      (check-equal? (count-kind e 'dispose) 1)))
  (test-case "failed reapply rolls back current mode without replacing baseline"
    (define-values (c v e g f) (fixture 'original))
    (native-appearance-set! c 'dark)
    (set-box! f '(set-after))
    (check-eq? (status (native-appearance-set! c 'light)) 'failed)
    (check-eq? (unbox v) 'dark)
    (check-true (native-appearance-active? c))
    (set-box! f #f)
    (check-eq? (status (native-appearance-restore! c)) 'restored)
    (check-eq? (unbox v) 'original))
  (test-case "failed rollback retains ownership for explicit restore retry"
    (define-values (c v e g f) (fixture #f))
    (set-box! f '(set-after restore-before))
    (check-eq? (status (native-appearance-set! c 'dark)) 'failed)
    (check-true (native-appearance-active? c))
    (check-equal? (count-kind e 'dispose) 0)
    (set-box! f #f)
    (check-eq? (status (native-appearance-restore! c)) 'restored)
    (check-false (unbox v)))
  (test-case "restore failures before and after write permit retry"
    (for ([point '(restore-before restore-after)])
      (define-values (c v e g f) (fixture 'original))
      (native-appearance-set! c 'dark)
      (set-box! f (list point))
      (check-eq? (status (native-appearance-restore! c)) 'failed)
      (check-true (native-appearance-active? c))
      (check-equal? (count-kind e 'dispose) 0)
      (set-box! f #f)
      (check-eq? (status (native-appearance-restore! c)) 'restored)
      (check-eq? (unbox v) 'original)))
  (test-case "temporary checkpoint release failure cannot trigger use-after-release"
    (define-values (c v e g f) (fixture 'original))
    (native-appearance-set! c 'dark)
    (set-box! f '(dispose))
    (check-eq? (status (native-appearance-set! c 'light)) 'failed)
    (check-eq? (unbox v) 'light)
    (check-equal? (count-kind e 'restore) 0)
    (check-equal? (count-kind e 'dispose) 1)
    (set-box! f #f)
    (check-eq? (status (native-appearance-restore! c)) 'restored)
    (check-eq? (unbox v) 'original))
  (test-case "baseline release failure does not double release on retry"
    (define-values (c v e g f) (fixture #f))
    (native-appearance-set! c 'dark)
    (set-box! f '(dispose))
    (check-eq? (status (native-appearance-restore! c)) 'failed)
    (check-false (unbox v))
    (check-false (native-appearance-active? c))
    (check-eq? (status (native-appearance-restore! c)) 'unchanged)
    (check-equal? (count-kind e 'dispose) 1))
  (test-case "wrong-thread restore retains baseline for handler thread"
    (define-values (c v e g f) (fixture #f))
    (native-appearance-set! c 'dark)
    (set-box! g #f)
    (check-eq? (status (native-appearance-restore! c)) 'wrong-thread)
    (check-eq? (unbox v) 'dark)
    (set-box! g #t)
    (check-eq? (status (native-appearance-restore! c)) 'restored))
  (test-case "restore is idempotent; later apply takes a fresh baseline"
    (define-values (c v e g f) (fixture #f))
    (native-appearance-set! c 'dark)
    (native-appearance-restore! c)
    (check-eq? (status (native-appearance-restore! c)) 'unchanged)
    (set-box! v 'new-original)
    (native-appearance-set! c 'light)
    (native-appearance-restore! c)
    (check-eq? (unbox v) 'new-original))
  (test-case "close restores then permanently rejects later sync"
    (define-values (c v e g f) (fixture #f))
    (native-appearance-set! c 'dark)
    (check-eq? (status (native-appearance-close! c)) 'restored)
    (check-eq? (status (native-appearance-set! c 'light)) 'closed)
    (check-eq? (status (native-appearance-close! c)) 'unchanged)
    (check-false (unbox v)))
  (test-case "only explicit supported light/dark modes are accepted"
    (define-values (c v e g f) (fixture))
    (check-exn exn:fail:contract? (lambda () (native-appearance-set! c 'platform)))
    (check-equal? (unbox e) '()))
  (test-case "verified same-mode notifications do not recapture or mutate"
    (define-values (c v e g f) (fixture #f))
    (native-appearance-set! c 'dark)
    (for ([i (in-range 10)])
      (check-eq? (status (native-appearance-set! c 'dark)) 'unchanged))
    (check-equal? (count-kind e 'capture) 1)
    (check-equal? (count-kind e 'set) 1)
    (check-true (native-appearance-active? c)))
  (test-case "external native changes invalidate same-mode shortcut"
    (define-values (c v e g f) (fixture #f))
    (native-appearance-set! c 'dark)
    (set-box! v 'external-appearance)
    (check-eq? (status (native-appearance-set! c 'dark)) 'applied)
    (check-equal? (count-kind e 'set) 2)
    (check-eq? (unbox v) 'dark)
    (native-appearance-restore! c)
    (check-false (unbox v)))
  (test-case "uncertain rollback cannot use cached previous mode"
    (define-values (c v e g f) (fixture #f))
    (native-appearance-set! c 'dark)
    (set-box! f '(set-after restore-before))
    (native-appearance-set! c 'light)
    (set-box! f #f)
    (check-eq? (status (native-appearance-set! c 'dark)) 'applied)
    (check-equal? (count-kind e 'set) 3))
  (test-case "restore clears idempotence marker for same-mode next session"
    (define-values (c v e g f) (fixture #f))
    (native-appearance-set! c 'dark)
    (native-appearance-restore! c)
    (check-eq? (status (native-appearance-set! c 'dark)) 'applied)
    (check-equal? (count-kind e 'set) 2))
  (test-case "platform following preserves exact nil inheritance and first ownership"
    (define-values (c v e g f) (fixture #f))
    (check-eq? (status (native-appearance-follow-original! c)) 'following)
    (check-false (unbox v))
    (check-false (native-appearance-active? c))
    (check-equal? (count-kind e 'set) 0)
    (native-appearance-set! c 'dark)
    (check-eq? (status (native-appearance-follow-original! c)) 'following)
    (check-false (unbox v))
    (native-appearance-set! c 'light)
    (check-eq? (status (native-appearance-restore! c)) 'restored)
    (check-false (unbox v))
    (check-equal? (count-kind e 'capture) 3)
    (check-equal? (count-kind e 'dispose) 3))
  (test-case "failed platform restoration retains baseline for retry"
    (define-values (c v e g f) (fixture 'original))
    (native-appearance-set! c 'dark)
    (set-box! f '(restore-before))
    (check-eq? (status (native-appearance-follow-original! c)) 'failed)
    (check-true (native-appearance-active? c))
    (check-equal? (count-kind e 'dispose) 0)
    (set-box! f #f)
    (check-eq? (status (native-appearance-restore! c)) 'restored)
    (check-eq? (unbox v) 'original))
  (test-case "failed explicit resume and rollback from platform is marked active"
    (define-values (c v e g f) (fixture #f))
    (native-appearance-follow-original! c)
    (set-box! f '(set-after restore-before))
    (check-eq? (status (native-appearance-set! c 'dark)) 'failed)
    (check-true (native-appearance-active? c))
    (check-eq? (unbox v) 'dark)
    (set-box! f #f)
    (check-eq? (status (native-appearance-restore! c)) 'restored)
    (check-false (unbox v)))
  (test-case "Cocoa high-contrast setting or either appearance refuses mutation"
    (check-true (cocoa-standard-appearance-eligible? #f "NSAppearanceNameAqua" #f))
    (check-true (cocoa-standard-appearance-eligible? "NSAppearanceNameDarkAqua" "NSAppearanceNameDarkAqua" #f))
    (for ([args (list (list #f "NSAppearanceNameAqua" #t)
                     (list #f "NSAppearanceNameAccessibilityHighContrastAqua" #f)
                     (list "NSAppearanceNameAccessibilityHighContrastDarkAqua" "NSAppearanceNameAqua" #f)
                     (list #f "NSAppearanceNameAqua" 'unknown)
                     (list #f #f #f))])
      (check-false (apply cocoa-standard-appearance-eligible? args))))
  (test-case "Cocoa custom and vibrant appearances are unvalidated and refused"
    (for ([name '("NSAppearanceNameVibrantLight" "NSAppearanceNameVibrantDark" "CustomAppearance" "" #f)])
      (check-false (cocoa-standard-appearance-eligible? #f name #f))
      (when name (check-false (cocoa-standard-appearance-eligible? name "NSAppearanceNameAqua" #f)))))
  (test-case "Cocoa effective mode must positively match the requested standard appearance"
    (check-true (cocoa-effective-mode-matches? 'light "NSAppearanceNameAqua"))
    (check-true (cocoa-effective-mode-matches? 'dark "NSAppearanceNameDarkAqua"))
    (check-false (cocoa-effective-mode-matches? 'dark "NSAppearanceNameAqua"))
    (check-false (cocoa-effective-mode-matches? 'light "NSAppearanceNameDarkAqua"))
    (check-false (cocoa-effective-mode-matches? 'dark "NSAppearanceNameAccessibilityHighContrastDarkAqua"))
    (check-false (cocoa-effective-mode-matches? 'dark "CustomAppearance")))
  (test-case "platform module never starts a GUI merely to change appearance"
    (check-false (gui-available?))
    (define reasons '())
    (check-false (make-platform-native-appearance-adapter))
    (check-false (make-platform-native-appearance-adapter
                  #:enabled? #t #:allow-gtk-candidate? #t
                  #:on-unavailable (lambda (r) (set! reasons (cons r reasons)))))
    (check-equal? reasons '(gui-not-started))
    (check-false (gui-available?)))
  (test-case "GTK capability verifies both actual named/variant dark providers"
    (define (css name variant)
      (if (and (equal? name "Adwaita") (not variant)) "light-css" "dark-css"))
    (for ([name '("Adwaita" "Adwaita-dark")])
      (check-equal? (recognized-gtk-theme-pair name css)
                    (gtk-theme-pair "Adwaita" "Adwaita-dark"))))
  (test-case "unknown GTK theme is not probed or replaced"
    (check-false (recognized-gtk-theme-pair "UserTheme"
                   (lambda args (error 'test "must not probe unknown theme")))))
  (test-case "GTK silent fallback or missing/empty providers refuse capability"
    (for ([bad '(#f "" "light-css")])
      (check-false
       (recognized-gtk-theme-pair "Adwaita"
         (lambda (name variant)
           (cond [(equal? name "Adwaita-dark") bad]
                 [variant "dark-css"] [else "light-css"]))))))
  (test-case "GTK visually indistinct variants refuse capability"
    (check-false (recognized-gtk-theme-pair "Adwaita" (lambda args "same-css"))))
  (test-case "GTK ambiguous prefer-dark/light-name state cannot stale stock cache"
    (check-false (recognized-gtk-current-state? "Adwaita" #t))
    (check-true (recognized-gtk-current-state? "Adwaita" #f))
    (check-true (recognized-gtk-current-state? "Adwaita-dark" #f))
    (check-true (recognized-gtk-current-state? "Adwaita-dark" #t))
    (check-false (recognized-gtk-current-state? "OtherTheme" #f)))
  (test-case "GTK named dark custom variant must also match the real dark pair"
    (check-false
     (recognized-gtk-theme-pair "Adwaita"
       (lambda (name variant)
         (cond [(and (equal? name "Adwaita-dark") variant) "unexpected-css"]
               [(and (equal? name "Adwaita") (not variant)) "light-css"]
               [else "dark-css"]))))))
